<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dr_theme_config_view_tree" model="ir.ui.view">
        <field name="name">dr.theme.config.view.list</field>
        <field name="model">dr.theme.config</field>
        <field name="arch" type="xml">
            <list string="Droggol Theme Config" editable="bottom">
                <field name="website_id"/>
                <field name="key"/>
                <field name="value"/>
            </list>
        </field>
    </record>

    <record id="dr_theme_config_action" model="ir.actions.act_window">
        <field name="name">Droggol Theme Config</field>
        <field name="res_model">dr.theme.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Kept for backwards compatibility with legacy refs; not surfaced
         under the Styling menu — power-users find it via dev tools. -->
    <menuitem id="dr_theme_config_menu" name="Theme Config (Advanced)" action="dr_theme_config_action" parent="base.menu_ir_property"/>

    <!-- Note: the legacy "Theme Prime Configuration" menu used to live here
         pointing at website.website_preview. It is now re-created inside
         styling_menu.xml as menu_styling_live_editor so it loads AFTER its
         parent menu (menu_styling_root) is defined. -->

</odoo>
