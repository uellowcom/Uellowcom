<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.droggol.theme.common</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_website_create_new']" position="after">
                <button name="dr_open_theme_custom_modules" type="object" string="Theme Customizations" class="btn-info ms-2" icon="fa-cog" invisible="not dr_has_custom_module"/>
                <field name="dr_has_custom_module" invisible="1"/> <!-- Need for domain  -->
            </xpath>
            <block id="sale_product_catalog_settings" position="inside">
                <setting id="discount_sale_order_lines" title="Apply manual discounts on sales order lines or display discounts computed from pricelists (option to activate in the pricelist configuration)." help="Grant discounts on sales order lines">
                    <field name="group_discount_per_so_line"/>
                </setting>
            </block>
            <block id="sale_product_catalog_settings" position="after">
                <!--
                    ════════════════════════════════════════════════════════════
                    Uellow Theme — branding, header & search
                    ════════════════════════════════════════════════════════════
                    All fields are per-website and stored on `website.*`, so
                    each storefront (KW / SA / UAE …) can be branded
                    differently. The marketplace header (style 9) reads these
                    values live — no code edits or theme re-install needed.
                -->
                <block title="Uellow Theme" id="uellow_theme_branding_settings">

                    <h3 class="mt-2 mb-2 fw-bold">Logo &amp; Favicon</h3>
                    <setting id="uc_logo_mobile_set" string="Mobile Logo (optional)"
                             help="Smaller logo used on mobile screens. Leave empty to reuse the main website logo.">
                        <field name="uc_logo_mobile" widget="image" options="{'size': [120, 60]}"/>
                    </setting>
                    <setting id="uc_logo_height_set" string="Logo Height (px)"
                             help="Pixel height of the brand logo inside the main header bar. Range 24-80 looks best.">
                        <field name="uc_logo_height"/>
                    </setting>
                    <setting id="uc_favicon_set" string="Favicon Override"
                             help="Optional override for the browser tab icon. Leave empty to keep the standard website favicon.">
                        <field name="uc_favicon" widget="image" options="{'size': [64, 64]}"/>
                    </setting>

                    <h3 class="mt-4 mb-2 fw-bold">Header Colours</h3>
                    <setting id="uc_header_bg_set" string="Header Background"
                             help="Dark colour used for the top utility bar and main header bar. Default #131921 matches the marketplace look.">
                        <field name="uc_header_bg" widget="color"/>
                    </setting>
                    <setting id="uc_header_yellow_set" string="Header Accent (Yellow)"
                             help="Brand-yellow accent used for the search button, cart pill, hover states. Default #F5C320 matches the Uellow logo.">
                        <field name="uc_header_yellow" widget="color"/>
                    </setting>

                    <h3 class="mt-4 mb-2 fw-bold">Header Strap Line</h3>
                    <setting id="uc_preheader_text_set" string="Welcome Text"
                             help="Short message shown in the top utility bar. Supports translation (EN primary + AR).">
                        <field name="uc_preheader_text"/>
                    </setting>
                    <setting id="uc_preheader_phone_set" string="Support Phone"
                             help="Phone number shown next to the welcome text.">
                        <field name="uc_preheader_phone"/>
                    </setting>

                    <h3 class="mt-4 mb-2 fw-bold">Search Bar</h3>
                    <setting id="uc_search_placeholder_set" string="Placeholder"
                             help="Placeholder text inside the header search input. Translatable.">
                        <field name="uc_search_placeholder"/>
                    </setting>
                    <setting id="uc_trending_terms_set" string="Trending Terms"
                             help="Comma-separated trending searches shown under the search bar. Each becomes a clickable suggestion.">
                        <field name="uc_trending_terms"/>
                    </setting>

                    <h3 class="mt-4 mb-2 fw-bold">Today's Deals Promo</h3>
                    <setting id="uc_deals_active_set" string="Show Deals Promo"
                             help="Toggle the small promo pill at the end of the category bar.">
                        <field name="uc_deals_active"/>
                    </setting>
                    <setting id="uc_deals_label_set" string="Label"
                             help="Text shown on the promo pill. Translatable."
                             invisible="not uc_deals_active">
                        <field name="uc_deals_label"/>
                    </setting>
                    <setting id="uc_deals_icon_set" string="Icon"
                             help="Font Awesome icon name (e.g. fa-bolt, fa-fire, fa-percent, fa-tag)."
                             invisible="not uc_deals_active">
                        <field name="uc_deals_icon"/>
                    </setting>
                    <setting id="uc_deals_target_set" string="Target Type"
                             help="What the deals pill links to."
                             invisible="not uc_deals_active">
                        <field name="uc_deals_target_type"/>
                    </setting>
                    <setting id="uc_deals_category_set" string="Category"
                             invisible="not uc_deals_active or uc_deals_target_type != 'category'">
                        <field name="uc_deals_category_id"/>
                    </setting>
                    <setting id="uc_deals_tag_set" string="Tag"
                             invisible="not uc_deals_active or uc_deals_target_type != 'tag'">
                        <field name="uc_deals_tag_id"/>
                    </setting>
                    <setting id="uc_deals_page_set" string="Page"
                             invisible="not uc_deals_active or uc_deals_target_type != 'page'">
                        <field name="uc_deals_page_id"/>
                    </setting>
                    <setting id="uc_deals_url_set" string="Custom URL"
                             invisible="not uc_deals_active or uc_deals_target_type != 'url'">
                        <field name="uc_deals_url" placeholder="https://..."/>
                    </setting>
                    <setting id="uc_deals_query_set" string="Search Query"
                             invisible="not uc_deals_active or uc_deals_target_type != 'search'">
                        <field name="uc_deals_query" placeholder="deals"/>
                    </setting>

                    <h3 class="mt-4 mb-2 fw-bold">Mobile App Stores</h3>
                    <setting id="uc_app_ios_set" string="App Store (iOS)"
                             help="URL of your app on Apple's App Store.">
                        <field name="uc_app_ios_url" placeholder="https://apps.apple.com/..."/>
                    </setting>
                    <setting id="uc_app_android_set" string="Google Play (Android)"
                             help="URL of your app on the Google Play Store.">
                        <field name="uc_app_android_url" placeholder="https://play.google.com/store/apps/..."/>
                    </setting>
                    <setting id="uc_app_huawei_set" string="AppGallery (Huawei)"
                             help="Optional Huawei AppGallery link. Empty = badge hidden.">
                        <field name="uc_app_huawei_url" placeholder="https://appgallery.huawei.com/..."/>
                    </setting>

                    <h3 class="mt-4 mb-2 fw-bold">App-Download Popup</h3>
                    <setting id="uc_app_popup_set" string="Show App-Download Popup"
                             help="A polished centred popup inviting visitors to install the app. Shown once per visit.">
                        <field name="uc_app_popup_enabled"/>
                        <div class="content-group mt-2" invisible="not uc_app_popup_enabled">
                            <div class="row">
                                <label for="uc_app_popup_delay" class="col-lg-4 o_light_label"/>
                                <field name="uc_app_popup_delay"/>
                            </div>
                            <div class="row mt-2">
                                <label for="uc_app_popup_title" class="col-lg-4 o_light_label"/>
                                <field name="uc_app_popup_title" placeholder="Get the Uellow app"/>
                            </div>
                            <div class="row mt-2">
                                <label for="uc_app_popup_text" class="col-lg-4 o_light_label"/>
                                <field name="uc_app_popup_text" placeholder="Shop faster, track orders live…"/>
                            </div>
                        </div>
                    </setting>

                    <h3 class="mt-4 mb-2 fw-bold">App-Download Banner</h3>
                    <setting id="uc_app_banner_set" string="Show App-Download Banner"
                             help="A slim sticky bar above the header inviting visitors to open/install the app. Dismissible for 7 days.">
                        <field name="uc_app_banner_enabled"/>
                        <div class="content-group mt-2" invisible="not uc_app_banner_enabled">
                            <div class="row">
                                <label for="uc_app_banner_devices" class="col-lg-4 o_light_label"/>
                                <field name="uc_app_banner_devices"/>
                            </div>
                        </div>
                    </setting>

                    <h3 class="mt-4 mb-2 fw-bold">Beena AI Icon</h3>
                    <setting id="uc_beena_icon_set" string="Custom Beena Icon"
                             help="Optional custom image shown inside the mobile nav Beena disc. Leave empty to use the default magic-wand icon.">
                        <field name="uc_beena_icon" widget="image" options="{'size': [64, 64]}"/>
                    </setting>

                    <h3 class="mt-4 mb-2 fw-bold">Footer</h3>
                    <setting id="uc_footer_about_set" string="About Text"
                             help="Short brand description shown in the first column of the footer.">
                        <field name="uc_footer_about"/>
                    </setting>
                    <setting id="uc_footer_newsletter_intro_set" string="Newsletter Pitch"
                             help="Short pitch above the newsletter input.">
                        <field name="uc_footer_newsletter_intro"/>
                    </setting>
                    <setting id="uc_footer_credit_set" string="Credit Line"
                             help="Small line on the right of the copyright row.">
                        <field name="uc_footer_credit"/>
                    </setting>
                    <setting id="uc_footer_socials_hint" string="Social Media"
                             help="Edit Facebook, Instagram, Twitter/X, YouTube, TikTok, LinkedIn, GitHub URLs in Website → Configuration → Settings → General (these are the standard Odoo social fields). Empty fields are hidden in the footer.">
                        <span class="text-muted small">
                            Social media URLs are managed under the standard Website
                            General Settings — empty fields are auto-hidden in the footer.
                        </span>
                    </setting>

                </block>

                <block title="Progressive Web Apps (PWA)" id="uellow_theme_common_pwa_settings">
                    <div class="row">
                        <setting id="dr_pwa_activated" string="Enable Progressive Web Apps" help="Allows users to install your website as an application on mobile and desktop.">
                            <field name="dr_pwa_activated"/>
                        </setting>
                    </div>
                    <setting id="dr_pwa_name" string="Name" help="Used in the app install prompt." invisible="not dr_pwa_activated">
                        <field name="dr_pwa_name" required="dr_pwa_activated"/>
                    </setting>
                    <setting id="dr_pwa_short_name" string="Short Name" help="Used on the user's home screen, launcher, or other places." invisible="not dr_pwa_activated">
                        <field name="dr_pwa_short_name" required="dr_pwa_activated"/>
                    </setting>
                    <setting id="dr_pwa_background_color" string="Background Color" help="Used on the splash screen when the application is first launched." invisible="not dr_pwa_activated">
                        <field name="dr_pwa_background_color" widget="color" required="dr_pwa_activated"/>
                    </setting>
                    <setting id="dr_pwa_theme_color" string="Theme Color" help="Used on toolbar, and may be in the app's preview in task switchers." invisible="not dr_pwa_activated">
                        <field name="dr_pwa_theme_color" widget="color" required="dr_pwa_activated"/>
                    </setting>
                    <setting id="dr_pwa_icon_192" string="Icon (192x192)" help="These icons are used in places like the home screen, app launcher, task switcher, splash screen, etc." invisible="not dr_pwa_activated">
                        <field name="dr_pwa_icon_192" widget="image" options="{'size': [90, 90]}" required="dr_pwa_activated"/>
                    </setting>
                    <setting id="dr_pwa_icon_512" string="Icon (512x512)" help="These icons are used in places like the home screen, app launcher, task switcher, splash screen, etc." invisible="not dr_pwa_activated">
                        <field name="dr_pwa_icon_512" widget="image" options="{'size': [90, 90]}" required="dr_pwa_activated"/>
                    </setting>
                    <setting id="dr_pwa_start_url" string="Start URL" help="Your application will start from this URL when it is launched." invisible="not dr_pwa_activated">
                        <field name="dr_pwa_start_url" required="dr_pwa_activated"/>
                    </setting>
                    <setting id="dr_pwa_offline_page" string="Enable Offline Page" help="Show offline page when there is no internet." invisible="not dr_pwa_activated">
                        <field name="dr_pwa_offline_page"/>
                    </setting>
                    <setting id="dr_pwa_show_install_banner" string="Show Custom Install Banner" help="Prompt the user to install the PWA with a custom banner." invisible="not dr_pwa_activated">
                        <field name="dr_pwa_show_install_banner"/>
                    </setting>
                    <setting id="dr_pwa_screenshots" string="Screenshots" help="Show what the app looks like and what it can do." invisible="not dr_pwa_activated">
                        <button type="object" name="dr_open_pwa_screenshots" string="Configure Screenshots" class="btn-link" icon="fa-cogs me-1"/>
                    </setting>
                    <setting id="dr_pwa_shortcuts" string="App Shortcuts" help="App shortcuts help users quickly start common or recommended tasks within your web app." invisible="not dr_pwa_activated">
                        <button type="object" name="dr_open_pwa_shortcuts" string="Configure Shortcuts" class="btn-link" icon="fa-cogs me-1"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
