<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        v2.2.29 — Dedicated, focused "Uellow Theme" settings page.
        The theme controls (logo / header colours / pre-header / search /
        deals / app links / footer / PWA) lived buried inside the giant
        Website Settings page. This is a clean per-website form so the menu
        opens straight onto the Uellow theme controls.
    -->
    <record id="view_website_uellow_theme_form" model="ir.ui.view">
        <field name="name">website.uellow.theme.form</field>
        <field name="model">website</field>
        <field name="arch" type="xml">
            <form string="Uellow Theme">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Website"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <notebook>
                        <page string="🎨 Branding" name="branding">
                            <group>
                                <group string="Logo &amp; Icons">
                                    <field name="uc_logo_mobile" widget="image" options="{'size': [120, 60]}"/>
                                    <field name="uc_logo_height"/>
                                    <field name="uc_favicon" widget="image" options="{'size': [64, 64]}"/>
                                    <field name="uc_beena_icon" widget="image" options="{'size': [64, 64]}"/>
                                </group>
                                <group string="Header Colours">
                                    <field name="uc_header_bg" widget="color"/>
                                    <field name="uc_header_yellow" widget="color"/>
                                </group>
                            </group>
                        </page>
                        <page string="🔝 Pre-header &amp; Search" name="header">
                            <group>
                                <group string="Pre-header">
                                    <field name="uc_preheader_text"/>
                                    <field name="uc_preheader_phone"/>
                                </group>
                                <group string="Search Bar">
                                    <field name="uc_search_placeholder"/>
                                    <field name="uc_trending_terms"/>
                                </group>
                            </group>
                        </page>
                        <page string="🔥 Deals Promo" name="deals">
                            <group>
                                <group>
                                    <field name="uc_deals_active"/>
                                    <field name="uc_deals_label"/>
                                    <field name="uc_deals_icon"/>
                                    <field name="uc_deals_target_type"/>
                                </group>
                                <group>
                                    <field name="uc_deals_category_id"/>
                                    <field name="uc_deals_tag_id"/>
                                    <field name="uc_deals_page_id"/>
                                    <field name="uc_deals_url"/>
                                    <field name="uc_deals_query"/>
                                </group>
                            </group>
                        </page>
                        <page string="📱 App &amp; Footer" name="appfooter">
                            <group>
                                <group string="App Store Links">
                                    <field name="uc_app_ios_url"/>
                                    <field name="uc_app_android_url"/>
                                    <field name="uc_app_huawei_url"/>
                                </group>
                                <group string="Footer">
                                    <field name="uc_footer_about"/>
                                    <field name="uc_footer_credit"/>
                                    <field name="uc_footer_newsletter_intro"/>
                                </group>
                            </group>
                        </page>
                        <page string="⚡ PWA (Install App)" name="pwa">
                            <group>
                                <group>
                                    <field name="dr_pwa_activated"/>
                                    <field name="dr_pwa_name"/>
                                    <field name="dr_pwa_short_name"/>
                                    <field name="dr_pwa_show_install_banner"/>
                                </group>
                                <group string="Colours &amp; Icons">
                                    <field name="dr_pwa_theme_color" widget="color"/>
                                    <field name="dr_pwa_background_color" widget="color"/>
                                    <field name="dr_pwa_icon_192" widget="image" options="{'size': [96, 96]}"/>
                                    <field name="dr_pwa_icon_512" widget="image" options="{'size': [96, 96]}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_website_uellow_theme_list" model="ir.ui.view">
        <field name="name">website.uellow.theme.list</field>
        <field name="model">website</field>
        <field name="arch" type="xml">
            <list string="Websites">
                <field name="name"/>
                <field name="uc_header_yellow" widget="color" optional="show"/>
                <field name="uc_preheader_text" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_uellow_theme_settings" model="ir.actions.act_window">
        <field name="name">Uellow Theme</field>
        <field name="res_model">website</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(ref('view_website_uellow_theme_list'), 'list'), (ref('view_website_uellow_theme_form'), 'form')]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Pick a website to theme</p>
            <p>Control the Uellow look &amp; feel per website: logo, header colours, pre-header, search, deals, app links and PWA.</p>
        </field>
    </record>
</odoo>
