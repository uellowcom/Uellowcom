<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_newcustomer_form" model="ir.ui.view">
        <field name="name">mobile.newcustomer.offer.form</field>
        <field name="model">mobile.newcustomer.offer</field>
        <field name="arch" type="xml">
            <form string="New-Customer Zone">
                <sheet>
                    <div class="oe_title">
                        <h1>🌟 New-Customer Zone</h1>
                        <p class="text-muted">The exclusive first-order page in
                        the app: hero, welcome coupon, deadline and the product
                        feed. Eligibility = logged-in customer with ZERO
                        confirmed orders.</p>
                    </div>
                    <group>
                        <group string="Status">
                            <field name="enabled"/>
                            <field name="discount_pct"/>
                            <field name="coupon_code"/>
                            <field name="ends_at"/>
                        </group>
                        <group string="Hero">
                            <field name="emoji"/>
                            <field name="title_en"/>
                            <field name="title_ar"/>
                            <field name="subtitle_en"/>
                            <field name="subtitle_ar"/>
                            <field name="color_1" widget="color"/>
                            <field name="color_2" widget="color"/>
                            <field name="text_color" widget="color"/>
                        </group>
                    </group>
                    <group>
                        <group string="Products">
                            <field name="source"/>
                            <field name="categ_ids" widget="many2many_tags"
                                   invisible="source != 'categories'"/>
                            <field name="product_ids" widget="many2many_tags"
                                   invisible="source != 'manual'"/>
                            <field name="max_products"/>
                        </group>
                        <group string="Visibility">
                            <field name="website_ids" widget="many2many_tags"/>
                            <field name="show_to_existing"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mobile_newcustomer_list" model="ir.ui.view">
        <field name="name">mobile.newcustomer.offer.list</field>
        <field name="model">mobile.newcustomer.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_label"/>
                <field name="enabled"/>
                <field name="discount_pct"/>
                <field name="coupon_code"/>
                <field name="ends_at"/>
            </list>
        </field>
    </record>

    <record id="action_mobile_newcustomer" model="ir.actions.act_window">
        <field name="name">🌟 New-Customer Zone</field>
        <field name="res_model">mobile.newcustomer.offer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up the welcome zone</p>
            <p>An exclusive first-order page in the app — hero, welcome
               coupon, countdown and a product feed.</p>
        </field>
    </record>
    <menuitem id="menu_mobile_newcustomer" name="🌟 New Customers"
              parent="uellow_mobile_manager.menu_mobile_root"
              action="action_mobile_newcustomer" sequence="35"/>
</odoo>
