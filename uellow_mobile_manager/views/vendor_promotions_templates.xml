<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sidebar link in the vendor portal -->
    <template id="vendor_layout_promotions_link"
              inherit_id="uellow_multivendor.portal_vendor_layout">
        <xpath expr="//a[contains(@t-attf-class, 'vendor_stock')]" position="after">
            <a t-attf-class="vp-nav-item #{page_name == 'vendor_promotions' and 'active' or ''}"
               href="/my/vendor/promotions">🎉 Promotions / العروض</a>
        </xpath>
    </template>

    <template id="portal_vendor_promotions" name="Vendor Promotions">
        <t t-call="uellow_multivendor.portal_vendor_layout">
            <t t-set="page_name" t-value="'vendor_promotions'"/>

            <div style="font-size:18px;font-weight:800;color:#085041;margin-bottom:4px">
                Promotions <span style="color:#0F6E56;font-weight:600">/ الحملات الترويجية</span>
            </div>
            <div style="font-size:12px;color:#0F6E56;margin-bottom:14px">
                Join marketplace campaigns with your products and a discount —
                انضم لحملات المنصة بمنتجاتك ونسبة خصم
            </div>

            <!-- Open campaigns -->
            <t t-foreach="promos" t-as="p">
                <div style="background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:16px;margin-bottom:12px">
                    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
                        <div style="display:flex;align-items:center;gap:10px">
                            <span style="font-size:26px"><t t-esc="p.emoji"/></span>
                            <div>
                                <div style="font-weight:800;color:#085041;font-size:15px">
                                    <t t-esc="p.label_en"/> <span style="color:#0F6E56">/ <t t-esc="p.label_ar"/></span>
                                </div>
                                <div style="font-size:11px;color:#64748b">
                                    <t t-esc="p.date_from" t-options='{"widget": "datetime"}'/> →
                                    <t t-esc="p.date_to" t-options='{"widget": "datetime"}'/>
                                    · Discount <t t-esc="int(p.min_discount_pct)"/>%–<t t-esc="int(p.max_discount_pct)"/>%
                                </div>
                            </div>
                        </div>
                        <span t-attf-style="background:#{p.state == 'running' and '#DCFCE7' or '#DBEAFE'};color:#{p.state == 'running' and '#15803D' or '#1D4ED8'};font-size:11px;padding:3px 10px;border-radius:20px;font-weight:800">
                            <t t-esc="p.state == 'running' and 'Running' or 'Open'"/>
                        </span>
                    </div>

                    <!-- Join form -->
                    <form method="post" action="/my/vendor/promotions/join"
                          style="margin-top:12px;border-top:1px dashed #e2e8f0;padding-top:12px">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="promotion_id" t-att-value="p.id"/>
                        <div style="font-size:12px;font-weight:800;color:#334155;margin-bottom:6px">
                            Pick your products + discount % / اختر منتجاتك ونسبة الخصم
                        </div>
                        <div style="max-height:220px;overflow:auto;border:1px solid #f1f5f9;border-radius:10px;padding:8px">
                            <t t-foreach="my_products" t-as="prod">
                                <label style="display:flex;align-items:center;gap:8px;padding:4px 2px;font-size:12px;cursor:pointer">
                                    <input type="checkbox" name="product_ids" t-att-value="prod.id"/>
                                    <span style="flex:1;color:#334155"><t t-esc="prod.name"/></span>
                                    <input class="form-control form-control-sm" type="number"
                                           t-attf-name="discount_#{prod.id}"
                                           t-att-min="int(p.min_discount_pct)"
                                           t-att-max="int(p.max_discount_pct)"
                                           t-att-placeholder="'%s%%' % int(p.min_discount_pct)"
                                           style="width:84px"/>
                                </label>
                            </t>
                            <t t-if="not my_products">
                                <div style="font-size:12px;color:#94a3b8;padding:8px">
                                    No products yet / لا توجد منتجات بعد
                                </div>
                            </t>
                        </div>
                        <div style="display:flex;gap:8px;margin-top:8px;align-items:center">
                            <input class="form-control form-control-sm" name="note"
                                   placeholder="Note (optional) / ملاحظة" style="max-width:300px"/>
                            <button type="submit" class="btn btn-sm"
                                    style="background:#F5C320;color:#412402;font-weight:800">
                                Request to Join / اطلب الانضمام
                            </button>
                        </div>
                    </form>
                </div>
            </t>
            <t t-if="not promos">
                <div style="background:#F8FAFC;border:1px dashed #cbd5e1;border-radius:12px;padding:20px;text-align:center;color:#64748b;font-size:13px">
                    No open campaigns right now / لا توجد حملات مفتوحة حالياً
                </div>
            </t>

            <!-- My requests -->
            <t t-if="my_lines">
                <div style="font-size:14px;font-weight:800;color:#085041;margin:18px 0 8px">
                    My Requests / طلباتي
                </div>
                <div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden">
                    <table class="table table-sm" style="margin:0;font-size:12px">
                        <thead style="background:#F8FAFC">
                            <tr>
                                <th>Campaign</th><th>Product</th>
                                <th>Discount</th><th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="my_lines" t-as="l">
                                <tr>
                                    <td><t t-esc="l.promotion_id.emoji"/> <t t-esc="l.promotion_id.label_en"/></td>
                                    <td><t t-esc="l.product_tmpl_id.name"/></td>
                                    <td><t t-esc="int(l.discount_pct)"/>%</td>
                                    <td>
                                        <t t-if="l.state == 'approved'"><span style="color:#15803D;font-weight:800">✅ Approved</span></t>
                                        <t t-elif="l.state == 'rejected'"><span style="color:#B91C1C;font-weight:800">❌ Rejected<t t-if="l.reject_reason"> — <t t-esc="l.reject_reason"/></t></span></t>
                                        <t t-else=""><span style="color:#B45309;font-weight:800">⏳ Pending</span></t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
