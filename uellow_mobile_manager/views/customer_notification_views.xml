<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Notification Settings (singleton form) ─────────────────── -->
    <record id="view_mobile_notification_setting_form" model="ir.ui.view">
        <field name="name">mobile.notification.setting.form</field>
        <field name="model">mobile.notification.setting</field>
        <field name="arch" type="xml">
            <form string="Notification Settings">
                <sheet>
                    <div class="oe_title">
                        <h1>🔔 Customer Notification Settings</h1>
                        <p class="text-muted">Enable / disable the automatic
                        notifications each module sends to customers. The
                        customer's own per-category preferences (in the app)
                        are applied on top of these switches.</p>
                    </div>
                    <group>
                        <group string="Master">
                            <field name="master_enabled"/>
                        </group>
                        <group string="Push (Firebase)">
                            <field name="fcm_service_account"
                                   placeholder="Paste service-account JSON here"
                                   widget="text"/>
                        </group>
                        <group string="iOS Live Activity (APNs .p8)">
                            <field name="apns_team_id"/>
                            <field name="apns_key_id"/>
                            <field name="apns_bundle_id"/>
                            <field name="apns_use_sandbox"/>
                            <field name="apns_p8_key"
                                   placeholder="Paste AuthKey_XXXX.p8 contents"
                                   widget="text"/>
                        </group>
                    </group>
                    <group>
                        <group string="Orders">
                            <field name="notify_order_confirmed"/>
                            <field name="notify_order_shipped"/>
                            <field name="notify_order_delivering"/>
                            <field name="notify_order_delivered"/>
                            <field name="notify_order_failed"/>
                            <field name="notify_order_cancelled"/>
                        </group>
                        <group string="Money &amp; Programs">
                            <field name="notify_wallet"/>
                            <field name="notify_loyalty"/>
                            <field name="notify_review_reply"/>
                            <field name="notify_affiliate"/>
                            <field name="notify_promotions"/>
                        </group>
                        <group string="Program Apps (fleet)">
                            <field name="notify_reviewer_new_request"/>
                            <field name="notify_vendor_new_order"/>
                            <field name="notify_driver_assigned"/>
                            <field name="notify_carrier_new_order"/>
                            <field name="notify_affiliate_news"/>
                        </group>
                        <group string="Admin Console (🛡️ in-app)">
                            <field name="notify_admin_new_order"/>
                            <field name="notify_admin_pos_order"/>
                            <field name="notify_admin_pos_session"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobile_notification_setting" model="ir.actions.server">
        <field name="name">Notification Settings</field>
        <field name="model_id" ref="model_mobile_notification_setting"/>
        <field name="state">code</field>
        <field name="code">
rec = env['mobile.notification.setting'].get_conf()
action = {
    'type': 'ir.actions.act_window',
    'res_model': 'mobile.notification.setting',
    'res_id': rec.id,
    'view_mode': 'form',
    'target': 'current',
}
        </field>
    </record>

    <!-- ── Sent event notifications (audit list) ──────────────────── -->
    <record id="view_mobile_customer_notification_list" model="ir.ui.view">
        <field name="name">mobile.customer.notification.list</field>
        <field name="model">mobile.customer.notification</field>
        <field name="arch" type="xml">
            <list create="false" default_order="create_date desc">
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="event_code"/>
                <field name="category"/>
                <field name="title"/>
                <field name="is_read"/>
            </list>
        </field>
    </record>

    <record id="action_mobile_customer_notification" model="ir.actions.act_window">
        <field name="name">Sent Event Notifications</field>
        <field name="res_model">mobile.customer.notification</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mobile_notification_setting"
              name="Notification Settings"
              parent="menu_mobile_marketing"
              action="action_mobile_notification_setting" sequence="11"/>
    <menuitem id="menu_mobile_customer_notification"
              name="Sent Event Notifications"
              parent="menu_mobile_marketing"
              action="action_mobile_customer_notification" sequence="12"/>
</odoo>
