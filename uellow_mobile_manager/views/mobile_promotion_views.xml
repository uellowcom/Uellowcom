<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_promotion_list" model="ir.ui.view">
        <field name="name">mobile.app.promotion.list</field>
        <field name="model">mobile.app.promotion</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'running'"
                  decoration-muted="state == 'ended'">
                <field name="sequence" widget="handle"/>
                <field name="emoji"/>
                <field name="name"/>
                <field name="preset"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="approved_count" string="Products"/>
                <field name="pending_count" string="Pending"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'running'"
                       decoration-info="state == 'open'"/>
            </list>
        </field>
    </record>

    <record id="view_mobile_promotion_form" model="ir.ui.view">
        <field name="name">mobile.app.promotion.form</field>
        <field name="model">mobile.app.promotion</field>
        <field name="arch" type="xml">
            <form string="Promotion">
                <header>
                    <button name="action_open" type="object" string="Open for Vendors"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="▶ Start Now"
                            class="btn-primary" invisible="state not in ('draft', 'open')"/>
                    <button name="action_end" type="object" string="■ End Now"
                            invisible="state != 'running'"/>
                    <button name="action_reset_draft" type="object"
                            string="↺ Reset to Draft"
                            confirm="Bring this campaign back to Draft? Auto-applied prices (if any) are restored; vendor lines are kept."
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,running,ended"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Mother's Day 2026"/></h1>
                    </div>
                    <group>
                        <group string="Campaign">
                            <field name="preset"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="website_ids" widget="many2many_tags"/>
                            <field name="active"/>
                        </group>
                        <group string="Badge (the coin)">
                            <field name="emoji"/>
                            <field name="label_en"/>
                            <field name="label_ar"/>
                            <field name="bg_color" widget="color"/>
                            <field name="fg_color" widget="color"/>
                        </group>
                    </group>
                    <group>
                        <group string="⚡ Product-page Banner (flash-sale style)">
                            <field name="banner_enabled"/>
                            <field name="banner_title_en" invisible="not banner_enabled"/>
                            <field name="banner_title_ar" invisible="not banner_enabled"/>
                            <field name="banner_subtitle_en" invisible="not banner_enabled"/>
                            <field name="banner_subtitle_ar" invisible="not banner_enabled"/>
                            <field name="banner_color_1" widget="color" invisible="not banner_enabled"/>
                            <field name="banner_color_2" widget="color" invisible="not banner_enabled"/>
                            <field name="banner_pattern" invisible="not banner_enabled"/>
                            <field name="banner_pattern_style"
                                   invisible="not banner_enabled or not banner_pattern"/>
                            <field name="banner_icon" widget="image"
                                   options="{'size': [80, 80]}"
                                   invisible="not banner_enabled"/>
                            <field name="banner_icon_bg" widget="color"
                                   invisible="not banner_enabled"/>
                        </group>
                    </group>
                    <group>
                        <group string="Vendors">
                            <field name="vendor_joinable"/>
                            <field name="min_discount_pct"/>
                            <field name="max_discount_pct"/>
                        </group>
                        <group string="⚠️ Pricing Automation">
                            <field name="apply_discounts"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="lines">
                            <field name="line_ids">
                                <list editable="bottom"
                                      decoration-success="state == 'approved' and not is_hidden"
                                      decoration-muted="is_hidden"
                                      decoration-danger="state == 'rejected'">
                                    <field name="is_hidden" column_invisible="1"/>
                                    <field name="product_tmpl_id"/>
                                    <field name="vendor_id"/>
                                    <field name="discount_pct" string="Discount % (stored)"/>
                                    <field name="eff_discount_pct" readonly="1" optional="show"
                                           decoration-warning="eff_discount_pct &lt; discount_pct"/>
                                    <field name="is_hidden" optional="show" string="Hidden 🚫"/>
                                    <field name="cost" readonly="1" optional="show"/>
                                    <field name="price_before" readonly="1" optional="show"/>
                                    <field name="price_after" readonly="1" optional="show"/>
                                    <field name="profit" readonly="1" optional="show"
                                           decoration-danger="profit &lt;= 0"
                                           decoration-success="profit &gt; 0"/>
                                    <field name="profit_pct" readonly="1" optional="show"
                                           decoration-danger="profit_pct &lt;= 0"/>
                                    <field name="net_profit" readonly="1" optional="show"
                                           decoration-danger="net_profit &lt; 0"/>
                                    <field name="net_profit_pct" readonly="1" optional="show"
                                           decoration-danger="net_profit_pct &lt; 0"/>
                                    <field name="note" optional="hide"/>
                                    <field name="state"/>
                                    <field name="reject_reason" optional="hide"/>
                                    <button name="action_approve" type="object"
                                            string="✅" title="Approve"
                                            invisible="state == 'approved'"/>
                                    <button name="action_reject" type="object"
                                            string="❌" title="Reject"
                                            invisible="state == 'rejected'"/>
                                </list>
                            </field>
                        </page>
                        <page string="🎯 Targeting" name="targeting">
                            <group>
                                <field name="target_mode" widget="radio"/>
                            </group>
                            <group invisible="target_mode != 'rules'">
                                <group string="Rule discount">
                                    <field name="global_discount_pct"/>
                                    <field name="min_show_discount_pct"/>
                                    <field name="targeted_count" readonly="1"/>
                                    <field name="excluded_count" readonly="1"/>
                                    <field name="below_min_count" readonly="1"
                                           string="↳ hidden (weak discount)"
                                           decoration-warning="below_min_count &gt; 0"/>
                                    <button name="action_generate_lines"
                                            type="object" colspan="2"
                                            string="🔄 Generate / refresh lines"
                                            class="btn-primary"/>
                                </group>
                            </group>
                            <field name="scope_ids"
                                   invisible="target_mode != 'rules'">
                                <list editable="bottom"
                                      decoration-success="kind == 'include'"
                                      decoration-danger="kind == 'exclude'">
                                    <field name="kind"/>
                                    <field name="scope_type"/>
                                    <field name="category_id"
                                           column_invisible="0"
                                           invisible="scope_type != 'category'"/>
                                    <field name="include_subcats"
                                           invisible="scope_type != 'category'"/>
                                    <field name="brand_id"
                                           invisible="scope_type != 'brand'"/>
                                    <field name="vendor_id"
                                           invisible="scope_type != 'vendor'"/>
                                    <field name="price_min"
                                           invisible="scope_type != 'price_range'"/>
                                    <field name="price_max"
                                           invisible="scope_type != 'price_range'"/>
                                    <field name="product_tmpl_ids"
                                           widget="many2many_tags"
                                           invisible="scope_type != 'product'"/>
                                </list>
                            </field>
                        </page>
                        <page string="💰 Margin Guard" name="margin">
                            <group>
                                <field name="margin_guard"/>
                                <field name="margin_mode"
                                       invisible="not margin_guard"/>
                                <field name="min_margin_pct"
                                       invisible="not margin_guard"/>
                                <field name="margin_reserve_ship"
                                       invisible="not margin_guard"/>
                                <field name="margin_ship_cost"
                                       invisible="not margin_guard or not margin_reserve_ship"/>
                            </group>
                            <div class="text-muted" colspan="2">
                                The discount is capped per product so the
                                profit floor (cost vs. price) is never broken;
                                products that cannot meet it are skipped.
                                Enable “Reserve delivery cost” to also keep
                                enough profit to cover free delivery (the
                                delivery amount is added to the product cost
                                before the floor is measured).
                            </div>
                        </page>
                        <page string="📱 Channel &amp; Caps" name="channel">
                            <group>
                                <group string="Channel">
                                    <field name="channel" widget="radio"/>
                                    <field name="priority"/>
                                    <field name="stackable"/>
                                    <field name="exclusive"/>
                                </group>
                                <group string="Caps">
                                    <field name="usage_limit"/>
                                    <field name="per_customer_limit"/>
                                    <field name="budget_cap"/>
                                    <field name="usage_count" readonly="1"/>
                                    <field name="budget_spent" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="⚙️ Conditions" name="conditions">
                            <group>
                                <group string="Cart">
                                    <field name="cond_min_subtotal"/>
                                    <field name="cond_min_qty"/>
                                    <field name="cond_first_order"/>
                                </group>
                                <group string="Timing">
                                    <field name="cond_days"/>
                                    <field name="cond_hour_from"/>
                                    <field name="cond_hour_to"/>
                                </group>
                            </group>
                            <div class="text-muted" colspan="2">
                                Conditions gate the order-level rewards (gift /
                                free shipping / coupon). Product price discounts
                                from Targeting are not gated by these.
                            </div>
                        </page>
                        <page string="🎁 Rewards" name="rewards">
                            <group>
                                <group string="Gift &amp; shipping">
                                    <field name="reward_free_ship"/>
                                    <field name="reward_gift_product_id"/>
                                    <field name="reward_gift_qty"
                                           invisible="not reward_gift_product_id"/>
                                    <field name="reward_gift_threshold"
                                           invisible="not reward_gift_product_id"/>
                                </group>
                                <group string="Coupon &amp; loyalty">
                                    <field name="reward_coupon_mode"/>
                                    <field name="reward_coupon_program_id"
                                           invisible="reward_coupon_mode == 'none'"/>
                                    <field name="reward_loyalty_multiplier"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobile_promotions" model="ir.actions.act_window">
        <field name="name">🎉 Promotions</field>
        <field name="res_model">mobile.app.promotion</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first campaign</p>
            <p>Mother's Day, Eid, Black Friday… badge coins on cards,
               product-page banners, builder blocks and vendor joins.</p>
        </field>
    </record>
    <menuitem id="menu_mobile_promotions" name="🎉 Promotions"
              parent="uellow_mobile_manager.menu_mobile_root"
              action="action_mobile_promotions" sequence="34"/>

    <record id="cron_promotion_lifecycle" model="ir.cron" forcecreate="True">
        <field name="name">Uellow: promotion lifecycle (start/end by dates)</field>
        <field name="model_id" ref="model_mobile_app_promotion"/>
        <field name="state">code</field>
        <field name="code">model.cron_lifecycle()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
