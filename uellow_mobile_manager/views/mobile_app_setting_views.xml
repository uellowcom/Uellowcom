<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mobile_app_setting_view_form" model="ir.ui.view">
        <field name="name">mobile.app.setting.form</field>
        <field name="model">mobile.app.setting</field>
        <field name="arch" type="xml">
            <form string="App Settings">
                <sheet>
                    <div class="oe_title">
                        <h1>Mobile App Settings</h1>
                    </div>
                    <notebook>
                        <!-- TAB 1: General -->
                        <page string="General" name="general">
                            <group>
                                <group string="App Info">
                                    <field name="website_id"/>
                                    <field name="app_name"/>
                                    <field name="app_logo" widget="image" options="{'size': [120, 120]}"/>
                                    <field name="currency_id"/>
                                </group>
                                <group string="Version Control">
                                    <field name="app_version_android"/>
                                    <field name="app_version_ios"/>
                                    <field name="force_update"/>
                                    <field name="maintenance_mode"/>
                                    <field name="maintenance_message"
                                           invisible="not maintenance_mode"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB: Checkout (v2.1.21) -->
                        <page string="🛒 Checkout" name="checkout">
                            <group>
                                <group string="Guest Checkout">
                                    <field name="guest_checkout_enabled"/>
                                </group>
                                <group string="Returns &amp; Refunds">
                                    <field name="returns_url" placeholder="https://kw.uellow.com/returns"/>
                                </group>
                            </group>
                            <group>
                                <group string="💳 Online Payment Cashback">
                                    <field name="online_cashback_enabled"/>
                                    <field name="online_cashback_amount" invisible="not online_cashback_enabled"/>
                                    <field name="online_cashback_pct" invisible="not online_cashback_enabled"/>
                                    <field name="online_cashback_cap" invisible="not online_cashback_enabled"/>
                                    <field name="online_cashback_min_order" invisible="not online_cashback_enabled"/>
                                    <field name="cod_refund_enabled"/>
                                    <field name="show_cod_refund_teaser"/>
                                    <field name="show_cod_fee_note"/>
                                </group>
                                <group string="🇰🇼 Country-gated payments · KNET / Taly">
                                    <field name="pay_knet_enabled"/>
                                    <field name="pay_knet_kw_only" invisible="not pay_knet_enabled"/>
                                    <field name="pay_taly_enabled"/>
                                    <field name="pay_taly_kw_only" invisible="not pay_taly_enabled"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB 2: Social Media -->
                        <page string="Social Media" name="social">
                            <group>
                                <group string="Social Channels">
                                    <field name="whatsapp_number" placeholder="+96594709709"/>
                                    <field name="facebook_url" placeholder="https://facebook.com/uellow"/>
                                    <field name="instagram_url" placeholder="https://instagram.com/uellow"/>
                                    <field name="youtube_url"/>
                                    <field name="tiktok_url"/>
                                    <field name="twitter_url"/>
                                </group>
                                <group string="App Stores">
                                    <field name="google_play_url"/>
                                    <field name="app_store_url"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB 3: Contact & Legal -->
                        <page string="Contact &amp; Legal" name="contact">
                            <group>
                                <group string="Support">
                                    <field name="support_email"/>
                                    <field name="support_phone"/>
                                    <field name="contact_url"/>
                                </group>
                                <group string="Legal Pages">
                                    <field name="about_us_url"/>
                                    <field name="privacy_policy_url"/>
                                    <field name="terms_url"/>
                                    <field name="blog_url"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB 4: Chat -->
                        <page string="Live Chat" name="chat">
                            <group>
                                <field name="chat_enabled"/>
                                <field name="chat_provider" invisible="not chat_enabled"/>
                                <field name="chat_custom_url"
                                       invisible="chat_provider != 'custom' or not chat_enabled"/>
                            </group>
                        </page>

                        <!-- TAB 5: Theme -->
                        <page string="Theme &amp; Colors" name="theme">
                            <group>
                                <field name="primary_color" widget="color"/>
                                <field name="secondary_color" widget="color"/>
                                <field name="accent_color" widget="color"/>
                            </group>
                            <div class="alert alert-info mt-3">
                                <i class="fa fa-info-circle me-1"/>
                                Color changes require a new app build to take effect.
                            </div>
                        </page>

                        <!-- TAB 6: Firebase -->
                        <page string="Push / Firebase" name="firebase" groups="base.group_system">
                            <group>
                                <field name="firebase_project_id"/>
                                <field name="fcm_server_key" password="True"/>
                            </group>
                            <div class="alert alert-warning mt-2">
                                <i class="fa fa-lock me-1"/>
                                FCM credentials are encrypted and only visible to administrators.
                            </div>
                        </page>

                        <!-- TAB 7: Countries -->
                        <page string="Countries" name="countries">
                            <field name="country_ids" widget="many2many_tags"/>
                        </page>

                        <!-- TAB 8: Warehouse (sourcing center) -->
                        <page string="Warehouse / Sourcing Center" name="warehouse">
                            <group>
                                <group string="Display Name (Bilingual)">
                                    <field name="warehouse_name_en" placeholder="Uellow Warehouse"/>
                                    <field name="warehouse_name_ar" placeholder="مخزن يلو"/>
                                    <field name="warehouse_address"/>
                                </group>
                                <group string="GPS Coordinates">
                                    <field name="warehouse_lat"/>
                                    <field name="warehouse_lng"/>
                                </group>
                            </group>
                            <div class="alert alert-info mt-2">
                                <i class="fa fa-map-marker me-1"/>
                                These coordinates pin the Uellow warehouse on the customer's
                                live tracking map once an order is confirmed. Use Google Maps
                                → right-click the location → copy lat,lng.
                            </div>
                        </page>

                        <!-- TAB 9: Live tracking + Push tunings -->
                        <page string="Live Tracking &amp; Push" name="tracking">
                            <group>
                                <group string="Proximity">
                                    <field name="proximity_alert_km"/>
                                    <field name="driver_heartbeat_seconds"/>
                                </group>
                                <group string="Lock Screen / Banners">
                                    <field name="live_activity_enabled"/>
                                    <field name="ongoing_notification_enabled"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB 10: Deep links / App identity -->
                        <page string="Deep Links / App Identity" name="deeplinks">
                            <group>
                                <group string="Android">
                                    <field name="android_package"/>
                                    <field name="android_fingerprint"
                                           placeholder="AA:BB:CC:... (SHA-256)"/>
                                </group>
                                <group string="iOS">
                                    <field name="ios_app_id"
                                           placeholder="TEAMID.com.uellow.app"/>
                                </group>
                                <group string="Stores">
                                    <field name="google_play_url"/>
                                    <field name="app_store_url"/>
                                    <field name="appgallery_url"/>
                                </group>
                            </group>
                            <div class="alert alert-warning mt-2">
                                <i class="fa fa-info-circle me-1"/>
                                The Android fingerprint is served as
                                <code>/.well-known/assetlinks.json</code> so the OS
                                opens uellow.com links in the app. Get it from
                                <code>keytool -list -v -keystore release.keystore</code>.
                            </div>
                        </page>

                        <!-- TAB 11: Checkout policy -->
                        <page string="Checkout Policy" name="checkout">
                            <group>
                                <group string="Address Form">
                                    <field name="require_phone_on_address"/>
                                    <field name="require_address_photo"/>
                                    <field name="enable_smart_address_picker"/>
                                    <field name="enable_address_photo_upload"/>
                                </group>
                                <group string="Pricing">
                                    <field name="free_shipping_min_kd"/>
                                    <field name="cash_on_delivery_fee_kd"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB 12: Feature switches -->
                        <page string="Feature Switches" name="features">
                            <group>
                                <group>
                                    <field name="enable_review_dialog"/>
                                    <field name="enable_deep_links"/>
                                </group>
                                <group>
                                    <field name="enable_app_banner"/>
                                </group>
                                <group string="🏆 Best-Seller Badge">
                                    <field name="rank_badge_scope"
                                           help="Quiet 'Best seller in X' line under the product name on app cards. Off hides it everywhere."/>
                                </group>
                                <group string="🛍 Shop Page Sections">
                                    <field name="shop_show_recent"/>
                                    <field name="shop_show_products"/>
                                    <field name="shop_show_brands"/>
                                </group>
                                <group string="⭐ Shop 'For You' Entry">
                                    <field name="shop_foryou_enabled"/>
                                    <field name="shop_foryou_categ_ids"
                                           widget="many2many_tags"
                                           invisible="not shop_foryou_enabled"/>
                                    <field name="shop_foryou_brand_value_ids"
                                           widget="many2many_tags"
                                           invisible="not shop_foryou_enabled"/>
                                </group>
                            </group>
                            <div class="alert alert-info mt-2">
                                <i class="fa fa-toggle-on me-1"/>
                                Toggle individual features on/off without redeploying the app.
                                The Flutter side reads these via <code>/api/mobile/v2/settings</code>.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mobile_app_setting_view_list" model="ir.ui.view">
        <field name="name">mobile.app.setting.list</field>
        <field name="model">mobile.app.setting</field>
        <field name="arch" type="xml">
            <list string="App Settings">
                <field name="website_id"/>
                <field name="app_name"/>
                <field name="app_version_android"/>
                <field name="app_version_ios"/>
                <field name="maintenance_mode" widget="toggle_button"/>
                <field name="force_update" widget="toggle_button"/>
            </list>
        </field>
    </record>

    <!-- Singleton-style action — always lands on the existing settings row
         (creating it once if missing) so users never hit the
         `unique(website_id)` constraint by accidentally creating a duplicate
         empty form when the row was already auto-created by an API call.
         A separate xmlid is used because the legacy `action_mobile_app_setting`
         is an `ir.actions.act_window` already stored in DB — Odoo can't
         upgrade a record across action models. -->
    <record id="action_mobile_app_setting_open" model="ir.actions.server">
        <field name="name">App Settings</field>
        <field name="model_id" ref="model_mobile_app_setting"/>
        <field name="state">code</field>
        <field name="code">action = env['mobile.app.setting'].action_open_singleton()</field>
    </record>

    <!-- Kept (but no longer linked from the menu) for multi-website debugging -->
    <record id="action_mobile_app_setting" model="ir.actions.act_window">
        <field name="name">App Settings (per-website list)</field>
        <field name="res_model">mobile.app.setting</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
