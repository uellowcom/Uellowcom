<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Add the multi-website field right under the native Website field on the
       product form (Sales tab → eCommerce). -->
  <record id="view_product_template_form_multi_website" model="ir.ui.view">
    <field name="name">product.template.form.multi.website</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="website_sale.product_template_form_view"/>
    <field name="arch" type="xml">
      <field name="website_id" position="after">
        <field name="uellow_extra_website_ids" widget="many2many_tags"
               options="{'no_create': True}"
               placeholder="Also show on Egypt web + Egypt app…"/>
      </field>
    </field>
  </record>
</odoo>
