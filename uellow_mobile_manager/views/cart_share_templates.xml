<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Public landing page when someone opens a shared-cart link. -->
  <template id="cart_share_view" name="Uellow Shared Cart">
    <t t-call="website.layout">
      <div class="container my-5" style="max-width:720px">
        <div class="text-center mb-4">
          <h1 style="font-weight:900;color:#412402">🛒 Cart shared with you</h1>
          <p class="text-muted">Someone shared <b><t t-esc="count"/> items</b> with you on Uellow.</p>
        </div>
        <div class="card shadow-sm border-0" style="border-radius:14px;overflow:hidden">
          <div class="card-body p-0">
            <t t-foreach="items" t-as="it">
              <div class="d-flex p-3 border-bottom align-items-center">
                <div style="flex:1">
                  <div style="font-weight:700;color:#412402"><t t-esc="it.get('name')"/></div>
                  <small class="text-muted">Quantity: <t t-esc="int(it.get('qty') or 1)"/></small>
                </div>
                <div style="font-weight:900;color:#412402">
                  <t t-esc="'%.3f KD' % float(it.get('price') or 0)"/>
                </div>
              </div>
            </t>
          </div>
        </div>
        <form t-attf-action="/cart/share/{{share.token}}/adopt" method="post" class="text-center mt-4">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <button type="submit" class="btn btn-warning btn-lg" style="background:#F5C320;border:none;color:#412402;font-weight:900;padding:12px 36px;border-radius:14px">
            Add all to my cart →
          </button>
          <div class="mt-3">
            <a href="/shop" class="text-muted small">Continue shopping instead</a>
          </div>
        </form>
      </div>
    </t>
  </template>

  <template id="cart_share_not_found" name="Shared Cart Not Found">
    <t t-call="website.layout">
      <div class="container my-5 text-center" style="max-width:560px">
        <h1 style="font-weight:900;color:#412402">Link expired</h1>
        <p class="text-muted">This shared cart is no longer available.</p>
        <a href="/shop" class="btn btn-warning" style="background:#F5C320;border:none;color:#412402;font-weight:800">Go to shop</a>
      </div>
    </t>
  </template>
</odoo>
