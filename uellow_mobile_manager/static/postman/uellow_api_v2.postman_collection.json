{
  "info": {
    "name": "Uellow Mobile API v2",
    "_postman_id": "a4f7e2c1-9b3a-4d5e-8c7f-1234567890ab",
    "description": "Full coverage of /api/mobile/v2/* — auth, products, cart, orders, profile, loyalty, wallet, Beena, notifications.\n\n**Setup:**\n1. Import this collection + the environment file.\n2. Set `base_url` to your Odoo host (default: https://www.uellow.com).\n3. Run 'Auth > Login' once — the test script auto-saves the token into the `token` env var.\n4. All subsequent requests pick up the token from `{{token}}` automatically.\n\nGuest endpoints (home/products/categories/search/settings) work without a token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]
  },
  "variable": [
    {"key": "base_url", "value": "https://www.uellow.com"},
    {"key": "token",     "value": ""},
    {"key": "cart_token","value": ""}
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-add X-Cart-Token if we have one stored",
          "const ct = pm.environment.get('cart_token') || pm.collectionVariables.get('cart_token');",
          "if (ct) pm.request.headers.add({key:'X-Cart-Token', value: ct});",
          "// Default language header",
          "if (!pm.request.headers.has('X-Lang')) pm.request.headers.add({key:'X-Lang', value:'en'});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (email+password)",
          "request": {
            "method": "POST",
            "url": {"raw": "{{base_url}}/api/mobile/v2/auth/login", "host": ["{{base_url}}"], "path": ["api","mobile","v2","auth","login"]},
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"email\": \"ali@uellow.com\",\n  \"password\": \"YOUR_PASSWORD\",\n  \"device_id\": \"postman-dev\",\n  \"device_name\": \"Postman\",\n  \"app_version\": \"4.1.11\"\n}"}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  pm.environment.set('token', json.data.token);",
                  "  console.log('Token saved:', json.data.token.slice(0, 16) + '...');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": {"raw": "{{base_url}}/api/mobile/v2/auth/register"},
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"name\": \"Test User\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"changeme123\",\n  \"phone\": \"+96599000000\"\n}"}
          }
        },
        {
          "name": "OTP Request",
          "request": {
            "method": "POST",
            "url": {"raw": "{{base_url}}/api/mobile/v2/auth/otp/request"},
            "body": {"mode":"raw","raw":"{\"phone\": \"+96599000000\"}"}
          }
        },
        {
          "name": "OTP Verify",
          "request": {
            "method": "POST",
            "url": {"raw": "{{base_url}}/api/mobile/v2/auth/otp/verify"},
            "body": {"mode":"raw","raw":"{\"phone\":\"+96599000000\",\"firebase_uid\":\"FIREBASE_UID_HERE\",\"name\":\"Phone User\"}"}
          }
        },
        {
          "name": "Social — Google",
          "request": {
            "method": "POST",
            "url": {"raw": "{{base_url}}/api/mobile/v2/auth/social/google"},
            "body": {"mode":"raw","raw":"{\"email\":\"google@example.com\",\"provider_user_id\":\"GOOGLE_UID\",\"name\":\"Google User\"}"}
          }
        },
        {
          "name": "Social — Apple",
          "request": {
            "method": "POST",
            "url": {"raw": "{{base_url}}/api/mobile/v2/auth/social/apple"},
            "body": {"mode":"raw","raw":"{\"email\":\"apple@privaterelay.appleid.com\",\"provider_user_id\":\"APPLE_UID\",\"name\":\"Apple User\"}"}
          }
        },
        {
          "name": "Social — Facebook",
          "request": {
            "method": "POST",
            "url": {"raw": "{{base_url}}/api/mobile/v2/auth/social/facebook"},
            "body": {"mode":"raw","raw":"{\"email\":\"fb@example.com\",\"provider_user_id\":\"FB_UID\",\"name\":\"Facebook User\"}"}
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "url": {"raw": "{{base_url}}/api/mobile/v2/auth/forgot"},
            "body": {"mode":"raw","raw":"{\"email\":\"ali@uellow.com\"}"}
          }
        },
        {
          "name": "Me (current user)",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/api/mobile/v2/auth/me"}
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {"raw": "{{base_url}}/api/mobile/v2/auth/logout"}
          }
        }
      ]
    },
