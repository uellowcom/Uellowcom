<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_perf_error_bucket_list" model="ir.ui.view">
    <field name="name">uellow.perf.error.bucket.list</field>
    <field name="model">uellow.perf.error.bucket</field>
    <field name="arch" type="xml">
      <list string="HTTP error buckets"
            decoration-danger="status_code &gt;= 500"
            decoration-warning="status_code &gt;= 400 and status_code &lt; 500">
        <field name="bucket_at"/>
        <field name="status_code"/>
        <field name="count" sum="Total"/>
        <field name="sample_path"/>
      </list>
    </field>
  </record>

  <record id="action_perf_error_bucket" model="ir.actions.act_window">
    <field name="name">5xx Errors</field>
    <field name="res_model">uellow.perf.error.bucket</field>
    <field name="view_mode">list</field>
    <field name="domain">[('status_code', '&gt;=', 500)]</field>
  </record>

  <record id="view_perf_bundle_size_list" model="ir.ui.view">
    <field name="name">uellow.perf.bundle.size.list</field>
    <field name="model">uellow.perf.bundle.size</field>
    <field name="arch" type="xml">
      <list string="JS/CSS bundle sizes">
        <field name="create_date"/>
        <field name="url"/>
        <field name="size_kb" string="Size (KB)"/>
        <field name="encoding"/>
        <field name="status_code"/>
      </list>
    </field>
  </record>

  <record id="view_perf_bundle_size_graph" model="ir.ui.view">
    <field name="name">uellow.perf.bundle.size.graph</field>
    <field name="model">uellow.perf.bundle.size</field>
    <field name="arch" type="xml">
      <graph string="Bundle size over time" type="line">
        <field name="create_date" interval="day"/>
        <field name="url"/>
        <field name="size_kb" type="measure"/>
      </graph>
    </field>
  </record>

  <record id="action_perf_bundle_size" model="ir.actions.act_window">
    <field name="name">Bundle Sizes</field>
    <field name="res_model">uellow.perf.bundle.size</field>
    <field name="view_mode">list,graph</field>
  </record>
</odoo>
