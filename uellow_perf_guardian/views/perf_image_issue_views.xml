<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_perf_image_issue_list" model="ir.ui.view">
    <field name="name">uellow.perf.image.issue.list</field>
    <field name="model">uellow.perf.image.issue</field>
    <field name="arch" type="xml">
      <list string="Oversized images"
            decoration-danger="size_kb &gt;= 2000"
            decoration-warning="size_kb &gt;= 500 and size_kb &lt; 2000"
            decoration-muted="fixed">
        <field name="name"/>
        <field name="mimetype"/>
        <field name="size_kb" string="Size (KB)"/>
        <field name="width"/>
        <field name="height"/>
        <field name="fixed"/>
        <field name="fixed_size_kb" string="After fix (KB)"/>
        <field name="last_scanned"/>
        <button name="action_optimize" type="object" icon="fa-magic"
                string="Optimize" invisible="fixed"/>
      </list>
    </field>
  </record>

  <record id="action_perf_image_issue" model="ir.actions.act_window">
    <field name="name">Image Audit</field>
    <field name="res_model">uellow.perf.image.issue</field>
    <field name="view_mode">list</field>
  </record>

  <record id="action_perf_image_scan_now" model="ir.actions.server">
    <field name="name">Scan attachments for oversized images now</field>
    <field name="model_id" ref="model_uellow_perf_image_issue"/>
    <field name="state">code</field>
    <field name="code">n = model.cron_scan(limit=500)
action = {'type':'ir.actions.client','tag':'display_notification','params':{'title':'Image audit','message':'Flagged %s images'%n,'type':'success','sticky':False}}</field>
  </record>
</odoo>
