<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_perf_synthetic_list" model="ir.ui.view">
    <field name="name">uellow.perf.synthetic.list</field>
    <field name="model">uellow.perf.synthetic</field>
    <field name="arch" type="xml">
      <list string="Synthetic probes"
            decoration-success="ok and total_ms &lt; 1000"
            decoration-warning="ok and total_ms &gt;= 1000 and total_ms &lt; 2500"
            decoration-danger="not ok or total_ms &gt;= 2500">
        <field name="create_date"/>
        <field name="url"/>
        <field name="status_code"/>
        <field name="total_ms" string="Total (ms)"/>
        <field name="size_bytes"/>
        <field name="ok"/>
        <field name="error"/>
      </list>
    </field>
  </record>

  <record id="view_perf_synthetic_graph" model="ir.ui.view">
    <field name="name">uellow.perf.synthetic.graph</field>
    <field name="model">uellow.perf.synthetic</field>
    <field name="arch" type="xml">
      <graph string="Synthetic TTFB" type="line">
        <field name="create_date" interval="hour"/>
        <field name="url"/>
        <field name="total_ms" type="measure"/>
      </graph>
    </field>
  </record>

  <record id="action_perf_synthetic" model="ir.actions.act_window">
    <field name="name">Synthetic Probes</field>
    <field name="res_model">uellow.perf.synthetic</field>
    <field name="view_mode">list,graph</field>
  </record>

  <record id="action_perf_synthetic_run_now" model="ir.actions.server">
    <field name="name">Run synthetic probes now</field>
    <field name="model_id" ref="model_uellow_perf_synthetic"/>
    <field name="state">code</field>
    <field name="code">n = model.cron_run_synthetic()
action = {'type':'ir.actions.client','tag':'display_notification','params':{'title':'Synthetic','message':'Probed %s URLs'%n,'type':'success','sticky':False}}</field>
  </record>
</odoo>
