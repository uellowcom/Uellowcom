<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_perf_dashboard_form" model="ir.ui.view">
    <field name="name">uellow.perf.dashboard.form</field>
    <field name="model">uellow.perf.dashboard</field>
    <field name="arch" type="xml">
      <form string="Performance Dashboard" create="false" delete="false">
        <sheet>
          <div class="oe_title">
            <h1>Performance Dashboard</h1>
            <p style="font-size:12px;color:#888">
              Live snapshot. Refresh the page to recompute.
            </p>
          </div>
          <field name="html_summary" nolabel="1" widget="html" readonly="1"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_perf_dashboard" model="ir.actions.server">
    <field name="name">Performance Dashboard</field>
    <field name="model_id" ref="model_uellow_perf_dashboard"/>
    <field name="state">code</field>
    <field name="code">action = model.open_dashboard()</field>
  </record>
</odoo>
