<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 80mm thermal receipt paper format -->
    <record id="paperformat_pos_receipt" model="report.paperformat">
        <field name="name">Uellow POS Receipt 80mm</field>
        <field name="format">custom</field>
        <field name="page_width">80</field>
        <field name="page_height">240</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_spacing">0</field>
        <field name="header_line" eval="False"/>
        <field name="orientation">Portrait</field>
        <field name="dpi">96</field>
    </record>

    <!-- A4 report action -->
    <record id="action_report_pos_closing_a4" model="ir.actions.report">
        <field name="name">Cashier Closing · A4 — إغلاق الكاشير</field>
        <field name="model">pos.session</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">uellow_pos_closing.report_pos_closing_a4</field>
        <field name="report_file">uellow_pos_closing.report_pos_closing_a4</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_session"/>
        <field name="binding_type">report</field>
    </record>

    <!-- 80mm receipt report action -->
    <record id="action_report_pos_closing_receipt" model="ir.actions.report">
        <field name="name">Cashier Closing · Receipt 80mm — إيصال إغلاق</field>
        <field name="model">pos.session</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">uellow_pos_closing.report_pos_closing_receipt</field>
        <field name="report_file">uellow_pos_closing.report_pos_closing_receipt</field>
        <field name="paperformat_id" ref="paperformat_pos_receipt"/>
        <field name="binding_model_id" ref="point_of_sale.model_pos_session"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
