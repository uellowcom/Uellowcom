<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mobile_navbar_tree" model="ir.ui.view">
    <field name="name">mobile.navbar.tree</field>
    <field name="model">mobile.navbar</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="website_id"/>
        <field name="country_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>
  <record id="view_mobile_navbar_form" model="ir.ui.view">
    <field name="name">mobile.navbar.form</field>
    <field name="model">mobile.navbar</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <field name="website_id"/>
            <field name="country_id"/>
            <field name="active"/>
            <field name="active_color"/>
            <field name="inactive_color"/>
            <field name="show_labels"/>
            <field name="haptic"/>
            <field name="floating_action"/>
          </group>
          <notebook>
            <page string="Items (JSON)">
              <field name="items_json" widget="ace" options="{'mode':'json'}"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_mobile_navbar" model="ir.actions.act_window">
    <field name="name">Nav bars</field>
    <field name="res_model">mobile.navbar</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
