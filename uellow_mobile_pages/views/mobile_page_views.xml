<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Defined here (rather than builder_menu.xml) because the form view
       below references it via %(open_builder)d. -->
  <record id="open_builder" model="ir.actions.act_url">
    <field name="name">Open Visual Builder</field>
    <field name="url">/uellow-builder</field>
    <field name="target">new</field>
  </record>

  <record id="view_mobile_page_tree" model="ir.ui.view">
    <field name="name">mobile.page.tree</field>
    <field name="model">mobile.page</field>
    <field name="arch" type="xml">
      <list>
        <field name="pinned" widget="boolean_toggle"/>
        <field name="name"/>
        <field name="slug"/>
        <field name="kind"/>
        <field name="status" widget="badge"
               decoration-success="status == 'published'"
               decoration-info="status == 'scheduled'"
               decoration-muted="status == 'draft'"/>
        <field name="theme_preset_id"/>
        <field name="website_ids" widget="many2many_tags"/>
        <field name="current_version"/>
        <field name="write_date"/>
      </list>
    </field>
  </record>
  <record id="view_mobile_page_form" model="ir.ui.view">
    <field name="name">mobile.page.form</field>
    <field name="model">mobile.page</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_publish"     string="Publish"   type="object" class="btn-primary"/>
          <button name="action_archive"     string="Archive"   type="object"/>
          <button name="action_pin_as_home" string="Pin as Home" type="object"/>
          <button name="%(uellow_mobile_pages.open_builder)d" string="Open in Visual Builder" type="action" class="btn-primary"/>
          <field name="status" widget="statusbar" statusbar_visible="draft,scheduled,published"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="Page name"/></h1>
            <div>/ <field name="slug" placeholder="page-slug" style="font-family:monospace"/></div>
          </div>
          <group>
            <group string="Identity">
              <field name="kind"/>
              <field name="pinned"/>
              <field name="theme_preset_id"/>
            </group>
            <group string="Targeting">
              <field name="website_ids" widget="many2many_tags"/>
              <field name="country_ids" widget="many2many_tags"/>
              <field name="lang_ids" widget="many2many_tags"/>
            </group>
          </group>
          <notebook>
            <page string="Blocks (JSON)">
              <field name="blocks_json" widget="ace" options="{'mode': 'json'}"/>
            </page>
            <page string="Theme override (JSON)">
              <field name="theme_override" widget="ace" options="{'mode': 'json'}"/>
            </page>
            <page string="Schedule">
              <group>
                <field name="publish_at"/>
                <field name="unpublish_at"/>
              </group>
            </page>
            <page string="SEO">
              <group>
                <field name="seo_title"/>
                <field name="seo_description"/>
                <field name="seo_image"/>
              </group>
            </page>
            <page string="Versions">
              <field name="version_ids">
                <list>
                  <field name="version_no"/>
                  <field name="note"/>
                  <field name="create_date"/>
                  <button name="action_restore" type="object" icon="fa-undo" string="Restore"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_mobile_page" model="ir.actions.act_window">
    <field name="name">Pages</field>
    <field name="res_model">mobile.page</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Theme presets -->
  <record id="view_mobile_theme_preset_tree" model="ir.ui.view">
    <field name="name">mobile.theme.preset.tree</field>
    <field name="model">mobile.theme.preset</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence" widget="handle"/>
        <field name="icon"/>
        <field name="code"/>
        <field name="name"/>
        <field name="primary" widget="char"/>
        <field name="dark" widget="char"/>
      </list>
    </field>
  </record>
  <!-- v2.2.29 — clean, organised theme form (was an auto-generated flat
       form that looked messy). Colour groups + live preview swatches. -->
  <record id="view_mobile_theme_preset_form" model="ir.ui.view">
    <field name="name">mobile.theme.preset.form</field>
    <field name="model">mobile.theme.preset</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1>
              <field name="icon" placeholder="🎨" style="max-width:46px;display:inline-block"/>
              <field name="name" placeholder="Theme name" style="display:inline-block"/>
            </h1>
            <field name="code" placeholder="unique-code"/>
          </div>
          <group>
            <group string="🎨 Brand colours">
              <field name="primary" placeholder="#F5C320"/>
              <field name="dark" placeholder="#412402"/>
              <field name="accent" placeholder="#1F8A40"/>
            </group>
            <group string="🖼 Backgrounds">
              <field name="page_bg" placeholder="#FAF6EB"/>
              <field name="hero_bg" placeholder="linear-gradient(...)"/>
            </group>
            <group string="🔤 Text">
              <field name="text_color" placeholder="#1F1206"/>
              <field name="muted_color" placeholder="#7A6850"/>
            </group>
            <group string="⚙️ Ordering">
              <field name="sequence"/>
            </group>
          </group>
          <notebook>
            <page string="Advanced (JSON tokens)">
              <field name="extras_json" widget="ace" options="{'mode': 'json'}"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_mobile_theme_preset" model="ir.actions.act_window">
    <field name="name">Themes &amp; Colors</field>
    <field name="res_model">mobile.theme.preset</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create your first theme</p>
      <p>Define brand colours, backgrounds and text tokens applied across the app pages.</p>
    </field>
  </record>
</odoo>
