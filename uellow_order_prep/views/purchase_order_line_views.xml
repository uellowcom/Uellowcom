<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="uc_view_purchase_order_form_line_image" model="ir.ui.view">
        <field name="name">purchase.order.form.uc.line.image</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="before">
                <field name="uc_product_image" widget="image"
                       options="{'size': [38, 38]}" nolabel="1" readonly="1"
                       optional="show" string="صورة"/>
            </xpath>
        </field>
    </record>
</odoo>
