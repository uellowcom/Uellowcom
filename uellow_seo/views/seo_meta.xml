<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        We're standing on Odoo's shoulders here. Out of the box,
        `website.layout` already emits these meta tags:
          • og:type / og:site_name / og:title / og:url / og:image / og:description
          • twitter:card
          • a default theme-color (#FFFFFF)
          • a canonical link

        So this template only ADDS what Odoo doesn't ship:
          • twitter:title / twitter:image (richer Twitter cards)
          • Uellow-branded theme-color override (#F5C320)
          • preconnect + dns-prefetch hints for Google Fonts

        Priority is bumped to 50 so our theme-color comes AFTER the
        default one in the head — browsers use the last declared value.
    -->
    <template id="layout_seo_meta" inherit_id="website.layout"
              name="Uellow: SEO meta tags (twitter + theme-color + preconnects)"
              priority="50">
        <xpath expr="//head" position="inside">

            <!-- ── Twitter title + image (Odoo only emits twitter:card) -->
            <meta name="twitter:title"
                  t-att-content="(main_object and main_object.display_name) or (website and website.name) or 'Uellow'"/>
            <meta name="twitter:image"
                  t-att-content="request.httprequest.host_url.rstrip('/') + (
                                   (website and website.logo) and
                                   ('/web/image/website/' + str(website.id) + '/logo')
                                   or ''
                                 )"/>

            <!-- ── Resource hints — open TCP+TLS to Google Fonts in
                 parallel with HTML parsing. Cheap, big win on first paint. -->
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link rel="dns-prefetch" href="//fonts.googleapis.com"/>
            <link rel="dns-prefetch" href="//fonts.gstatic.com"/>

            <!-- ── Brand-coloured theme-color overrides Odoo's white default.
                 Browsers use the LAST declared value, so as long as we're
                 injected after the default, our value wins. -->
            <meta name="theme-color" content="#F5C320"/>

        </xpath>
    </template>
</odoo>
