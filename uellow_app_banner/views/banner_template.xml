<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="uellow_app_banner" name="Uellow App Smart Banner"
              inherit_id="website.layout" priority="99">
        <!-- iOS native Smart App Banner: Safari shows it only when the app is
             NOT installed, and the app-argument deep-links the current page
             into the app. -->
        <xpath expr="//head" position="inside">
            <t t-if="website.uc_app_banner_enabled and website.uc_app_banner_ios_smart">
                <meta name="apple-itunes-app"
                      t-att-content="'app-id=6769010765, app-argument=' + request.httprequest.url"/>
            </t>
        </xpath>
        <!-- Crawlable internal link to the /app landing page, in the footer,
             with keyword-rich bilingual anchor text so Google associates
             "Uellow App / تطبيق يلو / تطبيق يلو دوت كوم" with /app. -->
        <xpath expr="//footer" position="inside">
            <div class="container text-center py-2"
                 style="font-size:13px;border-top:1px solid rgba(255,255,255,.08);">
                <a href="/app" title="تطبيق يلو · Uellow App"
                   style="color:#F5C320;text-decoration:none;font-weight:700;">
                    حمّل تطبيق يلو · Download the Uellow App
                </a>
                <span style="opacity:.4"> · </span>
                <a href="/app" style="color:inherit;opacity:.7;text-decoration:none;">uellow.com/app</a>
            </div>
        </xpath>
        <xpath expr="//header" position="before">
            <div id="uellow-app-banner" style="display:none"
                 t-if="website.uc_app_banner_enabled"
                 t-att-data-devices="website.uc_app_banner_devices or 'both'"
                 t-att-data-frequency="website.uc_app_banner_frequency or 'daily'"
                 t-att-data-dismiss-days="website.uc_app_banner_dismiss_days or 7"
                 t-att-data-ios-smart="website.uc_app_banner_ios_smart and '1' or '0'">
                <div class="uab-inner">
                    <div class="uab-logo">
                        <img src="/web/image/website/1/favicon" alt="Uellow"/>
                    </div>
                    <div class="uab-text">
                        <strong class="uab-title">
                            <span class="en">Uellow App</span>
                            <span class="ar">تطبيق يلو</span>
                        </strong>
                        <span class="uab-sub">
                            <span class="en">Shop faster · Track orders live · Earn points</span>
                            <span class="ar">تسوق أسرع · تتبع طلباتك مباشرة · اكسب نقاط</span>
                        </span>
                    </div>
                    <a id="uab-cta" class="uab-cta" href="#">
                        <span class="en">Open</span>
                        <span class="ar">فتح</span>
                    </a>
                    <button id="uab-close" class="uab-close" aria-label="Close">×</button>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
