<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_delivery_portal" model="ir.ui.view">
        <field name="name">res.config.settings.form.delivery.portal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="🚚 Delivery Portal" name="delivery_carrier_portal">
                    <block title="Vendors">
                        <setting string="Vendor Shipping Methods"
                                 help="Vendors manage their own delivery methods at /my/vendor/shipping; offered only on carts made up entirely of their products.">
                            <field name="uellow_vendor_carriers_enabled"/>
                        </setting>
                    </block>
                    <block title="Warehouse / Inventory">
                        <setting string="Inventory Confirm-Delivery Button"
                                 help="Show a 'Confirm Delivery / تأكيد التوصيل' button on outgoing delivery orders so warehouse staff can mark the sale order delivered (and notify the customer) straight from Inventory.">
                            <field name="uellow_inventory_confirm_btn"/>
                        </setting>
                        <setting string="Inventory Deliver+Settle Button"
                                 help="Show a one-click button that confirms delivery, creates &amp; posts the invoice, marks it PAID (settled via a reconciled bank entry) and locks the order.">
                            <field name="uellow_inventory_settle_btn"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
