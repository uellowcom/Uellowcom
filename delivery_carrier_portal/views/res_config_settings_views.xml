<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_delivery_portal" model="ir.ui.view">
        <field name="name">res.config.settings.form.delivery.portal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="🚚 Delivery Portal" name="delivery_carrier_portal">
                    <block title="Vendors">
                        <setting string="Vendor Shipping Methods"
                                 help="Vendors manage their own delivery methods at /my/vendor/shipping; offered only on carts made up entirely of their products.">
                            <field name="uellow_vendor_carriers_enabled"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
