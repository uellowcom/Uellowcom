<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_uellow_stock_notify_list" model="ir.ui.view">
        <field name="name">uellow.stock.notify.list</field>
        <field name="model">uellow.stock.notify</field>
        <field name="arch" type="xml">
            <list string="تنبيهات التوفّر">
                <field name="create_date" string="التاريخ"/>
                <field name="product_tmpl_id"/>
                <field name="product_id" optional="hide"/>
                <field name="contact"/>
                <field name="is_email"/>
                <field name="partner_id" optional="hide"/>
                <field name="website_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'notified'"
                       decoration-warning="state == 'new'"/>
            </list>
        </field>
    </record>
    <record id="view_uellow_stock_notify_form" model="ir.ui.view">
        <field name="name">uellow.stock.notify.form</field>
        <field name="model">uellow.stock.notify</field>
        <field name="arch" type="xml">
            <form string="تنبيه توفّر">
                <sheet>
                    <group>
                        <field name="product_tmpl_id"/>
                        <field name="product_id"/>
                        <field name="contact"/>
                        <field name="is_email"/>
                        <field name="partner_id"/>
                        <field name="state"/>
                        <field name="notified_date"/>
                        <field name="website_id"/>
                        <field name="lang"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_uellow_stock_notify" model="ir.actions.act_window">
        <field name="name">🔔 تنبيهات التوفّر</field>
        <field name="res_model">uellow.stock.notify</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">لا توجد طلبات تنبيه بعد</p>
            <p>يظهر هنا العملاء الذين طلبوا إعلامهم عند توفّر منتج نفدت كميته.</p>
        </field>
    </record>
    <menuitem id="menu_uellow_stock_notify" name="🔔 تنبيهات التوفّر"
              parent="website_sale.menu_ecommerce"
              action="action_uellow_stock_notify" sequence="90"/>
</odoo>
