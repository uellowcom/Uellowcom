<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="pura_page_tpl" name="HUAWEI Pura 90 Launch">
    <t t-call="website.layout">
      <t t-set="is_ar" t-value="(request.env.lang or '').startswith('ar')"/>
      <t t-set="additional_title">HUAWEI Pura 90 Pro Max &amp; Pro</t>

      <div class="pura" t-att-dir="'rtl' if is_ar else 'ltr'">
        <style>
          .pura{--bg:#F5FAFD;--card:#FFFFFF;--ink:#12212B;--muted:#5A6B78;--line:#E1ECF3;
            --orange:#F26A2E;--orange2:#D8500F;--sky:#22A7E0;--sky2:#1487BE;--soft-o:#FFF0E7;--soft-s:#E7F5FC;
            background:var(--bg);color:var(--ink);font-family:'Segoe UI',Tahoma,system-ui,sans-serif;overflow:hidden;line-height:1.55}
          .pura *{box-sizing:border-box}
          .pura .w{max-width:1180px;margin:0 auto;padding:0 22px}
          .pura .eyebrow{display:inline-block;font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;
            color:var(--orange2);background:var(--soft-o);border-radius:999px;padding:6px 13px;margin:0}
          .pura h2{font-size:clamp(24px,4vw,40px);font-weight:800;letter-spacing:-.02em;margin:14px 0 0;line-height:1.06}
          .pura .lede{color:var(--muted);font-size:clamp(15px,1.7vw,18px);max-width:64ch;margin:14px 0 0}
          .pura .sec{padding:clamp(46px,6vw,84px) 0}
          .pura .grad{background:linear-gradient(115deg,var(--orange),var(--sky));-webkit-background-clip:text;background-clip:text;color:transparent}
          .pura .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-weight:800;border-radius:12px;padding:13px 22px;font-size:14px;text-decoration:none;transition:.15s;border:1.5px solid transparent}
          .pura .btn.o{background:linear-gradient(120deg,var(--orange),var(--orange2));color:#fff;box-shadow:0 10px 24px -10px var(--orange)}
          .pura .btn.o:hover{filter:brightness(1.05);transform:translateY(-1px)}
          .pura .btn.s{background:var(--card);color:var(--sky2);border-color:var(--line)}
          .pura .btn.s:hover{border-color:var(--sky)}

          /* hero — fixed layout; only the phone image changes */
          .p-hero{position:relative;overflow:hidden;background:linear-gradient(120deg,var(--soft-o),var(--soft-s));
            width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw)}
          .p-hero .in{display:grid;grid-template-columns:1.05fr .95fr;gap:26px;align-items:center;padding:clamp(40px,6vw,78px) 0}
          .p-hero h1{font-size:clamp(34px,6vw,60px);font-weight:800;letter-spacing:-.025em;line-height:1;margin:14px 0 0;text-wrap:balance}
          .p-hero .lede{max-width:46ch}
          .p-hero .price-row{display:flex;gap:22px;flex-wrap:wrap;margin-top:22px}
          .p-hero .pr b{font-size:26px;font-weight:800}.p-hero .pr span{display:block;font-size:12.5px;color:var(--muted);font-weight:600}
          .p-hero .cta-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
          .ph-shot{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:clamp(320px,46vh,520px)}
          .ph-shot::before{content:"";position:absolute;inset:4% 10% auto 10%;height:70%;border-radius:50%;
            background:radial-gradient(circle,rgba(242,106,46,.20),rgba(34,167,224,.15) 52%,transparent 72%);filter:blur(8px)}
          .ph-shot img{position:relative;max-width:100%;max-height:clamp(300px,46vh,520px);object-fit:contain;filter:drop-shadow(0 34px 50px rgba(20,40,60,.30));transition:opacity .5s ease}
          .ph-shot img.fade{opacity:0}
          .ph-dots{position:relative;display:flex;gap:8px;justify-content:center;margin-top:22px;z-index:2}
          .ph-dots button{width:9px;height:9px;border-radius:50%;background:rgba(20,40,60,.22);border:0;padding:0;cursor:pointer;transition:.2s}
          .ph-dots button[aria-current="true"]{width:26px;border-radius:5px;background:var(--orange)}

          /* stat band */
          .p-band{background:linear-gradient(115deg,var(--soft-o),var(--soft-s));border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
          .p-band .g{display:grid;grid-template-columns:repeat(4,1fr)}
          .p-stat{padding:30px 16px;text-align:center;border-inline-start:1px solid rgba(20,40,60,.08)}
          .p-stat:first-child{border-inline-start:0}
          .p-stat b{display:block;font-size:clamp(26px,3.6vw,42px);font-weight:800;letter-spacing:-.02em}
          .p-stat span{display:block;margin-top:5px;font-size:12px;color:var(--muted);font-weight:600}

          /* product duo */
          .duo{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:30px}
          .pc{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:22px;display:flex;flex-direction:column;box-shadow:0 20px 40px -30px rgba(20,50,80,.4)}
          .pc .top{position:relative;border-radius:16px;background:linear-gradient(160deg,var(--soft-o),var(--soft-s));padding:16px;text-align:center}
          .pc .top .bdg{position:absolute;inset-inline-start:14px;top:14px;background:linear-gradient(120deg,var(--orange),var(--orange2));color:#fff;font-size:10.5px;font-weight:800;padding:5px 11px;border-radius:999px}
          .pc img{max-width:100%;aspect-ratio:1;object-fit:contain}
          .pc h3{font-size:20px;font-weight:800;margin:16px 0 0}
          .pc .price{font-size:22px;font-weight:800;margin-top:4px}.pc .price small{font-size:13px;color:var(--muted);font-weight:600}
          .pc .cols{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
          .pc .col{display:inline-flex;align-items:center;gap:7px;font-size:12px;color:var(--muted);font-weight:600;border:1px solid var(--line);border-radius:999px;padding:4px 10px}
          .pc .dot{width:13px;height:13px;border-radius:50%;box-shadow:inset 0 1px 2px rgba(255,255,255,.6),0 0 0 1px rgba(0,0,0,.05)}
          .pc .foot{margin-top:auto;padding-top:18px}
          .pc .taly{font-size:12px;color:var(--orange2);font-weight:700;margin-top:9px;text-align:center}

          /* feature bands */
          .feat{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center;margin-top:30px}
          .feat.rev .txt{order:2}
          .feat .media{border-radius:22px;overflow:hidden;border:1px solid var(--line);background:linear-gradient(160deg,var(--soft-o),var(--soft-s))}
          .feat .media img{width:100%;display:block;object-fit:cover;aspect-ratio:4/3}
          .feat h3{font-size:clamp(20px,2.6vw,30px);font-weight:800;letter-spacing:-.02em;margin:12px 0 0}
          .feat p{color:var(--muted);margin:12px 0 0;font-size:15px}
          .mini{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
          .mini span{background:var(--card);border:1px solid var(--line);border-radius:999px;padding:7px 13px;font-size:12.5px;font-weight:700}
          .mini span b{color:var(--orange2)}

          /* gallery */
          .gal{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:1fr;gap:12px;margin-top:30px}
          .gal a{display:block;border-radius:16px;overflow:hidden;border:1px solid var(--line);background:#fff;aspect-ratio:1}
          .gal a.big{grid-column:span 2;grid-row:span 2;aspect-ratio:auto}
          .gal img{width:100%;height:100%;object-fit:cover;transition:transform .4s}
          .gal a:hover img{transform:scale(1.05)}

          /* color chips */
          .colors{display:grid;grid-template-columns:1fr 1fr;gap:26px;align-items:center;margin-top:26px}
          .colors .media{border-radius:22px;overflow:hidden;border:1px solid var(--line)}
          .colors .media img{width:100%;display:block;aspect-ratio:4/3;object-fit:cover}
          .cc-row{display:flex;gap:14px;flex-wrap:wrap;margin-top:8px}
          .cc{text-align:center}.cc .sw{width:52px;height:52px;border-radius:50%;margin:0 auto;box-shadow:inset 0 2px 4px rgba(255,255,255,.5),0 6px 14px -6px rgba(0,0,0,.3)}
          .cc small{display:block;margin-top:8px;font-size:12px;font-weight:700;color:var(--muted)}

          /* specs */
          .spec2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:30px}
          .sg{background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden}
          .sg h3{margin:0;padding:14px 18px;font-size:14px;font-weight:800;color:#fff;background:linear-gradient(120deg,var(--orange),var(--sky))}
          .sr{display:grid;grid-template-columns:.85fr 1.15fr;gap:10px;padding:10px 18px;border-top:1px solid var(--line);font-size:13.5px}
          .sr:first-of-type{border-top:0}.sr .sl{color:var(--muted);font-weight:600}.sr .sv{font-weight:600}

          /* compare */
          .cmp{margin-top:30px;border:1px solid var(--line);border-radius:20px;overflow:hidden;background:var(--card)}
          .cr{display:grid;grid-template-columns:1.1fr 1fr 1fr;border-top:1px solid var(--line)}
          .cr:first-child{border-top:0}.cr>div{padding:14px 18px;font-size:13.5px}
          .cr .rl{color:var(--muted);font-weight:700}.cr .cv{border-inline-start:1px solid var(--line);font-weight:600}
          .cr.head>div{background:var(--soft-s);font-weight:800}.cr.head .mx{color:var(--orange2)}

          /* taly */
          .taly{background:linear-gradient(160deg,var(--soft-o),var(--soft-s));border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
          .taly .g{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:start}
          .steps{list-style:none;margin:20px 0 0;padding:0;display:flex;flex-direction:column;gap:12px}
          .steps li{display:flex;gap:12px;align-items:flex-start}
          .sn{flex:none;width:26px;height:26px;border-radius:50%;background:linear-gradient(120deg,var(--orange),var(--orange2));color:#fff;font-weight:800;font-size:13px;display:grid;place-items:center}
          .steps b{font-weight:800}.steps p{margin:2px 0 0;color:var(--muted);font-size:13px}
          .badges{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
          .badges span{border:1px solid var(--line);background:var(--card);border-radius:999px;padding:6px 12px;font-size:12px;font-weight:700;color:var(--muted)}
          .split{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
          .pay{flex:1 1 0;min-width:100px;border:1px solid var(--line);border-radius:14px;padding:14px;background:var(--card)}
          .pay.first{background:linear-gradient(150deg,var(--soft-o),var(--card))}
          .pay .n{font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--orange2)}
          .pay .amt{font-size:20px;font-weight:800;margin-top:4px}.pay .when{font-size:11.5px;color:var(--muted);margin-top:2px}
          .stores{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px}
          .store{display:inline-flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:13px;padding:10px 15px;background:var(--card);text-decoration:none;color:var(--ink)}
          .store:hover{border-color:var(--orange)}
          .store svg{width:22px;height:22px}.store .tx{display:flex;flex-direction:column;line-height:1.15}
          .store .tx small{font-size:10px;color:var(--muted)}.store .tx b{font-size:13.5px}
          .note{margin-top:14px;font-size:11.5px;color:var(--muted)}

          .p-sticky{position:fixed;inset-inline:0;bottom:0;z-index:1030;background:rgba(255,255,255,.92);backdrop-filter:blur(12px);border-top:1px solid var(--line);
            display:flex;gap:10px;align-items:center;justify-content:center;padding:10px 16px;flex-wrap:wrap;box-shadow:0 -8px 24px -16px rgba(20,50,80,.4)}
          .p-sticky .lbl{font-weight:800;font-size:13px;margin-inline-end:6px}

          @media (max-width:900px){
            .p-hero .in,.duo,.feat,.colors,.spec2,.taly .g{grid-template-columns:1fr}
            .p-hero .cta-row{justify-content:flex-start}
            .feat.rev .txt{order:0}
            .p-band .g{grid-template-columns:repeat(2,1fr)}.p-stat:nth-child(3){border-inline-start:0}
            .gal{grid-template-columns:repeat(2,1fr)}.gal a.big{grid-column:span 2;grid-row:auto;aspect-ratio:16/10}
            .cr,.cr.head{grid-template-columns:1fr}.cr .cv{border-inline-start:0;border-top:1px solid var(--line)}.cr .rl{background:var(--soft-s)}
          }
        </style>

        <!-- HERO (fixed; only the phone image changes) -->
        <section class="p-hero"><div class="w"><div class="in" t-att-dir="'rtl' if is_ar else 'ltr'">
          <div>
            <p class="eyebrow"><t t-if="is_ar">لحظتك الآن · حصريًا على Uellow</t><t t-else="">Now is Your Moment · exclusively at Uellow</t></p>
            <h1><t t-if="is_ar">هواوي <span class="grad">بيورا 90</span> برو ماكس وبرو</t><t t-else="">HUAWEI <span class="grad">Pura 90</span> Pro Max &amp; Pro</t></h1>
            <p class="lede"><t t-if="is_ar">تصوير احترافي بمستشعر تليفوتو 200 ميجابكسل وزوم 100×، شاشة OLED 120Hz، بطارية 6000 مللي أمبير وشحن فائق حتى 100 واط. اشترِ الآن أو قسّط على 4 دفعات مع Taly.</t>
              <t t-else="">Pro-grade photography with a 200 MP telephoto and 100× zoom, a 120 Hz OLED display, 6000 mAh battery and up to 100 W SuperCharge. Buy now, or split into 4 with Taly.</t></p>
            <div class="price-row">
              <div class="pr"><b>345.000 <small style="font-size:13px;color:var(--muted)"><t t-if="is_ar">د.ك</t><t t-else="">KWD</t></small></b><span>Pura 90 Pro Max</span></div>
              <div class="pr"><b>245.000 <small style="font-size:13px;color:var(--muted)"><t t-if="is_ar">د.ك</t><t t-else="">KWD</t></small></b><span>Pura 90 Pro</span></div>
            </div>
            <div class="cta-row">
              <a class="btn o" href="/shop/huawei-pura-90-pro-max-dual-sim-16gb-512gb-phone-16673"><t t-if="is_ar">اشترِ برو ماكس</t><t t-else="">Buy Pro Max</t></a>
              <a class="btn s" href="/shop/huawei-pura-90-pro-256gb-phone-16674"><t t-if="is_ar">اشترِ برو</t><t t-else="">Buy Pro</t></a>
            </div>
          </div>
          <div class="ph-shot">
            <img id="phImg" src="/uellow_pura_launch/static/src/img/pura-1.png" alt="HUAWEI Pura 90 Pro Max" loading="eager" width="520" height="520"/>
            <div class="ph-dots" id="phDots"></div>
          </div>
        </div></div></section>

        <!-- STAT BAND -->
        <section class="p-band"><div class="w g">
          <div class="p-stat"><b class="grad">200MP</b><span><t t-if="is_ar">مستشعر تليفوتو</t><t t-else="">Telephoto sensor</t></span></div>
          <div class="p-stat"><b class="grad">100×</b><span><t t-if="is_ar">زوم رقمي</t><t t-else="">Digital zoom</t></span></div>
          <div class="p-stat"><b class="grad">100W</b><span><t t-if="is_ar">شحن فائق</t><t t-else="">SuperCharge</t></span></div>
          <div class="p-stat"><b class="grad">6.9″</b><span><t t-if="is_ar">OLED 120Hz</t><t t-else="">OLED 120Hz</t></span></div>
        </div></section>

        <!-- PRODUCT DUO -->
        <section class="sec"><div class="w">
          <p class="eyebrow"><t t-if="is_ar">اختر جهازك</t><t t-else="">Choose your device</t></p>
          <h2><t t-if="is_ar">هاتفان. طاقة واحدة استثنائية.</t><t t-else="">Two phones. One extraordinary power.</t></h2>
          <div class="duo">
            <div class="pc">
              <div class="top"><span class="bdg"><t t-if="is_ar">الأقوى</t><t t-else="">FLAGSHIP</t></span>
                <img src="/uellow_pura_launch/static/src/img/pura-1.png" alt="HUAWEI Pura 90 Pro Max" loading="lazy" width="440" height="440"/></div>
              <h3>HUAWEI Pura 90 Pro Max</h3>
              <div class="price">345.000 <small><t t-if="is_ar">د.ك</t><t t-else="">KWD</t></small></div>
              <div class="cols">
                <span class="col"><span class="dot" style="background:#2A2A2C"></span><t t-if="is_ar">أسود</t><t t-else="">Black</t></span>
                <span class="col"><span class="dot" style="background:linear-gradient(150deg,#F0D3AC,#C99A5E)"></span><t t-if="is_ar">ذهبي</t><t t-else="">Gold</t></span>
                <span class="col"><span class="dot" style="background:linear-gradient(150deg,#F0975C,#C25A24)"></span><t t-if="is_ar">برتقالي</t><t t-else="">Orange</t></span>
              </div>
              <div class="foot"><a class="btn o" style="width:100%" href="/shop/huawei-pura-90-pro-max-dual-sim-16gb-512gb-phone-16673"><t t-if="is_ar">اشترِ الآن</t><t t-else="">Buy now</t></a>
                <div class="taly"><t t-if="is_ar">أو 4 × 86.250 د.ك مع Taly</t><t t-else="">or 4× 86.250 KWD with Taly</t></div></div>
            </div>
            <div class="pc">
              <div class="top"><span class="bdg" style="background:linear-gradient(120deg,var(--sky),var(--sky2))">PRO</span>
                <img src="/web/image/product.template/16674/image_1920" alt="HUAWEI Pura 90 Pro" loading="lazy" width="400" height="400"/></div>
              <h3>HUAWEI Pura 90 Pro</h3>
              <div class="price">245.000 <small><t t-if="is_ar">د.ك</t><t t-else="">KWD</t></small></div>
              <div class="cols">
                <span class="col"><span class="dot" style="background:#2A2A2C"></span><t t-if="is_ar">أسود</t><t t-else="">Black</t></span>
                <span class="col"><span class="dot" style="background:linear-gradient(150deg,#F0975C,#C25A24)"></span><t t-if="is_ar">برتقالي</t><t t-else="">Orange</t></span>
                <span class="col"><span class="dot" style="background:linear-gradient(150deg,#EEB0AB,#C56A63)"></span><t t-if="is_ar">جوافة</t><t t-else="">Guava</t></span>
              </div>
              <div class="foot"><a class="btn o" style="width:100%" href="/shop/huawei-pura-90-pro-256gb-phone-16674"><t t-if="is_ar">اشترِ الآن</t><t t-else="">Buy now</t></a>
                <div class="taly"><t t-if="is_ar">أو 4 × 61.250 د.ك مع Taly</t><t t-else="">or 4× 61.250 KWD with Taly</t></div></div>
            </div>
          </div>
        </div></section>

        <!-- CAMERA FEATURE -->
        <section class="sec" style="padding-top:0"><div class="w">
          <div class="feat">
            <div class="txt">
              <p class="eyebrow"><t t-if="is_ar">الكاميرا</t><t t-else="">The camera</t></p>
              <h3><t t-if="is_ar">تصوير إلى أقصى حدّ.</t><t t-else="">Photography to the MAX.</t></h3>
              <p><t t-if="is_ar">مستشعر تليفوتو فائق 200 ميجابكسل بفتحة F2.6 وزوم 100×، مع رئيسية 50 ميجابكسل بفتحة متغيّرة F1.4–F4.0 وعدسة فائقة الاتساع — وكاميرا الألوان الحقيقية 2.0 مع ذكاء اصطناعي لتكوين اللقطة وإزالة الوهج.</t>
                <t t-else="">A 200 MP ultra-large telephoto at F2.6 with 100× zoom, a 50 MP main with variable F1.4–F4.0 aperture and an ultra-wide — with True-to-Colour Camera 2.0 and AI composition and de-glare.</t></p>
              <div class="mini"><span><b>200</b>MP</span><span><b>100×</b> zoom</span><span>F1.4–F4.0</span><span>OIS</span><span><t t-if="is_ar">فيديو</t><t t-else="">Video</t> 4K</span></div>
            </div>
            <div class="media"><img src="/web/image/product.image/56168/image_1024/huawei-pura-90s-pro-max-3.webp" alt="HUAWEI Pura 90 Pro Max camera" loading="lazy"/></div>
          </div>
          <div class="feat rev" style="margin-top:36px">
            <div class="txt">
              <p class="eyebrow"><t t-if="is_ar">التصميم والمتانة</t><t t-else="">Design &amp; durability</t></p>
              <h3><t t-if="is_ar">زجاج أقوى. أيام أطول.</t><t t-else="">Tougher glass. Longer days.</t></h3>
              <p><t t-if="is_ar">زجاج Kunlun المضاد للانعكاس يقلّل الوهج 70% ويرفع مقاومة الخدش 16×. بطارية 6000 مللي أمبير مع شحن سلكي 100 واط ولاسلكي 80 واط، ومقاومة ماء وغبار IP68/IP69.</t>
                <t t-else="">Anti-reflection Kunlun Glass cuts glare by 70% and boosts scratch resistance 16×. A 6000 mAh battery with 100 W wired and 80 W wireless charging, and IP68/IP69 water &amp; dust resistance.</t></p>
              <div class="mini"><span><b>6000</b>mAh</span><span><b>100W</b> <t t-if="is_ar">سلكي</t><t t-else="">wired</t></span><span><b>80W</b> <t t-if="is_ar">لاسلكي</t><t t-else="">wireless</t></span><span>IP68/IP69</span><span>Kunlun Glass</span></div>
            </div>
            <div class="media"><img src="/uellow_pura_launch/static/src/img/pura-glass.webp" alt="HUAWEI Pura 90 Pro Max Kunlun Glass" loading="lazy"/></div>
          </div>
        </div></section>

        <!-- COLORS -->
        <section class="sec" style="padding-top:0"><div class="w">
          <p class="eyebrow"><t t-if="is_ar">الألوان</t><t t-else="">Colours</t></p>
