            img.classList.add('fade');
            setTimeout(function(){ img.src=srcs[i]; img.classList.remove('fade'); }, 260);
            for(var k=0;k!==srcs.length;k++){ de[k].setAttribute('aria-current', k===i?'true':'false'); }
