<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="pura_page_tpl" name="HUAWEI Pura 90 Launch">
    <t t-call="website.layout">
      <t t-set="is_ar" t-value="(request.env.lang or '').startswith('ar')"/>
      <t t-set="additional_title">HUAWEI Pura 90 Pro Max &amp; Pro</t>

      <div class="pura" t-att-dir="'rtl' if is_ar else 'ltr'">
        <style>
          .pura{--ink:#0C0A07;--panel:#15110B;--card:#191309;--line:rgba(240,200,140,.14);--muted:#A99B82;--text:#F3ECDD;--gold:#E8B76A;--gold2:#C98B39;--ocean:#E9743B;
            background:var(--ink);color:var(--text);font-family:'Segoe UI',Tahoma,system-ui,sans-serif;overflow:hidden}
          .pura *{box-sizing:border-box}
          .pura .w{max-width:1160px;margin:0 auto;padding:0 22px}
          .pura .eyebrow{font-size:12px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin:0}
          .pura h2{font-size:clamp(24px,4vw,40px);font-weight:800;letter-spacing:-.02em;margin:12px 0 0;line-height:1.05}
          .pura .lede{color:var(--muted);font-size:clamp(15px,1.7vw,18px);max-width:62ch;margin:14px 0 0}
          .pura .sec{padding:clamp(44px,6vw,80px) 0}
          .pura-hero{position:relative}
          .pura-hero::before{content:"";position:absolute;inset:-20% -10% auto auto;width:70%;height:120%;
            background:radial-gradient(50% 50% at 70% 30%,rgba(232,183,106,.34),transparent 70%),radial-gradient(40% 40% at 85% 60%,rgba(233,116,59,.24),transparent 70%);filter:blur(30px);opacity:.7;pointer-events:none}
          .pura-hero .w{position:relative}
          .pura-hero h1{font-size:clamp(34px,6vw,66px);font-weight:800;letter-spacing:-.02em;line-height:1;margin:12px 0 0;text-wrap:balance}
          .pura-cards{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:36px}
          .pcard{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:24px;display:flex;flex-direction:column;position:relative;overflow:hidden}
          .pcard.max{background:linear-gradient(160deg,rgba(232,183,106,.13),var(--card))}
          .pcard .badge{position:absolute;inset-inline-end:18px;top:18px;background:linear-gradient(120deg,var(--gold),var(--gold2));color:#1a1206;font-size:10.5px;font-weight:800;padding:5px 11px;border-radius:999px}
          .pcard img{width:100%;aspect-ratio:1;object-fit:contain;border-radius:14px;background:#0c0b09}
          .pcard h3{font-size:20px;font-weight:800;margin:16px 0 0;letter-spacing:-.01em}
          .pcard .price{font-size:24px;font-weight:800;color:var(--gold);margin-top:6px}
          .pcard .price small{font-size:13px;color:var(--muted);font-weight:600}
          .pcard .cols{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
          .pcard .col{display:inline-flex;align-items:center;gap:7px;font-size:12px;color:var(--muted);font-weight:600;border:1px solid var(--line);border-radius:999px;padding:4px 10px}
          .pcard .dot{width:13px;height:13px;border-radius:50%;box-shadow:inset 0 1px 3px rgba(255,255,255,.35),inset 0 -2px 3px rgba(0,0,0,.4)}
          .pura .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-weight:800;border-radius:12px;padding:13px 20px;font-size:14px;text-decoration:none;transition:.15s}
          .pura .btn.gold{background:linear-gradient(120deg,var(--gold),var(--gold2));color:#1a1206}
          .pura .btn.gold:hover{filter:brightness(1.07)}
          .pura .btn.ghost{border:1px solid var(--line);color:var(--text)}
          .pcard .foot{margin-top:auto;padding-top:18px}
          .pcard .taly{font-size:12px;color:var(--gold);font-weight:700;margin-top:9px;text-align:center}
          .band{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--panel)}
          .band .g{display:grid;grid-template-columns:repeat(4,1fr)}
          .stat{padding:30px 16px;text-align:center;border-inline-start:1px solid var(--line)}
          .stat:first-child{border-inline-start:0}
          .stat b{display:block;font-size:clamp(26px,3.6vw,44px);font-weight:800;letter-spacing:-.02em;background:linear-gradient(120deg,var(--gold),var(--ocean));-webkit-background-clip:text;background-clip:text;color:transparent}
          .stat span{display:block;margin-top:6px;font-size:12px;color:var(--muted);font-weight:600}
          .cards3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:34px}
          .fcard{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px}
          .fcard h3{font-size:16px;font-weight:800;margin:0 0 8px}
          .fcard p{color:var(--muted);font-size:13.5px;margin:0}
          .cam-media{margin-top:26px;border-radius:20px;overflow:hidden;border:1px solid var(--line)}
          .cam-media img{width:100%;display:block;object-fit:cover;max-height:420px}
          .spec2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:30px}
          .sgroup{background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden}
          .sgroup h3{margin:0;padding:14px 18px;font-size:14px;font-weight:800;color:var(--gold);border-bottom:1px solid var(--line);background:var(--panel)}
          .srow{display:grid;grid-template-columns:.85fr 1.15fr;gap:10px;padding:10px 18px;border-top:1px solid var(--line);font-size:13.5px}
          .srow:first-of-type{border-top:0}.srow .sl{color:var(--muted);font-weight:600}.srow .sv{font-weight:600}
          .compare{margin-top:30px;border:1px solid var(--line);border-radius:20px;overflow:hidden;background:var(--card)}
          .crow{display:grid;grid-template-columns:1.1fr 1fr 1fr;border-top:1px solid var(--line)}
          .crow:first-child{border-top:0}.crow>div{padding:14px 18px;font-size:13.5px}
          .crow .rl{color:var(--muted);font-weight:700}.crow .cv{border-inline-start:1px solid var(--line);font-weight:600}
          .crow.head>div{background:var(--panel);font-weight:800}.crow.head .cv.mx{color:var(--gold)}
          .taly-sec{background:linear-gradient(150deg,rgba(232,183,106,.1),var(--panel));border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
          .taly-grid{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:start}
          .steps{list-style:none;margin:22px 0 0;padding:0;display:flex;flex-direction:column;gap:12px}
          .steps li{display:flex;gap:12px;align-items:flex-start}
          .sn{flex:none;width:26px;height:26px;border-radius:50%;background:linear-gradient(120deg,var(--gold),var(--gold2));color:#1a1206;font-weight:800;font-size:13px;display:grid;place-items:center}
          .steps b{font-weight:800}.steps p{margin:2px 0 0;color:var(--muted);font-size:13px}
          .badges{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}
          .badges span{border:1px solid var(--line);border-radius:999px;padding:6px 12px;font-size:12px;font-weight:700;color:var(--muted)}
          .split{display:flex;gap:10px;flex-wrap:wrap}
          .pay{flex:1 1 0;min-width:100px;border:1px solid var(--line);border-radius:14px;padding:14px;background:var(--card)}
          .pay.first{background:linear-gradient(150deg,rgba(232,183,106,.18),var(--card))}
          .pay .n{font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--gold)}
          .pay .amt{font-size:20px;font-weight:800;margin-top:4px}.pay .when{font-size:11.5px;color:var(--muted);margin-top:2px}
          .stores{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}
          .store{display:inline-flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:13px;padding:10px 15px;background:var(--card);text-decoration:none;color:var(--text)}
          .store:hover{border-color:var(--gold)}
          .store svg{width:22px;height:22px}.store .tx{display:flex;flex-direction:column;line-height:1.15}
          .store .tx small{font-size:10px;color:var(--muted)}.store .tx b{font-size:13.5px}
          .note{margin-top:14px;font-size:11.5px;color:var(--muted);opacity:.9}
          .pura-sticky{position:fixed;inset-inline:0;bottom:0;z-index:1030;background:color-mix(in srgb,var(--ink) 92%,transparent);backdrop-filter:blur(12px);border-top:1px solid var(--line);
            display:flex;gap:10px;align-items:center;justify-content:center;padding:10px 16px;flex-wrap:wrap}
          .pura-sticky .lbl{font-weight:800;font-size:13px;color:var(--text);margin-inline-end:6px}
          @media (max-width:900px){.pura-cards,.spec2,.taly-grid{grid-template-columns:1fr}.band .g{grid-template-columns:repeat(2,1fr)}.stat:nth-child(3){border-inline-start:0}.cards3{grid-template-columns:1fr}
            .crow,.crow.head{grid-template-columns:1fr}.crow .cv{border-inline-start:0;border-top:1px solid var(--line)}.crow .rl{background:var(--panel)}}
        </style>

        <!-- HERO -->
        <section class="pura-hero sec"><div class="w">
          <p class="eyebrow"><t t-if="is_ar">لحظتك الآن · حصريًا على Uellow</t><t t-else="">Now is Your Moment · exclusively at Uellow</t></p>
          <h1><t t-if="is_ar">هواوي بورا 90 برو ماكس وبرو</t><t t-else="">HUAWEI Pura 90 Pro Max &amp; Pro</t></h1>
          <p class="lede"><t t-if="is_ar">تصوير احترافي بمستشعر تليفوتو فائق 200 ميجابكسل وزوم 100×، بطارية 6000 مللي أمبير، وشحن فائق حتى 100 واط — بزجاج Kunlun المضاد للانعكاس. متوفّر الآن للشراء أو التقسيط على 4 دفعات مع Taly.</t>
            <t t-else="">Pro-grade photography with a 200 MP ultra-large telephoto sensor and 100× zoom, a 6000 mAh battery and up to 100 W SuperCharge — behind anti-reflection Kunlun Glass. Buy now, or split into 4 with Taly.</t></p>

          <div class="pura-cards">
            <div class="pcard max">
              <span class="badge"><t t-if="is_ar">الأقوى</t><t t-else="">FLAGSHIP</t></span>
              <img src="/web/image/product.template/16673/image_1920" alt="HUAWEI Pura 90 Pro Max" loading="eager" width="600" height="600"/>
              <h3>HUAWEI Pura 90 Pro Max</h3>
              <div class="price">345.000 <small><t t-if="is_ar">د.ك</t><t t-else="">KWD</t></small></div>
              <div class="cols">
                <span class="col"><span class="dot" style="background:linear-gradient(150deg,#43423F,#0C0B0A)"></span><t t-if="is_ar">أسود</t><t t-else="">Black</t></span>
                <span class="col"><span class="dot" style="background:linear-gradient(150deg,#F0D3AC,#A9793E)"></span><t t-if="is_ar">ذهبي</t><t t-else="">Gold</t></span>
                <span class="col"><span class="dot" style="background:linear-gradient(150deg,#F0975C,#8F3D14)"></span><t t-if="is_ar">برتقالي</t><t t-else="">Orange</t></span>
              </div>
              <div class="foot">
                <a class="btn gold" style="width:100%" href="/shop/huawei-pura-90-pro-max-dual-sim-16gb-512gb-phone-16673"><t t-if="is_ar">اشترِ الآن</t><t t-else="">Buy now</t></a>
                <div class="taly"><t t-if="is_ar">أو 4 دفعات × 86.250 د.ك مع Taly</t><t t-else="">or 4× 86.250 KWD with Taly</t></div>
              </div>
            </div>
            <div class="pcard">
              <span class="badge">PRO</span>
              <img src="/web/image/product.template/16674/image_1920" alt="HUAWEI Pura 90 Pro" loading="eager" width="600" height="600"/>
              <h3>HUAWEI Pura 90 Pro</h3>
              <div class="price">245.000 <small><t t-if="is_ar">د.ك</t><t t-else="">KWD</t></small></div>
              <div class="cols">
                <span class="col"><span class="dot" style="background:linear-gradient(150deg,#43423F,#0C0B0A)"></span><t t-if="is_ar">أسود</t><t t-else="">Black</t></span>
                <span class="col"><span class="dot" style="background:linear-gradient(150deg,#F0975C,#8F3D14)"></span><t t-if="is_ar">برتقالي</t><t t-else="">Orange</t></span>
                <span class="col"><span class="dot" style="background:linear-gradient(150deg,#EEB0AB,#9C463F)"></span><t t-if="is_ar">جوافة</t><t t-else="">Guava</t></span>
              </div>
              <div class="foot">
                <a class="btn gold" style="width:100%" href="/shop/huawei-pura-90-pro-256gb-phone-16674"><t t-if="is_ar">اشترِ الآن</t><t t-else="">Buy now</t></a>
                <div class="taly"><t t-if="is_ar">أو 4 دفعات × 61.250 د.ك مع Taly</t><t t-else="">or 4× 61.250 KWD with Taly</t></div>
              </div>
            </div>
          </div>
        </div></section>

        <!-- STATS BAND (Pro Max) -->
        <section class="band"><div class="w g">
          <div class="stat"><b>200<span style="font-size:.5em">MP</span></b><span><t t-if="is_ar">مستشعر تليفوتو</t><t t-else="">Telephoto sensor</t></span></div>
          <div class="stat"><b>100×</b><span><t t-if="is_ar">زوم رقمي</t><t t-else="">Digital zoom</t></span></div>
          <div class="stat"><b>100<span style="font-size:.5em">W</span></b><span><t t-if="is_ar">شحن فائق</t><t t-else="">SuperCharge</t></span></div>
          <div class="stat"><b>6.9<span style="font-size:.5em">″</span></b><span><t t-if="is_ar">شاشة OLED 120Hz</t><t t-else="">OLED 120Hz display</t></span></div>
        </div></section>

        <!-- CAMERA -->
        <section class="sec"><div class="w">
          <p class="eyebrow"><t t-if="is_ar">الكاميرا</t><t t-else="">The camera</t></p>
          <h2><t t-if="is_ar">عينٌ تُبصر ساعة الذهب.</t><t t-else="">An eye for the golden hour.</t></h2>
          <p class="lede"><t t-if="is_ar">مستشعر رئيسي 50 ميجابكسل فائق الإضاءة بفتحة متغيّرة F1.4–F4.0، وعدسة فائقة الاتساع، وتليفوتو يصل إلى 100× — مع كاميرا الألوان الحقيقية 2.0 وذكاء اصطناعي يبقي كل لقطة نقية ومتوازنة.</t>
            <t t-else="">A 50 MP Ultra-Lighting main sensor with variable F1.4–F4.0 aperture, an ultra-wide, and a telephoto reaching 100× — with True-to-Colour Camera 2.0 and AI that keeps every frame clean and perfectly composed.</t></p>
          <div class="cards3">
            <div class="fcard"><h3><t t-if="is_ar">رئيسية 50 ميجابكسل + فائقة الاتساع</t><t t-else="">50 MP main + ultra-wide</t></h3><p><t t-if="is_ar">فتحة F1.4–F4.0 مع مثبّت OIS، وعدسة فائقة الاتساع 40 ميجابكسل (12.5 في برو).</t><t t-else="">F1.4–F4.0 with OIS, plus a 40 MP ultra-wide (12.5 MP on Pro).</t></p></div>
            <div class="fcard"><h3><t t-if="is_ar">تليفوتو حتى 100×</t><t t-else="">Telephoto up to 100×</t></h3><p><t t-if="is_ar">برو ماكس: مستشعر فائق 200 ميجابكسل F2.6، 4× بصري / 100× رقمي. برو: ماكرو تليفوتو 50 ميجابكسل يركّز من 5 سم.</t><t t-else="">Pro Max: 200 MP ultra-large sensor (F2.6), 4× optical / 100× digital. Pro: 50 MP macro telephoto from 5 cm.</t></p></div>
            <div class="fcard"><h3><t t-if="is_ar">ذكاء التكوين وإزالة الوهج</t><t t-else="">AI composition &amp; de-glare</t></h3><p><t t-if="is_ar">تأطير ذكي، وإزالة الوهج، ومعالجة الحركة — لقطات احترافية بلا مجهود.</t><t t-else="">Smart framing, glare removal and motion cleanup — pro shots, effortlessly.</t></p></div>
          </div>
          <div class="cam-media"><img src="/web/image/product.image/56168/image_1024/huawei-pura-90s-pro-max-3.webp" alt="HUAWEI Pura 90 Pro Max camera" loading="lazy"/></div>
        </div></section>

        <!-- FULL SPECS -->
        <section class="sec" style="padding-top:0"><div class="w">
          <p class="eyebrow"><t t-if="is_ar">المواصفات الكاملة</t><t t-else="">Full specifications</t></p>
          <h2><t t-if="is_ar">كل التفاصيل، بوضوح.</t><t t-else="">Every detail, spelled out.</t></h2>
          <div class="spec2">
            <div class="sgroup"><h3>HUAWEI Pura 90 Pro Max</h3>
              <div class="srow"><span class="sl"><t t-if="is_ar">الشاشة</t><t t-else="">Display</t></span><span class="sv">6.9″ LTPO OLED · 2880×1308 · 460ppi · 1–120Hz</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">الأبعاد/الوزن</t><t t-else="">Size / weight</t></span><span class="sv">164 × 77.1 × 8.1 mm · ≈230.5 g</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">الكاميرا الخلفية</t><t t-else="">Rear camera</t></span><span class="sv">50MP (F1.4–4.0,OIS) + 40MP UW (F2.2) + 200MP tele (F2.6,OIS)</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">الزوم</t><t t-else="">Zoom</t></span><span class="sv">4× optical · 100× digital</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">الأمامية</t><t t-else="">Front</t></span><span class="sv">13 MP · F2.0 · AF</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">البطارية/الشحن</t><t t-else="">Battery / charge</t></span><span class="sv">6000 mAh · 100W wired · 80W wireless</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">الذاكرة</t><t t-else="">Memory</t></span><span class="sv">12GB RAM · 256/512GB</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">المتانة/الزجاج</t><t t-else="">Durability</t></span><span class="sv">IP68/IP69 · Anti-reflection Kunlun Glass</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">النظام/الاتصال</t><t t-else="">OS / connectivity</t></span><span class="sv">EMUI 16 · 5G · Wi-Fi 7 · BT 6.0 · NFC · USB-C</span></div>
            </div>
            <div class="sgroup"><h3>HUAWEI Pura 90 Pro</h3>
              <div class="srow"><span class="sl"><t t-if="is_ar">الشاشة</t><t t-else="">Display</t></span><span class="sv">6.6″ LTPO OLED · 2760×1256 · 460ppi · 1–120Hz</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">الأبعاد/الوزن</t><t t-else="">Size / weight</t></span><span class="sv">157.8 × 74.5 × 8.2 mm · ≈213.5 g</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">الكاميرا الخلفية</t><t t-else="">Rear camera</t></span><span class="sv">50MP (F1.4–4.0,OIS) + 12.5MP UW (F2.2) + 50MP macro tele (F2.1,OIS,5cm)</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">الزوم</t><t t-else="">Zoom</t></span><span class="sv">4× optical · 100× digital</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">الأمامية</t><t t-else="">Front</t></span><span class="sv">13 MP · F2.0 · AF</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">البطارية/الشحن</t><t t-else="">Battery / charge</t></span><span class="sv">6000 mAh · 66W wired · 50W wireless</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">الذاكرة</t><t t-else="">Memory</t></span><span class="sv">12GB RAM · 256/512GB</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">المتانة/الزجاج</t><t t-else="">Durability</t></span><span class="sv">IP68/IP69 · Kunlun Glass</span></div>
              <div class="srow"><span class="sl"><t t-if="is_ar">النظام/الاتصال</t><t t-else="">OS / connectivity</t></span><span class="sv">EMUI 16 · 5G · Wi-Fi 7 · BT 6.0 · NFC · USB-C</span></div>
            </div>
          </div>
        </div></section>

        <!-- COMPARE -->
        <section class="sec" style="padding-top:0"><div class="w">
          <p class="eyebrow"><t t-if="is_ar">أيّهما يناسبك؟</t><t t-else="">Which one is yours?</t></p>
          <h2><t t-if="is_ar">برو مقابل برو ماكس</t><t t-else="">Pro vs Pro Max</t></h2>
          <div class="compare">
            <div class="crow head"><div class="rl"></div><div class="cv">Pura 90 Pro</div><div class="cv mx">Pura 90 Pro Max</div></div>
            <div class="crow"><div class="rl"><t t-if="is_ar">الشاشة</t><t t-else="">Display</t></div><div class="cv">6.6″ OLED 120Hz</div><div class="cv">6.9″ OLED 120Hz</div></div>
            <div class="crow"><div class="rl"><t t-if="is_ar">التليفوتو</t><t t-else="">Telephoto</t></div><div class="cv"><t t-if="is_ar">ماكرو 50MP (5سم)</t><t t-else="">50MP macro (5cm)</t></div><div class="cv"><t t-if="is_ar">فائق 200MP · زوم 100×</t><t t-else="">200MP · 100× zoom</t></div></div>
