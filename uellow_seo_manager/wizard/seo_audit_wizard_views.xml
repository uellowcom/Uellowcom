<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_uellow_seo_audit_wizard" model="ir.ui.view">
    <field name="name">uellow.seo.audit.wizard.form</field>
    <field name="model">uellow.seo.audit.wizard</field>
    <field name="arch" type="xml">
      <form string="Run SEO Audit">
        <p style="font-size:12px;color:#666">
          Crawls your published products, categories, and website pages
          and scores them against 30+ SEO checks. Run with a small
          scope_limit first to test, then increase.
        </p>
        <group>
          <field name="scope_products"/>
          <field name="scope_categories"/>
          <field name="scope_pages"/>
          <field name="scope_limit"/>
        </group>
        <footer>
          <button name="action_run" type="object" string="Run audit" class="btn-primary"/>
          <button special="cancel" string="Cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_uellow_seo_audit_wizard" model="ir.actions.act_window">
    <field name="name">Run SEO Audit…</field>
    <field name="res_model">uellow.seo.audit.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
