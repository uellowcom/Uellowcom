<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_uellow_seo_bulk_wizard" model="ir.ui.view">
    <field name="name">uellow.seo.bulk.wizard.form</field>
    <field name="model">uellow.seo.bulk.wizard</field>
    <field name="arch" type="xml">
      <form string="Bulk Auto-Fill SEO Meta">
        <p style="font-size:12px;color:#666">
          For every <strong>published</strong> product missing
          <code>website_meta_title</code> or
          <code>website_meta_description</code>, generates one automatically
          using the product name, brand (if any), price, and the configured
          site name. Re-run until <em>last count = 0</em> (all filled).
        </p>
        <group>
          <field name="batch_size"/>
          <field name="last_count" readonly="1"/>
        </group>
        <footer>
          <button name="action_run_bulk" type="object" string="Process batch" class="btn-primary"/>
          <button special="cancel" string="Close" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_uellow_seo_bulk_wizard" model="ir.actions.act_window">
    <field name="name">Bulk Auto-Fill SEO…</field>
    <field name="res_model">uellow.seo.bulk.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
