<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- BreadcrumbList JSON-LD on product detail pages.
       NOTE: Organization, WebSite and Product JSON-LD are emitted (once,
       with richer curated data) by uellow_seo_auto/views/seo_head_inherit.xml.
       This template used to ALSO emit those three, producing duplicate — and,
       because seo_dump_json returned a plain str that Qweb t-out HTML-escaped,
       INVALID (&#34;) — JSON-LD blocks. Deduplicated 2026-07-05: keep only the
       BreadcrumbList, which seo_auto does not provide. seo_dump_json now
       returns Markup so this block renders as valid JSON. -->
  <template id="seo_manager_head_extra" inherit_id="website.layout" name="Uellow SEO Manager — JSON-LD">
    <xpath expr="//head" position="inside">
      <!-- BreadcrumbList on product detail pages only. -->
      <t t-set="_seo_product"
         t-value="main_object if (main_object and main_object._name == 'product.template') else False"/>
      <t t-if="_seo_product">
        <script type="application/ld+json" data-uellow-seo="breadcrumb"
                t-out="website.seo_dump_json(_seo_product._get_breadcrumb_jsonld())"/>
      </t>
    </xpath>
  </template>
</odoo>
