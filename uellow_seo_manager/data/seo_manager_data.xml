<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Daily automated audit cron — runs at 04:00 server time -->
  <!-- Phase 8 — daily: read indexing coverage from GSC + auto-fix + re-submit
       sitemap. No-op until the GSC service account is configured. -->
  <record id="ir_cron_uellow_seo_indexing_daily" model="ir.cron">
    <field name="name">Uellow SEO — indexing coverage + auto-fix</field>
    <field name="model_id" ref="model_uellow_seo_indexing_issue"/>
    <field name="state">code</field>
    <field name="code">model.cron_inspect_and_fix()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active">True</field>
  </record>

  <record id="ir_cron_uellow_seo_audit_daily" model="ir.cron">
    <field name="name">Uellow SEO — daily audit</field>
    <field name="model_id" ref="model_uellow_seo_audit"/>
    <field name="state">code</field>
    <field name="code">audit = model.create({'name': 'Daily audit %s' % fields.Datetime.now(), 'scope_products': True, 'scope_categories': True, 'scope_pages': True, 'scope_limit': 500})
audit.action_run()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active">True</field>
  </record>

  <!-- Hourly micro-task: back-fill missing meta on new products -->
  <record id="ir_cron_uellow_seo_autofill_hourly" model="ir.cron">
    <field name="name">Uellow SEO — auto-fill missing meta (batch)</field>
    <field name="model_id" ref="product.model_product_template"/>
    <field name="state">code</field>
    <field name="code">model.action_seo_autofill_missing_bulk(batch=100)</field>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="active">True</field>
  </record>

  <!-- AI queue processor — picks up new products and regenerates with Claude.
       Runs every 15 minutes so new products get AI meta quickly. -->
  <record id="ir_cron_uellow_seo_ai_queue" model="ir.cron">
    <field name="name">Uellow SEO — AI queue (Claude regen)</field>
    <field name="model_id" ref="product.model_product_template"/>
    <field name="state">code</field>
    <field name="code">model.cron_seo_ai_queue_run()</field>
    <field name="interval_number">15</field>
    <field name="interval_type">minutes</field>
    <field name="active">True</field>
  </record>

  <!-- Scheduled blog publish — every 10 min check for due drafts -->
  <record id="ir_cron_uellow_seo_publish_scheduled" model="ir.cron">
    <field name="name">Uellow SEO — publish scheduled blog drafts</field>
    <field name="model_id" ref="model_uellow_seo_content_suggestion"/>
    <field name="state">code</field>
    <field name="code">model.cron_publish_scheduled()</field>
    <field name="interval_number">10</field>
    <field name="interval_type">minutes</field>
    <field name="active">True</field>
  </record>

  <!-- Weekly auto-blog — every Sunday at 03:00. Toggled by the
       `blog_auto_schedule_enable` setting (OFF by default). -->
  <record id="ir_cron_uellow_seo_weekly_autoblog" model="ir.cron">
    <field name="name">Uellow SEO — weekly auto-blog (Claude)</field>
    <field name="model_id" ref="model_uellow_seo_content_suggestion"/>
    <field name="state">code</field>
    <field name="code">model.cron_weekly_auto_blog()</field>
    <field name="interval_number">7</field>
    <field name="interval_type">days</field>
    <field name="active">True</field>
  </record>
</odoo>
