<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seo_generate_wizard" model="ir.ui.view">
        <field name="name">uellow.seo.generate.wizard.form</field>
        <field name="model">uellow.seo.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk SEO Generation">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Generate SEO meta for many products at once. The job
                        runs synchronously and commits per batch so partial
                        progress survives interruptions.
                    </div>
                    <group>
                        <field name="scope"/>
                        <field name="product_ids" widget="many2many_tags"
                               invisible="scope != 'selected'"/>
                        <field name="score_threshold" invisible="scope != 'low_score'"/>
                        <field name="overwrite"/>
                        <field name="batch_size"/>
                    </group>
                    <group invisible="not last_run_done and not last_run_failed"
                           string="Last run">
                        <field name="last_run_done" readonly="1"/>
                        <field name="last_run_failed" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_run" type="object" string="Generate"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_seo_generate_wizard" model="ir.actions.act_window">
        <field name="name">Bulk SEO Generation</field>
        <field name="res_model">uellow.seo.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
