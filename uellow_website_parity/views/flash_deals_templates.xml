<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="flash_deals_page" name="Uellow Flash Deals Page">
        <t t-call="website.layout">
            <t t-set="additional_title" t-value="page_title"/>
            <div id="wrap" class="container py-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h1 class="mb-0" style="font-weight: 900; color: #412402;">
                        ⚡ Flash deals
                    </h1>
                    <span class="badge text-bg-warning" style="font-size: 12px;"
                          t-esc="len(sales)"/>
                </div>

                <t t-if="not sales and not promo_blocks">
                    <div class="alert alert-light text-center my-5">
                        <h3>No flash sales running right now</h3>
                        <p class="text-muted">Come back soon — new deals are added every day.</p>
                    </div>
                </t>

                <!-- PROMOTION-system deals (with their products) -->
                <t t-foreach="promo_blocks or []" t-as="blk">
                    <t t-set="promo" t-value="blk['promo']"/>
                    <div class="card mb-4" style="border-radius: 16px; overflow: hidden; border: 0; box-shadow: 0 6px 24px rgba(0,0,0,0.06);">
                        <div class="p-3 d-flex align-items-center"
                             t-attf-style="background: linear-gradient(120deg, #{promo.banner_color_1 or '#F5C320'}, #{promo.banner_color_2 or '#EA580C'}); color: #fff;">
                            <div class="flex-grow-1">
                                <h2 class="mb-1" style="font-weight: 900; font-size: 22px;">
                                    <t t-esc="promo.emoji or '⚡'"/>
                                    <t t-esc="(promo.label_ar if (request.env.lang or '').startswith('ar') else promo.label_en) or promo.name"/>
                                </h2>
                                <div t-if="promo.global_discount_pct" style="font-size: 13px; opacity: 0.9;">
                                    −<t t-esc="int(promo.global_discount_pct)"/>%
                                </div>
                            </div>
                            <span class="badge text-bg-danger" style="font-size: 12px;">LIVE</span>
                        </div>
                        <div class="p-3">
                            <div class="row g-3">
                                <t t-foreach="blk['products']" t-as="it">
                                    <t t-set="product" t-value="it['p']"/>
                                    <div class="col-6 col-md-3 col-lg-2">
                                        <a t-attf-href="#{product.website_url or ('/shop/%d' % product.id)}" class="text-decoration-none">
                                            <div style="background: #fff; border-radius: 12px; overflow: hidden; border: 1px solid #f3edde; position: relative;">
                                                <span t-if="it['pct']" style="position:absolute; top:6px; inset-inline-start:6px; background:#C0392B; color:#fff; font-size:11px; font-weight:900; padding:2px 7px; border-radius:20px;">
                                                    −<t t-esc="it['pct']"/>%
                                                </span>
                                                <div style="aspect-ratio: 1; background: #fafaf6;">
                                                    <img t-attf-src="/web/image/product.template/#{product.id}/image_512"
                                                         class="w-100 h-100" style="object-fit: cover;" t-att-alt="product.name"/>
                                                </div>
                                                <div class="p-2">
                                                    <div style="font-size: 11.5px; color: #412402; font-weight: 700; line-height: 1.3;
                                                                overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2;
                                                                -webkit-box-orient: vertical; min-height: 30px;" t-esc="product.name"/>
                                                    <div class="mt-1">
                                                        <span style="color: #C0392B; font-weight: 900; font-size: 13.5px;" t-esc="'%.3f' % it['after']"/>
                                                        <small style="color: #999;">KD</small>
                                                        <small t-if="it['pct']" class="text-muted text-decoration-line-through ms-1" t-esc="'%.3f' % it['before']"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>

                <t t-foreach="sales" t-as="sale">
                    <div class="card mb-4" style="border-radius: 16px; overflow: hidden; border: 0; box-shadow: 0 6px 24px rgba(0,0,0,0.06);">
                        <div class="p-3 d-flex align-items-center"
                             t-att-style="'background: %s; color: %s;' % (sale.background_color or '#F5C320', '#412402')">
                            <div class="flex-grow-1">
                                <h2 class="mb-1" style="font-weight: 900; font-size: 22px;">
                                    <t t-esc="sale.name"/>
                                </h2>
                                <div style="font-size: 13px; opacity: 0.8;">
                                    <t t-esc="sale.subtitle or ''"/>
                                </div>
                            </div>
                            <t t-if="sale.is_live">
                                <span class="badge text-bg-danger" style="font-size: 12px;">
                                    LIVE
                                </span>
                            </t>
                            <t t-elif="sale.start_date and sale.start_date.timestamp() > 0">
                                <span class="badge text-bg-secondary" style="font-size: 12px;">
                                    UPCOMING
                                </span>
                            </t>
                            <t t-else="">
                                <span class="badge text-bg-light" style="font-size: 12px;">
                                    ENDED
                                </span>
                            </t>
                        </div>

                        <div class="p-3">
                            <div class="row g-3">
                                <t t-foreach="sale.product_ids[:24]" t-as="product">
                                    <div class="col-6 col-md-3 col-lg-2">
                                        <a t-attf-href="/shop/#{product.website_url or ('product/%d' % product.id)}"
                                           class="text-decoration-none">
                                            <div style="background: #fff; border-radius: 12px; overflow: hidden; border: 1px solid #f3edde;">
                                                <div style="aspect-ratio: 1; background: #fafaf6;">
                                                    <img t-attf-src="/web/image/product.template/#{product.id}/image_512"
                                                         class="w-100 h-100" style="object-fit: cover;"
                                                         t-att-alt="product.name"/>
                                                </div>
                                                <div class="p-2">
                                                    <div style="font-size: 11.5px; color: #412402; font-weight: 700; line-height: 1.3;
                                                                overflow: hidden; text-overflow: ellipsis;
                                                                display: -webkit-box; -webkit-line-clamp: 2;
                                                                -webkit-box-orient: vertical; min-height: 30px;"
                                                         t-esc="product.name"/>
                                                    <div class="mt-1">
                                                        <span style="color: #C0392B; font-weight: 900; font-size: 13.5px;"
                                                              t-esc="'%.3f' % product.list_price"/>
                                                        <small style="color: #999;" t-esc="product.currency_id.symbol or 'KD'"/>
                                                        <t t-if="product.compare_list_price and product.compare_list_price > product.list_price">
                                                            <small class="text-muted text-decoration-line-through ms-1"
                                                                   t-esc="'%.3f' % product.compare_list_price"/>
                                                        </t>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <template id="free_shipping_page" name="Uellow Free Shipping Page">
        <t t-call="website.layout">
            <t t-set="additional_title">Free shipping · شحن مجاني</t>
            <div id="wrap" class="container py-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h1 class="mb-0" style="font-weight: 900; color: #412402;">
                        🚚 Free Shipping
                    </h1>
                    <span class="badge text-bg-warning" style="font-size: 12px;">
                        <t t-esc="total"/> products
                    </span>
                </div>
                <p class="text-muted mb-4">
                    Browse products that ship to you free of charge.
                </p>

                <t t-if="not products">
                    <div class="alert alert-light text-center my-5">
                        <h3>No free-shipping products configured yet</h3>
                        <p class="text-muted">Mark products / categories / tags as
                            free-shipping in the admin to populate this page.</p>
                    </div>
                </t>

                <div class="row g-3">
                    <t t-foreach="products" t-as="product">
                        <div class="col-6 col-md-3 col-lg-2">
                            <a t-attf-href="/shop/#{product.website_url or ('product/%d' % product.id)}"
                               class="text-decoration-none">
                                <div style="background: #fff; border-radius: 12px; overflow: hidden; border: 1px solid #f3edde; position: relative;">
                                    <div style="position: absolute; top: 8px; left: 8px; background: #F5C320; color: #412402; padding: 3px 6px; border-radius: 6px; font-size: 9px; font-weight: 900; z-index: 2;">
                                        🚚 FREE
                                    </div>
                                    <div style="aspect-ratio: 1; background: #fafaf6;">
                                        <img t-attf-src="/web/image/product.template/#{product.id}/image_512"
                                             class="w-100 h-100" style="object-fit: cover;"
                                             t-att-alt="product.name"/>
                                    </div>
                                    <div class="p-2">
                                        <div style="font-size: 11.5px; color: #412402; font-weight: 700; line-height: 1.3;
                                                    overflow: hidden; text-overflow: ellipsis;
                                                    display: -webkit-box; -webkit-line-clamp: 2;
                                                    -webkit-box-orient: vertical; min-height: 30px;"
                                             t-esc="product.name"/>
                                        <div class="mt-1">
                                            <span style="color: #412402; font-weight: 900; font-size: 13.5px;"
                                                  t-esc="'%.3f' % product.list_price"/>
                                            <small style="color: #999;" t-esc="product.currency_id.symbol or 'KD'"/>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <template id="brands_page" name="Uellow Brands Page">
        <t t-call="website.layout">
            <t t-set="additional_title">Brands · العلامات التجارية</t>
            <div id="wrap" class="container py-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h1 class="mb-0" style="font-weight: 900; color: #412402;">🏷️ Brands</h1>
                    <span class="badge text-bg-warning" style="font-size: 12px;"><t t-esc="total"/> brands</span>
                </div>
                <p class="text-muted mb-4">Shop by your favourite brand.</p>
                <t t-if="not brands">
                    <div class="alert alert-light text-center my-5"><h3>No brands yet</h3></div>
                </t>
                <div class="row g-3">
                    <t t-foreach="brands" t-as="brand">
                        <div class="col-4 col-md-3 col-lg-2">
                            <a t-attf-href="/shop?attribute_value=#{brand.id}" class="text-decoration-none">
                                <div style="background:#fff;border-radius:14px;border:1px solid #f3edde;padding:14px;text-align:center;transition:.15s;height:100%;"
                                     onmouseover="this.style.boxShadow='0 6px 18px rgba(0,0,0,.08)'" onmouseout="this.style.boxShadow='none'">
                                    <div style="aspect-ratio:1;display:grid;place-items:center;background:#fafaf6;border-radius:10px;overflow:hidden;margin-bottom:8px;">
                                        <img t-if="brand.dr_image" t-attf-src="/web/image/product.attribute.value/#{brand.id}/dr_image"
                                             style="max-width:100%;max-height:100%;object-fit:contain;" t-att-alt="brand.name"/>
                                        <span t-else="" style="font-size:24px;font-weight:900;color:#412402;" t-esc="brand.name[:2].upper()"/>
                                    </div>
                                    <div style="font-size:12px;font-weight:700;color:#412402;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                         t-esc="brand.name"/>
                                </div>
                            </a>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <template id="bestseller_page" name="Uellow Bestseller Page">
        <t t-call="website.layout">
            <t t-set="additional_title">Bestsellers · الأكثر مبيعاً</t>
            <div id="wrap" class="container py-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h1 class="mb-0" style="font-weight: 900; color: #412402;">
                        🏆 Bestsellers
                    </h1>
                    <span class="badge text-bg-warning" style="font-size: 12px;">
                        <t t-esc="total"/> products
                    </span>
                </div>
                <p class="text-muted mb-4">
                    The most popular products on Uellow — same ranking as the app.
                </p>

                <t t-if="not products">
                    <div class="alert alert-light text-center my-5">
                        <h3>No bestsellers yet</h3>
                        <p class="text-muted">Rankings populate automatically from sales.</p>
                    </div>
                </t>

                <div class="row g-3">
                    <t t-foreach="products" t-as="product">
                        <div class="col-6 col-md-3 col-lg-2">
                            <a t-attf-href="/shop/#{product.website_url or ('product/%d' % product.id)}"
                               class="text-decoration-none">
                                <div style="background: #fff; border-radius: 12px; overflow: hidden; border: 1px solid #f3edde; position: relative;">
                                    <div style="position: absolute; top: 8px; left: 8px; background: #412402; color: #F5C320; padding: 3px 7px; border-radius: 6px; font-size: 10px; font-weight: 900; z-index: 2;">
                                        #<t t-esc="product_index + 1"/>
                                    </div>
                                    <div style="aspect-ratio: 1; background: #fafaf6;">
                                        <img t-attf-src="/web/image/product.template/#{product.id}/image_512"
                                             class="w-100 h-100" style="object-fit: cover;"
                                             t-att-alt="product.name"/>
                                    </div>
                                    <div class="p-2">
                                        <div style="font-size: 11.5px; color: #412402; font-weight: 700; line-height: 1.3;
                                                    overflow: hidden; text-overflow: ellipsis;
                                                    display: -webkit-box; -webkit-line-clamp: 2;
                                                    -webkit-box-orient: vertical; min-height: 30px;"
                                             t-esc="product.name"/>
                                        <div class="mt-1">
                                            <span style="color: #412402; font-weight: 900; font-size: 13.5px;"
                                                  t-esc="'%.3f' % product.list_price"/>
                                            <small style="color: #999;" t-esc="product.currency_id.symbol or 'KD'"/>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>
