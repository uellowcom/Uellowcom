<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- RFQ list (kpis_tree): colored receipt + payment badges, newest-first -->
    <record id="po_kpis_tree_status" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.uellow.status</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">date_order desc, id desc</attribute>
            </xpath>
            <field name="invoice_status" position="before">
                <field name="receipt_status" widget="badge" optional="show"
                       decoration-danger="receipt_status == 'pending'"
                       decoration-warning="receipt_status == 'partial'"
                       decoration-success="receipt_status == 'full'"/>
                <field name="payment_status" widget="badge" optional="show"
                       decoration-muted="payment_status == 'no'"
                       decoration-danger="payment_status == 'not_paid'"
                       decoration-warning="payment_status == 'partial' or payment_status == 'in_payment'"
                       decoration-success="payment_status == 'paid'"/>
            </field>
        </field>
    </record>

    <!-- Purchase Orders list (view_tree): same badges, newest-first -->
    <record id="po_view_tree_status" model="ir.ui.view">
        <field name="name">purchase.order.view.tree.uellow.status</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">date_order desc, id desc</attribute>
            </xpath>
            <field name="invoice_status" position="before">
                <field name="receipt_status" widget="badge" optional="show"
                       decoration-danger="receipt_status == 'pending'"
                       decoration-warning="receipt_status == 'partial'"
                       decoration-success="receipt_status == 'full'"/>
                <field name="payment_status" widget="badge" optional="show"
                       decoration-muted="payment_status == 'no'"
                       decoration-danger="payment_status == 'not_paid'"
                       decoration-warning="payment_status == 'partial' or payment_status == 'in_payment'"
                       decoration-success="payment_status == 'paid'"/>
            </field>
        </field>
    </record>

</odoo>
