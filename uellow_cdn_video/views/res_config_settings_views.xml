<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bunny" model="ir.ui.view">
        <field name="name">res.config.settings.bunny</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Uellow Bunny Stream" string="🐰 Bunny Stream"
                     name="uellow_cdn_video" groups="base.group_system">
                    <block title="Bunny Stream — video CDN" id="bunny_block">
                        <setting id="bunny_lib" string="Library ID">
                            <field name="bunny_stream_library_id"/>
                        </setting>
                        <setting id="bunny_zone" string="CDN hostname (.b-cdn.net)">
                            <field name="bunny_stream_pull_zone"/>
                        </setting>
                        <setting id="bunny_api" string="API key (Stream library, server-only)">
                            <field name="bunny_stream_api_key" password="True"/>
                        </setting>
                        <setting id="bunny_del_local" string="Delete local file after upload"
                                 help="Reclaim Odoo storage once the video is on Bunny.">
                            <field name="bunny_delete_local_after_upload"/>
                        </setting>
                        <setting id="bunny_autosync" string="Auto-refresh analytics daily"
                                 help="Daily job pulling views / watch-time / status into the dashboard.">
                            <field name="bunny_auto_sync_stats"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
