<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bunny" model="ir.ui.view">
        <field name="name">res.config.settings.bunny</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Uellow Bunny Stream" string="🐰 Bunny Stream"
                     name="uellow_cdn_video" groups="base.group_system">
                    <block title="Bunny Stream — video CDN" id="bunny_block">
                        <setting id="bunny_lib" string="Library ID">
                            <field name="bunny_stream_library_id"/>
                        </setting>
                        <setting id="bunny_zone" string="CDN hostname (.b-cdn.net)">
                            <field name="bunny_stream_pull_zone"/>
                        </setting>
                        <setting id="bunny_api" string="API key (server-only)">
                            <field name="bunny_stream_api_key" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
