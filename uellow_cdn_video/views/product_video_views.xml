<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_video_form_inherit_cdn" model="ir.ui.view">
        <field name="name">product.video.form.cdn</field>
        <field name="model">product.video</field>
        <field name="inherit_id" ref="uellow_tiktok_video.view_product_video_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='video_type']" position="after">
                <group string="🐰 Bunny Stream"
                       invisible="video_type != 'bunny_stream'">
                    <field name="bunny_video_id" placeholder="1a2b3c4d-..."/>
                    <field name="bunny_thumb_auto"/>
                    <field name="bunny_playback_url" widget="url" readonly="1"/>
                    <field name="bunny_thumb_url" widget="image_url" readonly="1"/>
                </group>
                <group string="📊 Analytics" invisible="video_type != 'bunny_stream'">
                    <field name="bunny_status" readonly="1"/>
                    <field name="bunny_encode_progress" readonly="1"/>
                    <field name="bunny_views" readonly="1"/>
                    <field name="bunny_length_human" readonly="1"/>
                    <field name="bunny_avg_watch" readonly="1"/>
                    <field name="bunny_total_watch" readonly="1"/>
                    <field name="bunny_storage_mb" readonly="1"/>
                    <field name="bunny_synced_at" readonly="1"/>
                    <button name="action_sync_bunny_stats" type="object"
                            string="🔄 Refresh analytics" class="btn-secondary"/>
                </group>
            </xpath>
            <!-- v2.1.2 — one-click upload of the attached file straight to
                 Bunny Stream (no Bunny dashboard needed). Shows once a file
                 is attached; on success it fills the GUID + switches the
                 backend to Bunny automatically. -->
            <xpath expr="//field[@name='video_file']" position="after">
                <button name="action_upload_to_bunny" type="object"
                        string="⬆ Upload this file to Bunny Stream"
                        class="btn-primary" invisible="not video_file"
                        help="Sends the attached video file to Bunny Stream and fills the GUID automatically. Save the record first if the button looks inactive."/>
            </xpath>
        </field>
    </record>

    <!-- v2.1.2 — add the same upload button INTO the inline Videos list on the
         product form, so admins upload to Bunny right from the product page
         (the editable one2many list never opens the standalone form). -->
    <record id="product_template_form_video_bunny_btn" model="ir.ui.view">
        <field name="name">product.template.form.video.bunny.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="uellow_tiktok_video.view_product_template_form_video"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_video_ids']/list/field[@name='active']" position="before">
                <button name="action_upload_to_bunny" type="object"
                        string="⬆ To Bunny" class="btn-link"
                        invisible="not video_file"
                        help="Upload this file to Bunny Stream and fill the GUID. Save the product first if the button looks inactive."/>
                <!-- Bunny data so a bunny_stream row isn't blank -->
                <field name="bunny_thumb_url" widget="image_url" optional="show"
                       string="Preview" invisible="video_type != 'bunny_stream'"/>
                <field name="bunny_status" optional="show"
                       invisible="video_type != 'bunny_stream'"/>
                <field name="bunny_views" optional="show" string="Views"
                       invisible="video_type != 'bunny_stream'"/>
                <field name="bunny_length_human" optional="show" string="Duration"
                       invisible="video_type != 'bunny_stream'"/>
                <field name="bunny_playback_url" widget="url" optional="hide"
                       string="HLS link" invisible="video_type != 'bunny_stream'"/>
                <field name="bunny_video_id" optional="hide" string="GUID"
                       invisible="video_type != 'bunny_stream'"/>
                <button name="action_sync_bunny_stats" type="object"
                        string="🔄 Stats" class="btn-link"
                        invisible="video_type != 'bunny_stream'"
                        help="Refresh views / watch-time / status from Bunny."/>
            </xpath>
        </field>
    </record>
</odoo>
