<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v2.2.21 — keep 'hide'-mode bundles' published flag in sync with
         component stock (stock moves don't write the bundle). -->
    <record id="cron_bundle_availability" model="ir.cron">
        <field name="name">Uellow — Sync bundle availability</field>
        <field name="model_id" ref="model_uellow_bundle"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_availability()</field>
        <field name="interval_number">20</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
