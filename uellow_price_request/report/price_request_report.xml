<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_price_request" model="ir.actions.report">
        <field name="name">Price Update List</field>
        <field name="model">uellow.price.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">uellow_price_request.report_price_request</field>
        <field name="report_file">uellow_price_request.report_price_request</field>
        <field name="binding_model_id" ref="model_uellow_price_request"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_price_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family:Arial,Helvetica,sans-serif;color:#412402;">
                        <style>
                            .prq-h { background:#412402;color:#F5C320;padding:10px 14px;border-radius:8px; }
                            .prq-h h2 { margin:0;font-size:20px;color:#F5C320; }
                            .prq-meta td { padding:2px 8px;font-size:12px; }
                            table.prq { width:100%;border-collapse:collapse;margin-top:10px;font-size:11.5px; }
                            table.prq th { background:#F5C320;color:#412402;padding:7px 6px;text-align:left;border:1px solid #e0c25a; }
                            table.prq td { padding:6px;border:1px solid #ddd;vertical-align:middle; }
                            table.prq tr:nth-child(even) td { background:#fcf7e6; }
                            .prq-fill { background:#fffce8 !important;border:1px solid #d8c97a !important; }
                            .prq-box { display:inline-block;width:13px;height:13px;border:1.4px solid #412402;border-radius:3px;margin-right:4px;vertical-align:middle; }
                            .prq-note { margin-top:8px;font-size:11.5px;background:#fcf7e6;border-left:4px solid #F5C320;padding:8px 10px; }
                        </style>

                        <div class="prq-h">
                            <h2>Price Update List · قائمة تحديث الأسعار</h2>
                        </div>

                        <table class="prq-meta" style="margin-top:8px;">
                            <tr>
                                <td><strong>Ref / المرجع:</strong></td>
                                <td><span t-field="doc.name"/></td>
                                <td><strong>Date / التاريخ:</strong></td>
                                <td><span t-field="doc.date"/></td>
                            </tr>
                            <tr>
                                <td><strong>Supplier / المورّد:</strong></td>
                                <td><span t-field="doc.supplier_label"/></td>
                                <td><strong>Currency / العملة:</strong></td>
                                <td><span t-field="doc.currency_id.name"/></td>
                            </tr>
                        </table>

                        <p style="margin-top:6px;font-size:12px;">
                            Dear supplier, please fill the <strong>New Price</strong> and
                            <strong>Available?</strong> columns and send this list back.
                            <br/>
                            <span style="direction:rtl;display:block;">عزيزنا المورّد، يُرجى تعبئة عمودي
                            <strong>السعر الجديد</strong> و <strong>متوفر؟</strong> وإعادة القائمة إلينا.</span>
                        </p>

                        <table class="prq">
                            <thead>
                                <tr>
                                    <th style="width:26px;">#</th>
                                    <th style="width:90px;">SKU / الرمز</th>
                                    <th>Product / المنتج</th>
                                    <th style="width:80px;text-align:right;">Current<br/>الحالي</th>
                                    <th style="width:90px;text-align:right;">New Price<br/>السعر الجديد</th>
                                    <th style="width:120px;">Available? / متوفر؟</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="i" t-value="0"/>
                                <tr t-foreach="doc.line_ids" t-as="ln">
                                    <t t-set="i" t-value="i + 1"/>
                                    <td><span t-esc="i"/></td>
                                    <td>
                                        <span t-field="ln.default_code"/>
                                        <t t-if="not ln.default_code and ln.barcode">
                                            <span t-field="ln.barcode"/>
                                        </t>
                                    </td>
                                    <td><span t-field="ln.product_tmpl_id.name"/></td>
                                    <td style="text-align:right;">
                                        <span t-field="ln.current_price"
                                              t-options="{'widget': 'float', 'precision': 3}"/>
                                    </td>
                                    <td class="prq-fill" style="text-align:right;">
                                        <t t-if="ln.new_price">
                                            <span t-field="ln.new_price"
                                                  t-options="{'widget': 'float', 'precision': 3}"/>
                                        </t>
                                    </td>
                                    <td class="prq-fill">
                                        <span class="prq-box"
                                              t-att-style="ln.availability == 'yes' and 'background:#412402;' or ''"/>Yes/نعم
                                        <span class="prq-box" style="margin-left:8px;"
                                              t-att-style="ln.availability == 'no' and 'background:#412402;' or ''"/>No/لا
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="doc.note">
                            <div class="prq-note">
                                <span t-field="doc.note"/>
                            </div>
                        </t>

                        <p style="margin-top:14px;font-size:11px;color:#888;">
                            Total products / إجمالي المنتجات:
                            <strong t-esc="doc.product_count"/> ·
                            Uellow — uellow.com
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
