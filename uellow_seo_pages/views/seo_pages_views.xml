<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════
         LIST
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_seo_page_list" model="ir.ui.view">
        <field name="name">uellow.seo.page.list</field>
        <field name="model">uellow.seo.page</field>
        <field name="arch" type="xml">
            <list string="SEO Landing Pages"
                  decoration-muted="state=='archived' or not active"
                  decoration-info="state=='draft'"
                  decoration-warning="state=='review'"
                  decoration-success="state=='published'">
                <field name="title_en"/>
                <field name="title_ar"/>
                <field name="slug"/>
                <field name="product_source"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'"
                       decoration-warning="state=='review'"
                       decoration-success="state=='published'"/>
                <field name="visit_count"/>
                <field name="created_by_ai" widget="boolean"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         FORM
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_seo_page_form" model="ir.ui.view">
        <field name="name">uellow.seo.page.form</field>
        <field name="model">uellow.seo.page</field>
        <field name="arch" type="xml">
            <form string="SEO Landing Page">
                <header>
                    <button name="action_submit_for_review" type="object"
                            string="Submit for Review" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_publish" type="object"
                            string="Publish" class="oe_highlight"
                            invisible="state == 'published' or state == 'archived'"/>
                    <button name="action_unpublish" type="object"
                            string="Unpublish"
                            invisible="state != 'published'"/>
                    <button name="action_archive" type="object"
                            string="Archive"
                            invisible="state == 'archived'"
                            confirm="Archive this landing page? It will no longer be reachable."/>
                    <button name="action_preview" type="object"
                            string="Preview" icon="fa-eye"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,review,published"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_preview" type="object"
                                class="oe_stat_button" icon="fa-eye">
                            <field name="visit_count" widget="statinfo" string="Visits"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="title_en"/>
                        <h1><field name="title_en" placeholder="Best Smart Watches in Kuwait 2026"/></h1>
                        <label for="slug"/>
                        <field name="slug" placeholder="best-smart-watches-kuwait-2026"/>
                        <div class="text-muted">
                            Live URL: <code>/guides/<field name="slug" readonly="1" nolabel="1" class="d-inline"/></code>
                        </div>
                    </div>

                    <notebook>
                        <page string="Content (EN)" name="content_en">
                            <group>
                                <field name="h1_en"/>
                                <field name="intro_en" widget="text"/>
                                <field name="meta_desc_en" widget="text" placeholder="≤ 160 chars"/>
                            </group>
                        </page>
                        <page string="Content (AR)" name="content_ar">
                            <group>
                                <field name="title_ar"/>
                                <field name="h1_ar"/>
                                <field name="intro_ar" widget="text"/>
                                <field name="meta_desc_ar" widget="text" placeholder="≤ 160 حرف"/>
                            </group>
                        </page>
                        <page string="Products" name="products">
                            <group>
                                <field name="product_source"/>
                                <field name="max_products"/>
                                <field name="category_id"
                                       invisible="product_source != 'category'"/>
                                <field name="tag_ids" widget="many2many_tags"
                                       invisible="product_source != 'tag'"/>
                                <field name="manual_product_ids" widget="many2many_tags"
                                       invisible="product_source != 'manual'"
                                       domain="[('website_published','=',True)]"/>
                            </group>
                        </page>
                        <page string="FAQ" name="faq">
                            <field name="faq_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="question_en"/>
                                    <field name="question_ar"/>
                                    <field name="answer_en" widget="text"/>
                                    <field name="answer_ar" widget="text"/>
                                </list>
                            </field>
                        </page>
                        <page string="Social / OG" name="og">
                            <group>
                                <field name="og_image" widget="image"
                                       options="{'preview_image':'og_image'}"/>
                                <div class="text-muted">
                                    Optional — falls back to first product image.
                                    Recommended size: 1200×630.
                                </div>
                            </group>
                        </page>
                        <page string="Stats" name="stats">
                            <group>
                                <field name="visit_count" readonly="1"/>
                                <field name="last_visited" readonly="1"/>
                                <field name="created_by_ai" readonly="1"/>
                                <field name="sequence"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         SEARCH
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_seo_page_search" model="ir.ui.view">
        <field name="name">uellow.seo.page.search</field>
        <field name="model">uellow.seo.page</field>
        <field name="arch" type="xml">
            <search>
                <field name="title_en"/>
                <field name="title_ar"/>
                <field name="slug"/>
                <filter string="Published" name="f_pub"      domain="[('state','=','published')]"/>
                <filter string="In Review" name="f_rev"      domain="[('state','=','review')]"/>
                <filter string="Draft" name="f_drf"          domain="[('state','=','draft')]"/>
                <filter string="Archived" name="f_arc"       domain="[('state','=','archived')]"/>
                <separator/>
                <filter string="AI generated" name="f_ai"    domain="[('created_by_ai','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="State"  name="g_state"  context="{'group_by':'state'}"/>
                    <filter string="Source" name="g_source" context="{'group_by':'product_source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_seo_pages" model="ir.actions.act_window">
        <field name="name">SEO Landing Pages</field>
        <field name="res_model">uellow.seo.page</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_seo_page_search"/>
        <field name="context">{'search_default_f_pub': 1, 'search_default_f_drf': 1, 'search_default_f_rev': 1}</field>
    </record>

</odoo>
