<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Heal UPayments orders whose capture webhook never arrived
             (incl. paid-but-cancelled like S06427). Runs every 20 min. -->
        <record id="ir_cron_upayments_reconcile" model="ir.cron">
            <field name="name">UPayments: reconcile missed captures</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_upayments_reconcile()</field>
            <field name="interval_number">20</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
