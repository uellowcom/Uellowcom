<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_vendor_list" model="ir.ui.view">
    <field name="name">uellow.vendor.list</field>
    <field name="model">uellow.vendor</field>
    <field name="arch" type="xml">
      <list string="Vendors"
            decoration-warning="state=='pending'"
            decoration-success="state=='active'"
            decoration-muted="state in ('rejected','suspended')">
        <field name="display_name"/>
        <field name="store_slug"/>
        <field name="country_id"/>
        <field name="currency_id"/>
        <field name="plan_id"/>
        <field name="tier" widget="badge"/>
        <field name="order_count"/>
        <field name="total_sales"/>
        <field name="avg_rating"/>
        <field name="cancel_rate" string="Cancel%"/>
        <field name="state" widget="badge"
               decoration-warning="state=='pending'"
               decoration-success="state=='active'"
               decoration-danger="state in ('rejected','suspended')"/>
        <button name="action_approve_wizard" string="Approve"
                type="object" icon="fa-check"
                invisible="state != 'pending'"
                groups="uellow_multivendor.group_marketplace_manager"/>
      </list>
    </field>
  </record>

  <record id="view_vendor_form" model="ir.ui.view">
    <field name="name">uellow.vendor.form</field>
    <field name="model">uellow.vendor</field>
    <field name="arch" type="xml">
      <form string="Vendor">
        <header>
          <button name="action_submit" string="Submit for Review"
                  type="object" class="oe_highlight"
                  invisible="state != 'draft'"/>
          <button name="action_approve_wizard" string="Approve"
                  type="object" class="oe_highlight"
                  invisible="state != 'pending'"
                  groups="uellow_multivendor.group_marketplace_manager"/>
          <button name="action_reject" string="Reject"
                  type="object"
                  invisible="state not in ('pending','active')"
                  groups="uellow_multivendor.group_marketplace_manager"/>
          <button name="action_suspend" string="Suspend"
                  type="object"
                  invisible="state != 'active'"
                  groups="uellow_multivendor.group_marketplace_manager"/>
          <button name="action_reactivate" string="Reactivate"
                  type="object" class="oe_highlight"
                  invisible="state != 'suspended'"
                  groups="uellow_multivendor.group_marketplace_manager"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,pending,active"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" type="object"
                    name="action_view_orders" icon="fa-shopping-cart">
              <field name="order_count" widget="statinfo" string="Orders"/>
            </button>
            <button class="oe_stat_button" type="object"
                    name="action_view_wallet" icon="fa-wallet">
              <field name="wallet_balance" widget="statinfo" string="Balance"/>
            </button>
            <button class="oe_stat_button" icon="fa-users">
              <field name="follower_count" widget="statinfo" string="Store Followers"/>
            </button>
          </div>
          <div class="oe_title">
            <h1><field name="store_name_en"/></h1>
            <h2><field name="store_name_ar" placeholder="Arabic name..."/></h2>
          </div>
          <group>
            <group string="Identity">
              <field name="logo_image" widget="image" class="oe_avatar"/>
              <field name="partner_id"/>
              <field name="user_id"/>
              <field name="store_slug"/>
              <field name="plan_id"/>
              <field name="tier"/>
            </group>
            <group string="Geography and Currency">
              <field name="country_id"/>
              <field name="currency_id"/>
              <field name="timezone"/>
            </group>
          </group>
          <notebook>
            <page string="Store Info">
              <group>
                <group><field name="brand_color"/><field name="store_tagline_en"/><field name="store_tagline_ar"/></group>
                <group><field name="store_description_en"/><field name="store_description_ar"/></group>
              </group>
            </page>
            <page string="Registration">
              <group>
                <group><field name="business_name"/><field name="commercial_reg"/><field name="contact_phone"/><field name="contact_email"/></group>
                <group><field name="bank_iban"/><field name="bank_name"/><field name="registration_date"/><field name="approval_date" readonly="1"/></group>
              </group>
            </page>
            <page string="FBU and Wallet">
              <group>
                <field name="fbu_location_id" readonly="1"/>
                <field name="wallet_id" readonly="1"/>
              </group>
            </page>
            <!-- Per-vendor capabilities + financial settlement.
                 Fields are related to settings_id (write-through). -->
            <page string="Capabilities &amp; Settlement">
              <div class="alert alert-info" role="alert" invisible="settings_id">
                Save the vendor first (or approve it) to create its settings record,
                then these toggles become editable.
              </div>
              <group string="Vendor Type">
                <field name="vendor_type"/>
                <p class="text-muted" colspan="2">
                  Business model. Seeds fulfillment toggles (stock control,
                  customer-data visibility, settlement) — override any toggle below.
                </p>
              </group>
              <group string="Quick Profile">
                <field name="capability_preset"/>
                <p class="text-muted" colspan="2">
                  Pick a preset to set all toggles at once, then fine-tune below.
                  'House brand' = no self-service + no financial tracking.
                </p>
              </group>
              <group>
                <group string="Catalog">
                  <field name="cap_add_products"/>
                  <field name="cap_edit_products"/>
                  <field name="cap_archive_products"/>
                  <field name="cap_update_stock"/>
                  <field name="cap_publish_products"/>
                  <field name="cap_manage_price"/>
                  <field name="cap_import_products"/>
                </group>
                <group string="Merchandising &amp; Orders">
                  <field name="cap_flash_sale"/>
                  <field name="cap_bundles"/>
                  <field name="cap_join_promotions"/>
                  <field name="cap_manage_orders"/>
                  <field name="cap_cancel_orders"/>
                  <field name="cap_restock"/>
                  <field name="cap_edit_store"/>
                </group>
              </group>
              <group string="Financial Settlement">
                <group>
                  <field name="settlement_mode"/>
                  <field name="settle_trigger"
                         invisible="settlement_mode != 'per_order'"/>
                </group>
                <group>
                  <field name="cap_request_payout"/>
                  <field name="cap_api"/>
                  <field name="cap_live"/>
                  <field name="cap_quick_sale"/>
                  <field name="hide_financials"/>
                </group>
                <p class="text-muted" colspan="2">
                  <b>Per-order</b>: every order is settled instantly — the vendor
                  never sees any outstanding dues or payable balance.
                  <b>None</b>: no commissions or wallet at all (Uellow-owned stock).
                </p>
              </group>
            </page>
            <!-- v2.1.66 — assign ANY catalog product to this vendor.
                 widget=many2many turns the one2many into a picker:
                 "Add" links an existing product (sets its vendor_id),
                 removing a line just unassigns it (vendor_id cleared). -->
            <page string="Products">
              <field name="product_total" invisible="1"/>
              <p class="text-muted">
                Pick products from the whole Odoo catalog — they will show
                in this vendor's storefront in the app. Removing a line
                only unassigns the product (it is never deleted).
              </p>
              <field name="product_ids" widget="many2many" nolabel="1">
                <list>
                  <field name="name"/>
                  <field name="default_code" optional="show"/>
                  <field name="list_price" widget="monetary"/>
                  <field name="is_published" string="Published"/>
                  <field name="vendor_approval_state" optional="show"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_vendor_search" model="ir.ui.view">
    <field name="name">uellow.vendor.search</field>
    <field name="model">uellow.vendor</field>
    <field name="arch" type="xml">
      <search>
        <field name="display_name"/>
        <field name="country_id"/>
        <filter string="Pending" name="pending" domain="[('state','=','pending')]"/>
        <filter string="Active" name="active" domain="[('state','=','active')]"/>
        <filter string="Suspended" name="suspended" domain="[('state','=','suspended')]"/>
        <group expand="0" string="Group By">
          <filter string="Country" name="by_country" context="{'group_by':'country_id'}"/>
          <filter string="Status" name="by_state" context="{'group_by':'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_vendors" model="ir.actions.act_window">
    <field name="name">Vendors</field>
    <field name="res_model">uellow.vendor</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_pending': 1}</field>
  </record>

  <record id="action_marketplace_dashboard" model="ir.actions.client">
    <field name="name">Marketplace Dashboard</field>
    <field name="tag">marketplace_dashboard_action</field>
  </record>

</odoo>
