<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v2.1.66 — assign a product to a marketplace vendor straight from
         the product form (General Information). The product then shows
         on that vendor's storefront in the app. -->
    <record id="product_template_form_vendor_assign" model="ir.ui.view">
        <field name="name">product.template.form.vendor.assign</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="vendor_id" string="Marketplace Vendor"
                       options="{'no_create': True}"/>
                <field name="vendor_approval_state"
                       invisible="not vendor_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Quick filter + column in the product list -->
    <record id="product_template_list_vendor" model="ir.ui.view">
        <field name="name">product.template.list.vendor</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="vendor_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
