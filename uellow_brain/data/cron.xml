<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nightly Base-Score recompute (off the request path). No-op when the
         engine is disabled. -->
    <record id="cron_brain_scores" model="ir.cron">
        <field name="name">Uellow Brain — Recompute product scores</field>
        <field name="model_id" ref="model_product_template"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model._cron_brain_recompute_scores()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Nightly taste-profile build (Phase 2). No-op when engine off /
         personalization mode = off. -->
    <record id="cron_brain_profiles" model="ir.cron">
        <field name="name">Uellow Brain — Build taste profiles</field>
        <field name="model_id" ref="model_uellow_taste_profile"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model._cron_build_profiles()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Automated merchandising rules (Phase 4). No-op when engine off.
         Rules default to 'suggest' (log only) — safe. -->
    <record id="cron_brain_merch" model="ir.cron">
        <field name="name">Uellow Brain — Run merchandising rules</field>
        <field name="model_id" ref="model_uellow_merch_rule"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_merch_rules()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
