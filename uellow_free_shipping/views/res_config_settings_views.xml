<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_free_shipping" model="ir.ui.view">
        <field name="name">res.config.settings.free_shipping</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Uellow Free Shipping" string="🚚 Free Shipping"
                     name="uellow_free_shipping" groups="base.group_system">
                    <block title="🚚 Uellow Free-Shipping" id="uellow_free_shipping_block">
                        <setting id="uellow_free_shipping_threshold" string="Global free-shipping threshold (KWD)">
                            <field name="free_shipping_threshold_kwd"/>
                        </setting>
                        <setting id="uellow_free_shipping_label_en" string="Badge label (EN)">
                            <field name="free_shipping_badge_label_en"/>
                        </setting>
                        <setting id="uellow_free_shipping_label_ar" string="Badge label (AR)">
                            <field name="free_shipping_badge_label_ar"/>
                        </setting>
                        <setting id="uellow_free_shipping_express"
                                 string="Exclude EXPRESS delivery"
                                 help="Express carriers always keep their full price — free-shipping flags, thresholds, coupons and the cart progress bar apply to STANDARD delivery only. Mark express carriers via the 'Express Service' checkbox on the delivery method (name auto-detection covers 'express/سريع' too).">
                            <field name="free_shipping_express_excluded"/>
                        </setting>
                        <setting id="uellow_free_shipping_product_rule"
                                 string="Product-flag rule"
                                 help="ANY: one flagged product makes the order's standard delivery free. ALL: every product must be flagged. Badges only: flags show the badge but never change delivery prices.">
                            <field name="free_shipping_product_rule"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
