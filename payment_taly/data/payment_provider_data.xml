<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_taly" model="payment.provider">
        <field name="name">Taly - اشتري الآن وادفع لاحقاً</field>
        <field name="code">taly</field>
        <field name="state">disabled</field>
        <field name="is_published">False</field>
        <field name="sequence">50</field>
        <!-- v2.2.27 — link the payment method so Taly shows at checkout. -->
        <field name="payment_method_ids"
               eval="[Command.link(ref('payment_taly.payment_method_taly'))]"/>
    </record>
</odoo>
