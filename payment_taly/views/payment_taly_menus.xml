<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- v2.2.27 — Taly is now its own top-level app (clean icon + ordered
         Dashboard / Transactions / Reports / Configuration). -->
    <menuitem
        id="menu_taly_root"
        name="Taly"
        web_icon="payment_taly,static/description/icon.png"
        sequence="50"/>

    <menuitem
        id="menu_taly_dashboard"
        name="Dashboard"
        parent="menu_taly_root"
        action="action_taly_dashboard"
        sequence="1"/>

    <menuitem
        id="menu_taly_transactions"
        name="Transactions"
        parent="menu_taly_root"
        action="action_taly_transactions"
        sequence="2"/>

    <menuitem
        id="menu_taly_report"
        name="Reports"
        parent="menu_taly_root"
        action="action_taly_report"
        sequence="3"/>

    <!-- Configuration group -->
    <menuitem
        id="menu_taly_config"
        name="Configuration"
        parent="menu_taly_root"
        sequence="9"/>

    <menuitem
        id="menu_taly_settings"
        name="Settings"
        parent="menu_taly_config"
        action="action_taly_settings"
        sequence="1"/>

    <menuitem
        id="menu_taly_logs"
        name="API Logs"
        parent="menu_taly_config"
        action="action_taly_logs"
        sequence="2"/>

</odoo>
