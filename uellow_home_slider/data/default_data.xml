<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="default_slider" model="uellow.home.slider">
            <field name="name">السلايدر الرئيسي</field>
            <field name="sequence">10</field><field name="active">True</field>
            <field name="show_coupon">True</field>
            <field name="coupon_code">WELCOME05</field><field name="coupon_discount">5%</field>
            <field name="logo_url">/web/image/website/1/logo/Uellow?unique=13b1cfb</field>
            <field name="signup_url">/web/signup</field><field name="login_url">/web/login</field>
            <field name="ar_banner1_url">/ar/shop</field><field name="ar_banner1_alt">بنر 1</field>
            <field name="ar_banner2_url">/ar/shop</field><field name="ar_banner2_alt">بنر 2</field>
            <field name="en_banner1_url">/en/shop</field><field name="en_banner1_alt">Banner 1</field>
            <field name="en_banner2_url">/en/shop</field><field name="en_banner2_alt">Banner 2</field>
        </record>
        <!-- Slides, menu items and features are seeded ONCE from the UI and then
             fully owned by the admin. They are intentionally NOT declared here so
             deleting one in the backend is permanent (module upgrades never
             recreate them). -->
    </data>
</odoo>
