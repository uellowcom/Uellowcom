<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== القالب الرئيسي ===== -->
    <template id="uellow_home_slider_block" name="Uellow Home Slider">
        <section class="s_uellow_home_slider uellow-hero-section">

            <!-- ===================== DESKTOP v2 ===================== -->
            <!-- Gradient Spotlight hero + departments menu on the side -->
            <div class="uhs-desktop uhs-v2 d-none d-lg-flex">

                <!-- departments menu (compact, admin add/remove) -->
                <aside class="uhs-dept" id="uhs_dept">
                    <div class="uhs-dept-h">
                        <span class="uhs-dept-bars"><i></i><i></i><i></i></span>
                        <span id="uhs_dept_title">All Departments</span>
                    </div>
                    <ul class="uhs-dept-list" id="uhs_dept_list"></ul>
                    <a class="uhs-dept-f" id="uhs_dept_footer" href="/shop">
                        <span id="uhs_dept_footer_t">All departments</span>
                        <span class="uhs-dept-count" id="uhs_dept_count"></span>
                    </a>
                </aside>

                <!-- spotlight slider -->
                <div class="uhs-spot" id="uhs_desktop_wrap">
                    <img class="uhs-slide-img" id="uhs_desktop_img"
                         src="/uellow_home_slider/static/src/img/placeholder_wide.svg"
                         alt="slide" loading="eager" fetchpriority="high" decoding="async"/>
                    <div class="uhs-spot-scrim"></div>

                    <div class="uhs-spot-in" id="uhs_d_overlay">
                        <span class="uhs-chip" id="uhs_d_kicker" style="display:none;"></span>
                        <h2 class="uhs-spot-title" id="uhs_d_title" style="display:none;"></h2>
                        <p  class="uhs-spot-sub"   id="uhs_d_sub"   style="display:none;"></p>
                        <div class="uhs-spot-cta-row">
                            <a class="uhs-cta" id="uhs_d_btn" href="/shop">Shop now</a>
                            <div class="uhs-cpn" id="uhs_ticket_wrap">
                                <span class="uhs-cpn-label" id="uhs_voucher_label">Coupon</span>
                                <span class="uhs-cpn-code" id="uhs_coupon_code">WELCOME05</span>
                                <span class="uhs-cpn-off"><span id="uhs_discount">5%</span></span>
                                <button type="button" class="uhs-cpn-copy" id="uhs_copy_btn" data-code="WELCOME05">Copy</button>
                            </div>
                        </div>
                        <div class="uhs-feats" id="uhs_feats"></div>
                    </div>

                    <div class="uhs-nav-group" id="uhs_d_controls">
                        <button type="button" class="uhs-nav" id="uhs_d_prev" aria-label="Previous">&#8249;</button>
                        <button type="button" class="uhs-nav" id="uhs_d_next" aria-label="Next">&#8250;</button>
                    </div>
                    <div class="uhs-dots uhs-dots-left" id="uhs_d_dots"></div>
                    <div class="uhs-pbar" id="uhs_d_pbar"></div>
                </div>
            </div>

            <!-- ===================== MOBILE (unchanged) ===================== -->
            <div class="uhs-mobile d-lg-none" id="uhs_mobile_wrap">
                <img class="uhs-slide-img" id="uhs_mobile_img" src="/uellow_home_slider/static/src/img/placeholder_wide.svg" alt="slide" loading="eager" fetchpriority="high" decoding="async"/>
                <button type="button" class="uhs-arrow uhs-right" id="uhs_m_prev">&#8250;</button>
                <button type="button" class="uhs-arrow uhs-left"  id="uhs_m_next">&#8249;</button>
                <div class="uhs-dots" id="uhs_m_dots"></div>
                <div class="uhs-overlay" id="uhs_m_overlay" style="display:none;">
                    <h2 class="uhs-overlay-title" id="uhs_m_title"></h2>
                    <p  class="uhs-overlay-sub"   id="uhs_m_sub"></p>
                    <a  class="uhs-overlay-btn"   id="uhs_m_btn" href="/shop"></a>
                </div>
            </div>
        </section>
    </template>

    <!--
        ===== تسجيل البلوك في قائمة السنيبتات - Odoo 18 =====
    -->
    <record id="snippet_uellow_home_slider" model="ir.ui.view">
        <field name="name">s_uellow_home_slider</field>
        <field name="type">qweb</field>
        <field name="key">uellow_home_slider.s_uellow_home_slider</field>
        <field name="arch" type="xml">
            <t t-name="uellow_home_slider.s_uellow_home_slider">
                <section class="s_uellow_home_slider uellow-hero-section">
                    <t t-call="uellow_home_slider.uellow_home_slider_block"/>
                </section>
            </t>
        </field>
    </record>

    <!--
        تسجيل في قائمة البلوكات عبر snippet_groups (الطريقة المضمونة في Odoo 18)
    -->
    <template id="uellow_snippets"
              inherit_id="website.snippets"
              name="Uellow Snippets">
        <xpath expr="//snippets[@id='snippet_structure']" position="before">
            <snippets id="snippet_uellow" string="Uellow">
                <t t-snippet="uellow_home_slider.s_uellow_home_slider"
                   t-thumbnail="/uellow_home_slider/static/src/img/thumbnail.svg"/>
            </snippets>
        </xpath>
    </template>

</odoo>
