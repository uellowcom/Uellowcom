<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_uellow_home_slider_list" model="ir.ui.view">
        <field name="name">uellow.home.slider.list</field>
        <field name="model">uellow.home.slider</field>
        <field name="arch" type="xml">
            <list string="Sliders" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="coupon_code"/>
                <field name="coupon_discount"/>
                <field name="slide_count" string="Slides"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_uellow_home_slider_form" model="ir.ui.view">
        <field name="name">uellow.home.slider.form</field>
        <field name="model">uellow.home.slider</field>
        <field name="arch" type="xml">
            <form string="Slider settings">
                <header>
                    <button name="action_view_slides" type="object"
                            string="View slides" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_slides" type="object"
                                class="oe_stat_button" icon="fa-images">
                            <field name="slide_count" widget="statinfo" string="Slides"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Slider name"/>
                        <h1><field name="name" placeholder="Main slider"/></h1>
                    </div>
                    <notebook>

                        <page string="General" name="general">
                            <group>
                                <group string="Logo">
                                    <field name="logo_image" widget="image"
                                           options="{'size': [220,80], 'preview_image': 'logo_image'}"/>
                                    <field name="logo_url" placeholder="Fallback logo URL"/>
                                </group>
                                <group string="Settings">
                                    <field name="sequence"/>
                                    <field name="active"/>
                                    <field name="signup_url"/>
                                    <field name="login_url"/>
                                </group>
                            </group>
                            <group string="Welcome coupon">
                                <group>
                                    <field name="show_coupon"/>
                                    <field name="coupon_code" invisible="not show_coupon"/>
                                    <field name="coupon_discount" invisible="not show_coupon"/>
                                </group>
                            </group>
                        </page>

                        <page string="Design &amp; controls (desktop)" name="design">
                            <div class="alert alert-info" role="alert">
                                These settings control the slider on <strong>desktop</strong> (spotlight design + departments menu).
                                <br/>The <strong>mobile layout is unchanged</strong> and unaffected by these options.
                            </div>
                            <group>
                                <group string="Departments menu">
                                    <field name="show_menu"/>
                                    <field name="menu_title_ar" invisible="not show_menu"/>
                                    <field name="menu_title_en" invisible="not show_menu"/>
                                    <field name="menu_footer_ar" invisible="not show_menu"/>
                                    <field name="menu_footer_en" invisible="not show_menu"/>
                                    <field name="menu_footer_url" invisible="not show_menu"/>
                                </group>
                                <group string="Controls">
                                    <field name="show_features"/>
                                    <field name="show_overlay_text"/>
                                    <field name="show_arrows"/>
                                    <field name="show_dots"/>
                                    <field name="autoplay"/>
                                    <field name="autoplay_speed" invisible="not autoplay"/>
                                    <field name="overlay_opacity" string="Overlay darkness %"/>
                                </group>
                            </group>
                            <group string="Shop button">
                                <group>
                                    <field name="cta_label_ar"/>
                                    <field name="cta_label_en"/>
                                </group>
                            </group>
                        </page>

                        <page string="Departments menu" name="dept_menu">
                            <div class="alert alert-info" role="alert">
                                Add or remove side-menu departments. Drag to reorder; each has an AR + EN name, an icon and a link.
                            </div>
                            <field name="menu_ids">
                                <list editable="bottom" decoration-muted="not active">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name_ar"/>
                                    <field name="name_en"/>
                                    <field name="icon"/>
                                    <field name="url"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>

                        <page string="Features" name="features">
                            <div class="alert alert-info" role="alert">
                                The features strip under the hero (free delivery / cash on delivery / secure payment...). Add or remove any feature.
                            </div>
                            <field name="feature_ids">
                                <list editable="bottom" decoration-muted="not active">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name_ar"/>
                                    <field name="name_en"/>
                                    <field name="icon"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>

                        <page string="Arabic banners (legacy)" name="banners_ar">
                            <div class="alert alert-warning" role="alert">
                                These banners were for the old design; the new desktop design does not use them (kept for reference only).
                            </div>
                            <group>
                                <group string="Banner 1">
                                    <field name="ar_banner1_image" widget="image"
                                           options="{'size': [320,150], 'preview_image': 'ar_banner1_image'}"/>
                                    <field name="ar_banner1_url"/>
                                    <field name="ar_banner1_alt"/>
                                </group>
                                <group string="Banner 2">
                                    <field name="ar_banner2_image" widget="image"
                                           options="{'size': [320,150], 'preview_image': 'ar_banner2_image'}"/>
                                    <field name="ar_banner2_url"/>
                                    <field name="ar_banner2_alt"/>
                                </group>
                            </group>
                        </page>

                        <page string="English Banners (old)" name="banners_en">
                            <div class="alert alert-warning" role="alert">
                                Legacy banners for the old design; the new desktop layout does not use them.
                            </div>
                            <group>
                                <group string="Banner 1">
                                    <field name="en_banner1_image" widget="image"
                                           options="{'size': [320,150], 'preview_image': 'en_banner1_image'}"/>
                                    <field name="en_banner1_url"/>
                                    <field name="en_banner1_alt"/>
                                </group>
                                <group string="Banner 2">
                                    <field name="en_banner2_image" widget="image"
                                           options="{'size': [320,150], 'preview_image': 'en_banner2_image'}"/>
                                    <field name="en_banner2_url"/>
                                    <field name="en_banner2_alt"/>
                                </group>
                            </group>
                        </page>

                        <page string="Slides" name="slides">
                            <div class="alert alert-warning" role="alert">
                                Add a separate slide for each <strong>language + device</strong>.
                                If there are no mobile images, desktop images are used automatically.
                            </div>
                            <field name="slide_ids">
                                <list editable="bottom" decoration-muted="not active">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="language"/>
                                    <field name="device"/>
                                    <field name="image" widget="image" options="{'size': [100,50]}"/>
                                    <field name="image_url" optional="show" placeholder="External URL"/>
                                    <field name="link_url"/>
                                    <field name="open_new_tab" optional="hide"/>
                                    <field name="show_overlay" optional="hide"/>
                                    <field name="alt_text" optional="hide"/>
                                    <field name="active"/>
                                </list>
                                <form string="Slide details">
                                    <group>
                                        <group string="Slide info">
                                            <field name="name"/>
                                            <field name="sequence"/>
                                            <field name="language"/>
                                            <field name="device"/>
                                            <field name="active"/>
                                            <field name="link_url"/>
                                            <field name="open_new_tab"/>
                                            <field name="alt_text"/>
                                        </group>
                                        <group string="Image">
                                            <field name="image" widget="image"
                                                   options="{'size': [420,210], 'preview_image': 'image'}"/>
                                            <field name="image_url" placeholder="or paste an image URL"/>
                                        </group>
                                    </group>
                                    <group string="Overlay text">
                                        <field name="show_overlay"/>
                                        <group invisible="not show_overlay">
                                            <field name="overlay_kicker"/>
                                            <field name="overlay_title"/>
                                            <field name="overlay_sub"/>
                                            <field name="overlay_btn"/>
                                            <field name="overlay_btn_url"/>
                                        </group>
                                    </group>
                                    <group string="This slide&apos;s coupon &amp; features">
                                        <field name="sl_coupon_mode"/>
                                        <field name="sl_coupon_code" invisible="sl_coupon_mode != 'custom'" placeholder="e.g. WELCOME05"/>
                                        <field name="sl_coupon_disc" invisible="sl_coupon_mode != 'custom'" placeholder="e.g. 5%"/>
                                        <field name="sl_feats_mode"/>
                                    </group>
                                </form>
                            </field>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_uellow_home_slider" model="ir.actions.act_window">
        <field name="name">Home Slider</field>
        <field name="res_model">uellow.home.slider</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first home slider</p>
        </field>
    </record>

    <record id="action_uellow_home_slide" model="ir.actions.act_window">
        <field name="name">Slides</field>
        <field name="res_model">uellow.home.slide</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_uellow_root" name="Uellow" sequence="99"/>
    <menuitem id="menu_uellow_home_slider" name="Home Slider" parent="menu_uellow_root" action="action_uellow_home_slider" sequence="10"/>
    <menuitem id="menu_uellow_slides" name="Slides" parent="menu_uellow_root" action="action_uellow_home_slide" sequence="20"/>
    <menuitem id="menu_uellow_website_conf" name="Uellow Home Slider" parent="website.menu_website_configuration" action="action_uellow_home_slider" sequence="50"/>

</odoo>
