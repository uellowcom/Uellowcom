<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="home_cards" name="Uellow home product cards">
    <a t-foreach="products" t-as="pr" t-att-href="pr['url']" class="uh-card">
      <div class="uh-thumb">
        <img t-att-src="pr['image']" t-att-alt="pr['name']" loading="lazy" decoding="async" width="256" height="256"/>
        <span t-if="pr['discount']" class="uh-save"><t t-esc="'وفّر' if is_ar else 'Save'"/> <t t-esc="'%.2f' % pr['save']"/> <t t-esc="pr['currency']"/></span>
      </div>
      <div class="uh-name" t-esc="pr['name']"/>
      <div class="uh-price">
        <span class="uh-now"><t t-esc="'%.3f' % pr['price']"/> <t t-esc="pr['currency']"/></span>
        <span t-if="pr['compare']" class="uh-was"><t t-esc="'%.3f' % pr['compare']"/></span>
        <span t-if="pr['discount']" class="uh-pct">-<t t-esc="pr['discount']"/>%</span>
      </div>
    </a>
  </template>

  <template id="home_preview_page" name="Uellow Homepage (preview)">
    <t t-call="website.layout">
      <t t-set="additional_title" t-value="(page and ((page.meta_title_ar if is_ar else page.meta_title_en) or page.name)) or 'Uellow'"/>
      <div class="uhome" t-att-dir="'rtl' if is_ar else 'ltr'">
        <style>
          .uhome{--ink:#14202b;--muted:#5d6b78;--line:#e7eef3;--bg:#f6fafd;--card:#fff;
            --orange:#F26A2E;--orange2:#d8500f;--sky:#22a7e0;--gold:#F5C320;--red:#E63946;
            background:var(--bg);color:var(--ink);font-family:'Segoe UI',Tahoma,system-ui,sans-serif;line-height:1.5}
          .uhome *{box-sizing:border-box}
          .uh-hero{padding-top:10px}
          .uh-sec{position:relative}
          .uh-anim{opacity:0;transform:translateY(16px)}
          .uh-anim.in{opacity:1;transform:none;transition:opacity .5s ease,transform .5s ease}
          .uh-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px;flex-wrap:wrap}
          .uh-ttl{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:900;letter-spacing:.05em;
            text-transform:uppercase;color:var(--orange2)}
          .uh-ttl::before{content:'';width:16px;height:3px;border-radius:3px;background:linear-gradient(90deg,var(--orange),var(--orange2))}
          .uh-ttl small{font-weight:600;text-transform:none;letter-spacing:0;color:var(--muted);font-size:11px}
          .uh-all{white-space:nowrap;font-size:11.5px;font-weight:800;color:var(--muted);text-decoration:none;margin-inline-start:auto}
          .uh-all:hover{color:var(--orange)}
          .uh-rail{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(158px,1fr);gap:12px;
            overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:6px;-webkit-overflow-scrolling:touch}
          .uh-rail::-webkit-scrollbar{height:6px}.uh-rail::-webkit-scrollbar-thumb{background:var(--line);border-radius:6px}
          .uh-grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fill,minmax(158px,1fr))}
          .uh-card{scroll-snap-align:start;background:var(--card);border:1px solid var(--line);border-radius:14px;
            overflow:hidden;text-decoration:none;color:inherit;display:flex;flex-direction:column;transition:box-shadow .15s,transform .15s}
          .uh-card:hover{box-shadow:0 14px 28px -18px rgba(20,50,80,.45);transform:translateY(-3px)}
          .uh-thumb{position:relative;aspect-ratio:1;background:#f2f6f9;overflow:hidden}
          .uh-thumb img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s}
          .uh-card:hover .uh-thumb img{transform:scale(1.05)}
          .uh-save{position:absolute;inset-inline-start:8px;top:8px;background:#fff;color:var(--red);
            font-size:10.5px;font-weight:800;padding:2px 8px;border-radius:999px;border:1px solid #ffd7cf;box-shadow:0 2px 6px rgba(0,0,0,.1)}
          .uh-pct{background:var(--red);color:#fff;font-size:10.5px;font-weight:800;padding:1px 6px;border-radius:6px}
          .uh-name{padding:9px 10px 2px;font-size:12.5px;font-weight:600;line-height:1.35;
            display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:34px}
          .uh-price{padding:2px 10px 11px;display:flex;align-items:baseline;gap:7px;flex-wrap:wrap;margin-top:auto}
          .uh-now{font-size:14px;font-weight:800;color:var(--ink)}
          .uh-was{font-size:11.5px;color:#9aa7b2;text-decoration:line-through}
          /* flash deals — side gradient panel + countdown */
          .uh-flash{background:linear-gradient(180deg,#fff4f1,transparent 62%)}
          .uh-flashwrap{display:flex;gap:12px;align-items:stretch}
          .uh-flashpanel{flex:0 0 156px;border-radius:16px;background:linear-gradient(155deg,#ff5a5a,#F26A2E 85%);
            color:#fff;padding:16px 12px;display:flex;flex-direction:column;align-items:center;justify-content:center;
            gap:8px;text-align:center;box-shadow:0 14px 28px -18px rgba(216,80,15,.6)}
          .uh-flashttl{font-size:18px;font-weight:900;letter-spacing:.02em}
          .uh-flashttl::before{content:'🔥 '}
          .uh-flashsub{font-size:12px;font-weight:700;opacity:.96}
          .uh-timer{display:inline-flex;align-items:center;gap:4px;font-weight:900}
          .uh-timer b{background:#fff;color:#c0392b;border-radius:7px;padding:5px 7px;min-width:30px;text-align:center;
            font-size:15px;font-variant-numeric:tabular-nums}
          .uh-timer i{font-style:normal;font-weight:900;color:#fff}
          .uh-flashbtn{margin-top:2px;background:#fff;color:var(--orange2);font-weight:800;border-radius:999px;
            padding:8px 20px;font-size:12.5px;text-decoration:none}
          .uh-flashbtn:hover{filter:brightness(.97)}
          .uh-flashslider{position:relative;flex:1 1 0;min-width:0}
          .uh-slider{position:relative;width:100%}
          .uh-frail{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 50px)/6);gap:10px;
            overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding-bottom:2px;scrollbar-width:none}
          .uh-frail::-webkit-scrollbar{display:none}
          .uh-frail .uh-card{scroll-snap-align:start}
          .uh-fnav{position:absolute;top:50%;transform:translateY(-50%);z-index:4;width:34px;height:34px;border-radius:50%;
            background:rgba(255,255,255,.96);border:1px solid var(--line);color:var(--ink);display:grid;place-items:center;
            font-size:18px;cursor:pointer;box-shadow:0 6px 16px -8px rgba(20,50,80,.5);transition:background .15s,color .15s}
          .uh-fnav:hover{background:#fff;color:var(--orange)}
          .uh-fnav.prev{inset-inline-start:5px}.uh-fnav.next{inset-inline-end:5px}
          .uhome[dir="rtl"] .uh-fnav{transform:translateY(-50%) scaleX(-1)}
          @media (max-width:1024px){.uh-frail{grid-auto-columns:calc((100% - 30px)/4)}}
          @media (max-width:640px){.uh-flashwrap{flex-direction:column}.uh-flashpanel{flex:none;flex-direction:row;flex-wrap:wrap;justify-content:center;padding:12px 16px}
            .uh-frail{grid-auto-columns:calc((100% - 20px)/3);gap:8px}.uh-fnav{display:none}}
          /* departments */
          .uh-depts{display:grid;grid-template-columns:repeat(auto-fill,minmax(94px,1fr));gap:12px}
          .uh-dept{display:flex;flex-direction:column;align-items:center;gap:7px;text-decoration:none;color:inherit;
            background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px 8px;transition:.15s}
          .uh-dept:hover{border-color:var(--orange);box-shadow:0 10px 22px -16px rgba(20,50,80,.35);transform:translateY(-2px)}
          .uh-dept .ic{width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#fff2e9,#e7f5fc);display:grid;place-items:center;overflow:hidden}
          .uh-dept .ic img{width:100%;height:100%;object-fit:cover}.uh-dept .ic span{font-size:22px}
          .uh-dept .nm{font-size:11.5px;font-weight:700;text-align:center;line-height:1.25;
            display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
          /* bonus */
          .uh-bonus{background:linear-gradient(120deg,#fff2e9,#e7f5fc);border:1px solid var(--line);border-radius:18px;
            padding:22px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;overflow:hidden;position:relative}
          .uh-bonus::after{content:'🎁';position:absolute;font-size:120px;opacity:.06;inset-inline-end:10px;top:-20px}
          .uh-bonus h3{margin:0;font-size:clamp(18px,2.4vw,24px);font-weight:800}
          .uh-bonus p{margin:4px 0 0;color:var(--muted);font-size:14px}
          .uh-btn{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(120deg,var(--orange),var(--orange2));
            color:#fff;text-decoration:none;font-weight:800;border-radius:12px;padding:12px 22px;font-size:14px;border:0;cursor:pointer}
          .uh-btn:hover{filter:brightness(1.05)}
          /* Banggood-style under-hero row: products slider + new-user bonus panel */
          .uh-bwrap{display:flex;gap:12px;align-items:stretch;border:1.5px solid #F5C320;
            border-radius:16px;padding:12px;background:#fff;box-shadow:0 6px 22px rgba(20,20,40,.05)}
          .uh-bslider{flex:1 1 0;min-width:0;width:auto}
          .uh-bpanel{flex:0 0 190px;border-radius:12px;text-decoration:none;color:#fff;
            background:linear-gradient(150deg,#FFB300,#F26A2E);
            display:flex;flex-direction:column;align-items:center;justify-content:center;
            gap:5px;text-align:center;padding:16px 12px;transition:filter .15s}
          .uh-bpanel:hover{filter:brightness(1.05)}
          .uh-bgift{font-size:34px;line-height:1}
          .uh-btitle{font-size:14px;font-weight:900;line-height:1.25}
          .uh-bamt{font-size:13px;font-weight:800}
          .uh-bbtn{margin-top:5px;background:#fff;color:#d8500f;font-weight:800;
            border-radius:999px;padding:7px 20px;font-size:12.5px}
          @media (max-width:640px){.uh-bwrap{flex-direction:column}.uh-bpanel{flex:none;padding:14px}}
          /* Banggood hero: categories span full height (slider + bonus row) on the right */
          @media (min-width:992px){
            .uhome .uh-bghero.has-bonus{display:grid;grid-template-columns:1fr 250px;grid-template-rows:auto auto;gap:12px;align-items:start}
            .uhome .uh-bghero.has-bonus > .s_uellow_home_slider{display:contents !important}
            .uhome .uh-bghero.has-bonus .uhs-desktop.uhs-v2{display:contents !important}
            .uhome .uh-bghero.has-bonus .uhs-spot{grid-column:1;grid-row:1;height:360px;margin:0}
            .uhome .uh-bghero.has-bonus .uhs-dept{grid-column:2;grid-row:1 / span 2;align-self:stretch;height:auto;max-height:none}
            .uhome .uh-bghero.has-bonus .uh-bwrap-hero{grid-column:1;grid-row:2;margin:0}
            .uhome .uh-bghero.has-bonus .uhs-mobile{display:none !important}
            /* text-only compact category list, like banggood.com */
            .uhome .uhs-dept-ic, .uhome .uhs-dept-img{display:none !important}
            .uhome .uhs-dept-list li a{padding:9px 12px;gap:6px}
          }
          .uh-banner img{width:100%;display:block;border-radius:16px}
          .uh-inf-sentinel{height:1px}.uh-inf-more{text-align:center;margin-top:18px}.uh-inf-btn{margin:0 auto}
          .uh-spin{display:inline-block;width:22px;height:22px;border:3px solid var(--line);border-top-color:var(--orange);border-radius:50%;animation:uhspin .7s linear infinite;margin:14px auto}
          @keyframes uhspin{to{transform:rotate(360deg)}}
          @media (prefers-reduced-motion:reduce){.uh-anim{opacity:1;transform:none}.uh-card:hover .uh-thumb img{transform:none}}
        </style>

        <t t-foreach="sections" t-as="sec">
          <t t-if="sec['type'] == 'hero_slider'">
            <div class="container uh-hero">
              <div t-attf-class="uh-bghero#{' has-bonus' if sec.get('bonus') else ''}">
                <t t-call="uellow_home_slider.uellow_home_slider_block"/>
                <t t-if="sec.get('bonus')">
                  <t t-set="b" t-value="sec['bonus']"/>
                  <div class="uh-bwrap uh-bwrap-hero">
                    <div class="uh-slider uh-bslider">
                      <button type="button" class="uh-fnav prev" aria-label="Previous">‹</button>
                      <div class="uh-frail"><t t-set="products" t-value="b['products']"/><t t-call="uellow_home_slider.home_cards"/></div>
                      <button type="button" class="uh-fnav next" aria-label="Next">›</button>
                    </div>
                    <a class="uh-bpanel" href="/web/signup">
                      <div class="uh-bgift">🎁</div>
                      <div class="uh-btitle" t-esc="b['title'] or ('مكافأة المستخدم الجديد' if is_ar else 'New-user bonus')"/>
                      <div class="uh-bamt" t-esc="b['subtitle'] or ('يصل إلى 25 د.ك' if is_ar else 'Up to 25 KWD')"/>
                      <span class="uh-bbtn"><t t-esc="'اذهب' if is_ar else 'Go'"/> ›</span>
                    </a>
                  </div>
                </t>
              </div>
            </div>
          </t>

          <section t-if="sec['type'] in ('product_row','category_strip')" class="uh-sec"
                   t-att-style="('padding:%dpx 0;' % sec['pad_y']) + (('background:%s;' % sec['bg']) if sec['bg'] else '')">
            <div class="container">
              <div t-if="sec['show_title'] and sec['title']" class="uh-head">
                <span class="uh-ttl"><t t-esc="sec['title']"/><small t-if="sec['subtitle']" t-esc="sec['subtitle']"/></span>
                <a t-if="sec['show_link']" t-att-href="sec['link_url']" class="uh-all"><t t-esc="sec['link_label']"/> →</a>
              </div>
              <t t-set="products" t-value="sec['products']"/>
              <div t-if="sec['style']=='grid'" class="uh-grid" t-att-style="'grid-template-columns:repeat(%d,1fr)' % sec['columns']">
                <t t-call="uellow_home_slider.home_cards"/>
              </div>
              <div t-else="" class="uh-slider">
                <button type="button" class="uh-fnav prev" aria-label="Previous">‹</button>
                <div class="uh-frail"><t t-call="uellow_home_slider.home_cards"/></div>
                <button type="button" class="uh-fnav next" aria-label="Next">›</button>
              </div>
            </div>
          </section>

          <!-- FLASH DEALS — side gradient panel + rail (matches the live style) -->
          <section t-if="sec['type'] == 'flash_deals'" class="uh-sec uh-flash" t-att-style="'padding:%dpx 0;' % sec['pad_y']">
            <div class="container">
              <div class="uh-flashwrap">
                <div class="uh-flashpanel">
                  <div class="uh-flashttl"><t t-esc="sec['title'] or ('عروض فلاش' if is_ar else 'Flash deals')"/></div>
                  <div class="uh-flashsub"><t t-esc="'تنتهي خلال' if is_ar else 'Ends in'"/></div>
                  <div class="uh-timer" data-countdown="1"><b>00</b><i>:</i><b>00</b><i>:</i><b>00</b></div>
                  <a class="uh-flashbtn" t-att-href="sec['link_url']"><t t-esc="'عرض الكل' if is_ar else 'View all'"/></a>
                </div>
                <div class="uh-flashslider">
                  <button type="button" class="uh-fnav prev" aria-label="Previous">‹</button>
                  <div class="uh-frail">
                    <t t-set="products" t-value="sec['products']"/>
                    <t t-call="uellow_home_slider.home_cards"/>
                  </div>
                  <button type="button" class="uh-fnav next" aria-label="Next">›</button>
                </div>
              </div>
            </div>
          </section>

          <section t-if="sec['type'] == 'dept_spotlight'" class="uh-sec"
                   t-att-style="('padding:%dpx 0;' % sec['pad_y']) + (('background:%s;' % sec['bg']) if sec['bg'] else '')">
            <div class="container">
              <div t-if="sec['show_title'] and sec['title']" class="uh-head">
                <span class="uh-ttl"><t t-esc="sec['title']"/></span>
              </div>
              <div class="uh-depts">
                <a t-foreach="sec['cats']" t-as="c" t-att-href="c['url']" class="uh-dept">
                  <span class="ic"><img t-if="c['image']" t-att-src="c['image']" t-att-alt="c['name']" loading="lazy" decoding="async" width="52" height="52"/><span t-else="">🛍️</span></span>
                  <span class="nm" t-esc="c['name']"/>
                </a>
              </div>
            </div>
          </section>

          <section t-if="sec['type'] == 'new_user_bonus' and not sec.get('_skip')" class="uh-sec" t-att-style="'padding:%dpx 0;' % sec['pad_y']">
            <div class="container">
              <div class="uh-bwrap">
                <div class="uh-slider uh-bslider">
                  <button type="button" class="uh-fnav prev" aria-label="Previous">‹</button>
                  <div class="uh-frail"><t t-set="products" t-value="sec['products']"/><t t-call="uellow_home_slider.home_cards"/></div>
                  <button type="button" class="uh-fnav next" aria-label="Next">›</button>
                </div>
                <a class="uh-bpanel" href="/web/signup">
                  <div class="uh-bgift">🎁</div>
                  <div class="uh-btitle" t-esc="sec['title'] or ('مكافأة المستخدم الجديد' if is_ar else 'New-user bonus')"/>
                  <div class="uh-bamt" t-esc="sec['subtitle'] or ('يصل إلى 25 د.ك' if is_ar else 'Up to 25 KWD')"/>
                  <span class="uh-bbtn"><t t-esc="'اذهب' if is_ar else 'Go'"/> ›</span>
                </a>
              </div>
            </div>
          </section>

          <section t-if="sec['type'] == 'banner' and sec['image']" class="uh-sec" t-att-style="'padding:%dpx 0;' % sec['pad_y']">
            <div class="container uh-banner"><a t-att-href="sec['link_url']"><img t-att-src="sec['image']" t-att-alt="sec['title'] or 'banner'" loading="lazy" decoding="async"/></a></div>
          </section>

          <section t-if="sec['type'] == 'custom_html' and sec['html']" class="uh-sec" t-att-style="'padding:%dpx 0;' % sec['pad_y']">
            <div class="container"><t t-out="sec['html']"/></div>
          </section>

          <section t-if="sec['type'] == 'infinite_products'" class="uh-sec" t-att-style="'padding:%dpx 0;' % sec['pad_y']">
            <div class="container">
              <div t-if="sec['show_title'] and sec['title']" class="uh-head">
                <span class="uh-ttl"><t t-esc="sec['title']"/></span>
              </div>
              <div class="uh-inf" data-infinite="1" t-att-data-seed="sec['seed']" t-att-data-limit="sec['limit']">
                <div class="uh-grid uh-inf-grid">
                  <t t-set="products" t-value="sec['products']"/>
                  <t t-call="uellow_home_slider.home_cards"/>
                </div>
                <div class="uh-inf-sentinel"></div>
                <div class="uh-inf-more">
                  <button type="button" class="uh-btn uh-inf-btn" style="display:none"><t t-esc="'عرض المزيد' if is_ar else 'Load more'"/></button>
                </div>
              </div>
            </div>
          </section>
        </t>

        <script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"Uellow","url":"https://www.uellow.com/","potentialAction":{"@type":"SearchAction","target":"https://www.uellow.com/shop?search={q}","query-input":"required name=q"}}</script>

        <script>
        (function(){
          /* scroll-reveal animations */
          if('IntersectionObserver' in window){
            var secs=[].slice.call(document.querySelectorAll('.uhome .uh-sec'));
            secs.forEach(function(s){ s.classList.add('uh-anim'); });
            var ro=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); ro.unobserve(e.target); } }); }, {rootMargin:'0px 0px -6% 0px'});
            secs.forEach(function(s){ ro.observe(s); });
          }
          /* flash countdown to midnight */
          function pad(n){ return (''+n).padStart(2,'0'); }
          [].slice.call(document.querySelectorAll('[data-countdown]')).forEach(function(el){
            var b=el.querySelectorAll('b');
            function tick(){
              var now=new Date(), end=new Date(); end.setHours(24,0,0,0);
              var s=Math.max(0,Math.floor((end-now)/1000));
              if(b.length>=3){ b[0].textContent=pad(Math.floor(s/3600)); b[1].textContent=pad(Math.floor((s%3600)/60)); b[2].textContent=pad(s%60); }
            }
            tick(); setInterval(tick,1000);
          });
          /* flash-deals slider arrows (inside) */
          [].slice.call(document.querySelectorAll('.uh-flashslider, .uh-slider')).forEach(function(sl){
            var rail=sl.querySelector('.uh-frail'), prev=sl.querySelector('.uh-fnav.prev'), next=sl.querySelector('.uh-fnav.next');
            if(!rail) return;
            var rtl=getComputedStyle(rail).direction==='rtl';
            function step(back){ rail.scrollBy({left:Math.round(rail.clientWidth*0.85)*((back?-1:1)*(rtl?-1:1)),behavior:'smooth'}); }
            function refresh(){ var sc=(rail.scrollWidth - rail.clientWidth) > 6; if(prev)prev.style.display=sc?'grid':'none'; if(next)next.style.display=sc?'grid':'none'; }
            if(prev) prev.addEventListener('click', function(){ step(true); });
            if(next) next.addEventListener('click', function(){ step(false); });
            refresh(); window.addEventListener('resize', refresh);
          });
          /* infinite random feed — scroll-based, 5 auto batches then Load more */
          var w=document.querySelector('[data-infinite]'); if(!w) return;
          var grid=w.querySelector('.uh-inf-grid'), more=w.querySelector('.uh-inf-more'),
              btn=w.querySelector('.uh-inf-btn'), seed=w.getAttribute('data-seed'), limit=w.getAttribute('data-limit')||12;
          var page=1, autoLeft=5, loading=false, done=false;
          function spin(on){ var s=w.querySelector('.uh-spin'); if(on){ if(!s){ s=document.createElement('div'); s.className='uh-spin'; more.insertBefore(s, btn); } } else if(s){ s.remove(); } }
          function load(){
            if(loading||done) return; loading=true; spin(true);
            fetch('/home-preview/more?seed='+seed+'&amp;page='+page+'&amp;limit='+limit,{credentials:'same-origin'})
              .then(function(r){ return r.text(); })
              .then(function(html){
                spin(false);
                if(!html || !html.trim()){ done=true; if(btn)btn.style.display='none'; loading=false; return; }
                grid.insertAdjacentHTML('beforeend', html); page++; loading=false;
                if(autoLeft>0){ autoLeft--; if(autoLeft===0 &amp;&amp; btn){ btn.style.display='inline-flex'; } }
              })
              .catch(function(){ spin(false); loading=false; });
          }
          function nearBottom(){ return !(w.getBoundingClientRect().bottom > window.innerHeight + 700); }
          function onScroll(){ if(autoLeft>0 &amp;&amp; !loading &amp;&amp; !done &amp;&amp; nearBottom()) load(); }
          window.addEventListener('scroll', onScroll, {passive:true});
          window.addEventListener('resize', onScroll, {passive:true});
          if(btn) btn.addEventListener('click', load);
          onScroll();
        })();
        </script>
      </div>
    </t>
  </template>

</odoo>
