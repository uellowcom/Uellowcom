<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- shared product-card fragment (used by sections AND the /more endpoint) -->
  <template id="home_cards" name="Uellow home product cards">
    <a t-foreach="products" t-as="pr" t-att-href="pr['url']" class="uh-card">
      <div class="uh-thumb">
        <img t-att-src="pr['image']" t-att-alt="pr['name']" loading="lazy" decoding="async" width="256" height="256"/>
        <span t-if="pr['discount']" class="uh-disc">-<t t-esc="pr['discount']"/>%</span>
      </div>
      <div class="uh-name" t-esc="pr['name']"/>
      <div class="uh-price">
        <span class="uh-now"><t t-esc="'%.3f' % pr['price']"/> <t t-esc="pr['currency']"/></span>
        <span t-if="pr['compare']" class="uh-was"><t t-esc="'%.3f' % pr['compare']"/></span>
      </div>
    </a>
  </template>

  <template id="home_preview_page" name="Uellow Homepage (preview)">
    <t t-call="website.layout">
      <t t-set="additional_title" t-value="(page and ((page.meta_title_ar if is_ar else page.meta_title_en) or page.name)) or 'Uellow'"/>
      <div class="uhome" t-att-dir="'rtl' if is_ar else 'ltr'">
        <style>
          .uhome{--ink:#14202b;--muted:#5d6b78;--line:#e7eef3;--bg:#f6fafd;--card:#fff;
            --orange:#F26A2E;--orange2:#d8500f;--sky:#22a7e0;--gold:#F5C320;--red:#E63946;
            background:var(--bg);color:var(--ink);font-family:'Segoe UI',Tahoma,system-ui,sans-serif;line-height:1.5}
          .uhome *{box-sizing:border-box}
          .uh-w{max-width:1100px;margin:0 auto;padding:0 14px}
          .uh-hero{padding-top:10px}
          .uh-sec{position:relative}
          .uh-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}
          .uh-head .t{display:flex;align-items:center;gap:10px;min-width:0}
          .uh-head .bar{width:5px;height:24px;border-radius:3px;background:linear-gradient(var(--orange),var(--orange2));flex:none}
          .uh-head h2{font-size:clamp(17px,2.3vw,22px);font-weight:800;letter-spacing:-.01em;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
          .uh-head p{margin:1px 0 0;color:var(--muted);font-size:12.5px}
          .uh-all{white-space:nowrap;font-size:12.5px;font-weight:800;color:var(--orange2);text-decoration:none;
            border:1px solid var(--line);border-radius:999px;padding:6px 13px;background:var(--card)}
          .uh-all:hover{border-color:var(--orange);color:var(--orange)}
          .uh-rail{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(158px,1fr);gap:12px;
            overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:6px;-webkit-overflow-scrolling:touch}
          .uh-rail::-webkit-scrollbar{height:6px}.uh-rail::-webkit-scrollbar-thumb{background:var(--line);border-radius:6px}
          .uh-grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fill,minmax(158px,1fr))}
          .uh-card{scroll-snap-align:start;background:var(--card);border:1px solid var(--line);border-radius:14px;
            overflow:hidden;text-decoration:none;color:inherit;display:flex;flex-direction:column;transition:box-shadow .15s,transform .15s}
          .uh-card:hover{box-shadow:0 14px 28px -18px rgba(20,50,80,.45);transform:translateY(-3px)}
          .uh-thumb{position:relative;aspect-ratio:1;background:#f2f6f9;overflow:hidden}
          .uh-thumb img{width:100%;height:100%;object-fit:cover;display:block}
          .uh-disc{position:absolute;inset-inline-start:8px;top:8px;background:var(--red);color:#fff;
            font-size:11px;font-weight:800;padding:2px 8px;border-radius:999px}
          .uh-name{padding:9px 10px 2px;font-size:12.5px;font-weight:600;line-height:1.35;
            display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:34px}
          .uh-price{padding:2px 10px 11px;display:flex;align-items:baseline;gap:7px;flex-wrap:wrap;margin-top:auto}
          .uh-now{font-size:14px;font-weight:800;color:var(--ink)}
          .uh-was{font-size:11.5px;color:#9aa7b2;text-decoration:line-through}
          /* flash deals */
          .uh-flash .uh-head .bar{background:linear-gradient(var(--red),#b12633)}
          .uh-flash .uh-head h2::after{content:' 🔥'}
          .uh-flash{background:linear-gradient(180deg,#fff4f1,transparent 60%)}
          /* departments */
          .uh-depts{display:grid;grid-template-columns:repeat(auto-fill,minmax(94px,1fr));gap:12px}
          .uh-dept{display:flex;flex-direction:column;align-items:center;gap:7px;text-decoration:none;color:inherit;
            background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px 8px;transition:.15s}
          .uh-dept:hover{border-color:var(--orange);box-shadow:0 10px 22px -16px rgba(20,50,80,.35);transform:translateY(-2px)}
          .uh-dept .ic{width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#fff2e9,#e7f5fc);
            display:grid;place-items:center;overflow:hidden}
          .uh-dept .ic img{width:100%;height:100%;object-fit:cover}
          .uh-dept .ic span{font-size:22px}
          .uh-dept .nm{font-size:11.5px;font-weight:700;text-align:center;line-height:1.25;
            display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
          /* bonus */
          .uh-bonus{background:linear-gradient(120deg,#fff2e9,#e7f5fc);border:1px solid var(--line);border-radius:18px;
            padding:22px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
          .uh-bonus h3{margin:0;font-size:clamp(18px,2.4vw,24px);font-weight:800}
          .uh-bonus p{margin:4px 0 0;color:var(--muted);font-size:14px}
          .uh-btn{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(120deg,var(--orange),var(--orange2));
            color:#fff;text-decoration:none;font-weight:800;border-radius:12px;padding:12px 22px;font-size:14px;border:0;cursor:pointer}
          .uh-btn:hover{filter:brightness(1.05)}
          .uh-banner img{width:100%;display:block;border-radius:16px}
          /* infinite */
          .uh-inf-sentinel{height:1px}
          .uh-inf-more{text-align:center;margin-top:18px}
          .uh-inf-btn{margin:0 auto}
        </style>

        <t t-foreach="sections" t-as="sec">
          <t t-if="sec['type'] == 'hero_slider'">
            <div class="uh-w uh-hero"><t t-call="uellow_home_slider.uellow_home_slider_block"/></div>
          </t>

          <section t-if="sec['type'] in ('product_row','category_strip','flash_deals')"
                   t-att-class="'uh-sec ' + ('uh-flash' if sec['type']=='flash_deals' else '')"
                   t-att-style="('padding:%dpx 0;' % sec['pad_y']) + (('background:%s;' % sec['bg']) if sec['bg'] else '')">
            <div class="uh-w">
              <div t-if="sec['show_title'] and sec['title']" class="uh-head">
                <div class="t"><span class="bar"/><div><h2 t-esc="sec['title']"/><p t-if="sec['subtitle']" t-esc="sec['subtitle']"/></div></div>
                <a t-if="sec['show_link']" t-att-href="sec['link_url']" class="uh-all"><t t-esc="sec['link_label']"/> →</a>
              </div>
              <div t-att-class="'uh-grid' if sec['style']=='grid' else 'uh-rail'"
                   t-att-style="('grid-template-columns:repeat(%d,1fr)' % sec['columns']) if sec['style']=='grid' else ''">
                <t t-set="products" t-value="sec['products']"/>
                <t t-call="uellow_home_slider.home_cards"/>
              </div>
            </div>
          </section>

          <section t-if="sec['type'] == 'dept_spotlight'" class="uh-sec"
                   t-att-style="('padding:%dpx 0;' % sec['pad_y']) + (('background:%s;' % sec['bg']) if sec['bg'] else '')">
            <div class="uh-w">
              <div t-if="sec['show_title'] and sec['title']" class="uh-head">
                <div class="t"><span class="bar"/><div><h2 t-esc="sec['title']"/><p t-if="sec['subtitle']" t-esc="sec['subtitle']"/></div></div>
              </div>
              <div class="uh-depts">
                <a t-foreach="sec['cats']" t-as="c" t-att-href="c['url']" class="uh-dept">
                  <span class="ic"><img t-if="c['image']" t-att-src="c['image']" t-att-alt="c['name']" loading="lazy" decoding="async" width="52" height="52"/><span t-else="">🛍️</span></span>
                  <span class="nm" t-esc="c['name']"/>
                </a>
              </div>
            </div>
          </section>

          <section t-if="sec['type'] == 'new_user_bonus'" class="uh-sec" t-att-style="'padding:%dpx 0;' % sec['pad_y']">
            <div class="uh-w">
              <div class="uh-bonus">
                <div>
                  <h3 t-esc="sec['title'] or ('مكافأة الترحيب' if is_ar else 'Welcome bonus')"/>
                  <p t-esc="sec['subtitle'] or ('سجّل الآن واحصل على خصم على أول طلب' if is_ar else 'Sign up and get a discount on your first order')"/>
                </div>
                <a class="uh-btn" href="/web/signup"><t t-esc="'انضم الآن' if is_ar else 'Join now'"/></a>
              </div>
            </div>
          </section>

          <section t-if="sec['type'] == 'banner' and sec['image']" class="uh-sec" t-att-style="'padding:%dpx 0;' % sec['pad_y']">
            <div class="uh-w uh-banner"><a t-att-href="sec['link_url']"><img t-att-src="sec['image']" t-att-alt="sec['title'] or 'banner'" loading="lazy" decoding="async"/></a></div>
          </section>

          <section t-if="sec['type'] == 'custom_html' and sec['html']" class="uh-sec" t-att-style="'padding:%dpx 0;' % sec['pad_y']">
            <div class="uh-w"><t t-out="sec['html']"/></div>
          </section>

          <!-- INFINITE random products -->
          <section t-if="sec['type'] == 'infinite_products'" class="uh-sec" t-att-style="'padding:%dpx 0;' % sec['pad_y']">
            <div class="uh-w">
              <div t-if="sec['show_title'] and sec['title']" class="uh-head">
                <div class="t"><span class="bar"/><div><h2 t-esc="sec['title']"/><p t-if="sec['subtitle']" t-esc="sec['subtitle']"/></div></div>
              </div>
              <div class="uh-inf" data-infinite="1" t-att-data-seed="sec['seed']" t-att-data-limit="sec['limit']">
                <div class="uh-grid uh-inf-grid">
                  <t t-set="products" t-value="sec['products']"/>
                  <t t-call="uellow_home_slider.home_cards"/>
                </div>
                <div class="uh-inf-sentinel"></div>
                <div class="uh-inf-more">
                  <button type="button" class="uh-btn uh-inf-btn" style="display:none"><t t-esc="'عرض المزيد' if is_ar else 'Load more'"/></button>
                </div>
              </div>
            </div>
          </section>
        </t>

        <script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"Uellow","url":"https://www.uellow.com/","potentialAction":{"@type":"SearchAction","target":"https://www.uellow.com/shop?search={q}","query-input":"required name=q"}}</script>

        <script>
        (function(){
          var w=document.querySelector('[data-infinite]'); if(!w) return;
          var grid=w.querySelector('.uh-inf-grid'), sen=w.querySelector('.uh-inf-sentinel'),
              btn=w.querySelector('.uh-inf-btn'), seed=w.getAttribute('data-seed'), limit=w.getAttribute('data-limit')||12;
          var page=1, autoLeft=5, loading=false, done=false, obs=null;
          function load(){
            if(loading||done) return; loading=true;
            fetch('/home-preview/more?seed='+seed+'&amp;page='+page+'&amp;limit='+limit,{credentials:'same-origin'})
              .then(function(r){return r.text();})
              .then(function(html){
                if(!html || !html.trim()){ done=true; if(sen)sen.style.display='none'; if(btn)btn.style.display='none'; loading=false; return; }
                grid.insertAdjacentHTML('beforeend', html); page++; loading=false;
                if(autoLeft>0){ autoLeft--; if(autoLeft===0 &amp;&amp; obs){ obs.disconnect(); if(btn)btn.style.display='inline-flex'; } }
              })
              .catch(function(){ loading=false; });
          }
          if('IntersectionObserver' in window){
            obs=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting) load(); }); }, {rootMargin:'400px'});
            obs.observe(sen);
          } else if(btn){ btn.style.display='inline-flex'; }
          if(btn) btn.addEventListener('click', load);
        })();
        </script>
      </div>
    </t>
  </template>

</odoo>
