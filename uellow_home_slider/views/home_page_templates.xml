        <script type="application/ld+json" t-out="structured_data"/>

        <script>
        (function(){
          /* scroll-reveal animations */
          if('IntersectionObserver' in window){
            var secs=[].slice.call(document.querySelectorAll('.uhome .uh-sec'));
            secs.forEach(function(s){ s.classList.add('uh-anim'); });
            var ro=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); ro.unobserve(e.target); } }); }, {rootMargin:'0px 0px -6% 0px'});
            secs.forEach(function(s){ ro.observe(s); });
          }
          /* flash countdown — fixed end date, else daily midnight */
          function pad(n){ return (''+n).padStart(2,'0'); }
          [].slice.call(document.querySelectorAll('[data-countdown]')).forEach(function(el){
            var b=el.querySelectorAll('b');
            var endAttr=el.getAttribute('data-end');
            var daily=el.getAttribute('data-daily')!=='0';
            var fixedEnd=endAttr?(new Date(endAttr)).getTime():0;
            function target(){
              if(fixedEnd){ return fixedEnd; }
              var end=new Date(); end.setHours(24,0,0,0); return end.getTime();
            }
            function tick(){
              var s=Math.max(0,Math.floor((target()-Date.now())/1000));
              if(b.length>=3){ b[0].textContent=pad(Math.floor(s/3600)); b[1].textContent=pad(Math.floor((s%3600)/60)); b[2].textContent=pad(s%60); }
            }
            tick(); setInterval(tick,1000);
          });
          /* flash-deals slider arrows (inside) */
          [].slice.call(document.querySelectorAll('.uh-flashslider, .uh-slider')).forEach(function(sl){
            var rail=sl.querySelector('.uh-frail'), prev=sl.querySelector('.uh-fnav.prev'), next=sl.querySelector('.uh-fnav.next');
            if(!rail) return;
            var rtl=getComputedStyle(rail).direction==='rtl';
            function step(back){ rail.scrollBy({left:Math.round(rail.clientWidth*0.85)*((back?-1:1)*(rtl?-1:1)),behavior:'smooth'}); }
            function refresh(){ var sc=(rail.scrollWidth - rail.clientWidth) > 6; if(prev)prev.style.display=sc?'grid':'none'; if(next)next.style.display=sc?'grid':'none'; }
            if(prev) prev.addEventListener('click', function(){ step(true); });
            if(next) next.addEventListener('click', function(){ step(false); });
            refresh(); window.addEventListener('resize', refresh);
          });
          /* infinite random feed — scroll-based, 5 auto batches then Load more */
          var w=document.querySelector('[data-infinite]'); if(!w) return;
          var grid=w.querySelector('.uh-inf-grid'), more=w.querySelector('.uh-inf-more'),
              btn=w.querySelector('.uh-inf-btn'), seed=w.getAttribute('data-seed'), limit=w.getAttribute('data-limit')||12;
          var page=1, autoLeft=5, loading=false, done=false;
          function spin(on){ var s=w.querySelector('.uh-spin'); if(on){ if(!s){ s=document.createElement('div'); s.className='uh-spin'; more.insertBefore(s, btn); } } else if(s){ s.remove(); } }
          function load(){
            if(loading||done) return; loading=true; spin(true);
            fetch('/home-preview/more?seed='+seed+'&amp;page='+page+'&amp;limit='+limit,{credentials:'same-origin'})
              .then(function(r){ return r.text(); })
              .then(function(html){
                spin(false);
                if(!html || !html.trim()){ done=true; if(btn)btn.style.display='none'; loading=false; return; }
                grid.insertAdjacentHTML('beforeend', html); page++; loading=false;
                if(autoLeft>0){ autoLeft--; if(autoLeft===0 &amp;&amp; btn){ btn.style.display='inline-flex'; } }
              })
              .catch(function(){ spin(false); loading=false; });
          }
          function nearBottom(){ return !(w.getBoundingClientRect().bottom > window.innerHeight + 700); }
          function onScroll(){ if(autoLeft>0 &amp;&amp; !loading &amp;&amp; !done &amp;&amp; nearBottom()) load(); }
          window.addEventListener('scroll', onScroll, {passive:true});
          window.addEventListener('resize', onScroll, {passive:true});
          if(btn) btn.addEventListener('click', load);
          onScroll();
        })();
        </script>
      </div>
    </t>
