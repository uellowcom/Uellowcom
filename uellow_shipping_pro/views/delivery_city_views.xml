<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_city_tree" model="ir.ui.view">
        <field name="name">delivery.city.tree</field>
        <field name="model">delivery.city</field>
        <field name="arch" type="xml">
            <list string="Cities" editable="bottom">
                <field name="name_en"/>
                <field name="name_ar"/>
                <field name="country_id"/>
                <field name="zone_id"/>
                <field name="aliases"/>
                <field name="lat" optional="hide"/>
                <field name="lng" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_delivery_city" model="ir.actions.act_window">
        <field name="name">Cities</field>
        <field name="res_model">delivery.city</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_delivery_city"
              name="Cities" parent="menu_delivery_zone_root"
              action="action_delivery_city" sequence="20"/>
</odoo>
