<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_zone_tree" model="ir.ui.view">
        <field name="name">delivery.zone.tree</field>
        <field name="model">delivery.zone</field>
        <field name="arch" type="xml">
            <list string="Delivery zones" editable="bottom">
                <field name="name_en"/>
                <field name="name_ar"/>
                <field name="country_id"/>
                <field name="governorate"/>
                <field name="tier"/>
                <field name="city_count" string="# cities"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_zone_form" model="ir.ui.view">
        <field name="name">delivery.zone.form</field>
        <field name="model">delivery.zone</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name_en"/>
                            <field name="name_ar"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="governorate"/>
                            <field name="tier"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cities">
                            <field name="city_ids">
                                <list editable="bottom">
                                    <field name="name_en"/>
                                    <field name="name_ar"/>
                                    <field name="aliases"/>
                                    <field name="lat"/>
                                    <field name="lng"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_delivery_zone" model="ir.actions.act_window">
        <field name="name">Delivery zones</field>
        <field name="res_model">delivery.zone</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- v2.1.17 — merged into the Delivery Carrier Portal workspace -->
    <menuitem id="menu_delivery_zone_root"
              name="Zones &amp; Cities"
              parent="delivery_carrier_portal.menu_delivery_portal_root"
              sequence="30"/>
    <menuitem id="menu_delivery_zone"
              name="Delivery zones" parent="menu_delivery_zone_root"
              action="action_delivery_zone" sequence="10"/>
</odoo>
