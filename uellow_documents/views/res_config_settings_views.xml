<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_uellow_docs" model="ir.ui.view">
        <field name="name">res.config.settings.uellow.documents</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Uellow Documents (Invoice &amp; Quotation)"
                       name="uellow_documents_block">
                    <setting string="Delivery terms"
                             help="Shown on the quotation / sales order">
                        <field name="uellow_delivery_terms"/>
                    </setting>
                    <setting string="Warranty terms"
                             help="Shown on the quotation / sales order">
                        <field name="uellow_warranty_terms"/>
                    </setting>
                    <setting string="Returns terms"
                             help="Shown on the quotation / sales order">
                        <field name="uellow_returns_terms"/>
                    </setting>
                    <setting string="Payment terms note">
                        <field name="uellow_payment_terms_note"/>
                    </setting>
                    <setting string="Document footer line">
                        <field name="uellow_doc_footer"/>
                    </setting>
                    <setting string="Bank line (invoice)"
                             help="Optional; leave empty to auto-use the company bank account">
                        <field name="uellow_bank_line"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
