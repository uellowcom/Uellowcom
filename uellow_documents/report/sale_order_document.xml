<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="uellow_saleorder">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc.company_id"/>
                <t t-set="doc" t-value="doc.with_context(lang='en_US')"/>
                <t t-set="is_order" t-value="doc.state in ('sale', 'done')"/>
                <t t-set="ship" t-value="doc.partner_shipping_id or doc.partner_id"/>
                <t t-set="s_conf" t-value="doc.state in ('sale', 'done')"/>
                <t t-set="s_inv" t-value="doc.invoice_status == 'invoiced'"/>
                <t t-set="s_deliv" t-value="doc.state == 'done' or s_inv"/>
                <div class="article udoc" dir="ltr">
                    <style>
                        @font-face { font-family:'Tajawal'; font-weight:normal; src:url('/uellow_documents/static/src/fonts/Tajawal-Regular.ttf') format('truetype'); }
                        @font-face { font-family:'Tajawal'; font-weight:bold; src:url('/uellow_documents/static/src/fonts/Tajawal-Bold.ttf') format('truetype'); }
                        .udoc, .udoc * { font-family:'Tajawal','DejaVu Sans',sans-serif !important; color:#2A1B0A; direction:ltr !important; box-sizing:border-box; }
                        .udoc { font-size:12.5px; }
                        .udoc table { width:100%; border-collapse:collapse; table-layout:fixed; border:0 !important; }
                        .udoc td, .udoc th { border:0 !important; vertical-align:top; }
                        .ar { display:block; font-size:9.5px; font-weight:600; color:#9c8e76 !important; line-height:1.35; }
                        .lbl { font-size:9.5px; font-weight:800; letter-spacing:1.2px; color:#C79A12 !important; text-transform:uppercase; }
                        .card { background:#FBF6EA; border-radius:16px; padding:14px 16px; }
                        .name { font-size:14px; font-weight:800; color:#2A1B0A; margin-top:6px; }
                        .sub { font-size:11px; color:#6f6048; line-height:1.55; margin-top:3px; }
                        .ttl { font-size:30px; font-weight:800; color:#412402; line-height:1; letter-spacing:.5px; }
                        .ttl .ar { font-size:16px; color:#9c8e76 !important; font-weight:700; margin-top:2px; }
                        .items thead td { background:#412402 !important; color:#FFFFFF !important; font-size:10.5px; font-weight:800; letter-spacing:.5px; text-transform:uppercase; padding:12px 12px; }
                        .items thead td .ar { color:#E7D7B8 !important; font-weight:600; }
                        .items tbody td { font-size:12px; padding:11px 12px; border-bottom:1px solid #efe7d6 !important; }
                        .grand td { padding:14px 18px; }
                        .meta td { padding:10px 14px; }
                        .div { border-right:1px solid #efe7d6 !important; }
                        .step { font-size:10px; font-weight:800; color:#2A1B0A; }
                    </style>

                    <div style="height:9px;background-color:#F5C320 !important;border-radius:6px;"/>
                    <div style="padding:8px 4px 4px;">

                        <table><tr>
                            <td style="width:60%;">
                                <table><tr>
                                    <td style="width:150px;vertical-align:middle;">
                                        <img t-if="company.logo" style="max-height:56px;max-width:150px;" t-att-src="image_data_uri(company.logo)"/>
                                    </td>
                                    <td style="vertical-align:middle;padding-left:12px;">
                                        <div style="font-size:19px;font-weight:800;color:#412402;" t-esc="company.name"/>
                                        <div class="sub">
                                            <span t-esc="company.street"/><t t-if="company.city">, <span t-esc="company.city"/></t><br/>
                                            <t t-if="company.country_id"><span t-esc="company.country_id.name"/> · </t><b t-esc="company.phone"/><br/>
                                            <span t-esc="company.email"/>
                                        </div>
                                    </td>
                                </tr></table>
                            </td>
                            <td style="width:40%;text-align:right;">
                                <div class="ttl"><t t-if="is_order">SALES ORDER<span class="ar">أمر بيع</span></t><t t-else="">QUOTATION<span class="ar">عرض سعر</span></t></div>
                                <div style="font-size:12px;color:#6f6048;margin-top:8px;">No. <b style="color:#2A1B0A;" t-esc="doc.name"/></div>
                                <div style="margin-top:8px;">
                                    <span t-if="is_order" style="display:inline-block;background-color:#EAF7EF !important;border:1.5px solid #1f9d55;color:#1f9d55 !important;font-weight:800;padding:4px 13px;border-radius:9px;font-size:11px;letter-spacing:1px;">CONFIRMED · مؤكد</span>
                                    <span t-else="" style="display:inline-block;background-color:#EAF0FE !important;border:1.5px solid #2563EB;color:#2563EB !important;font-weight:800;padding:4px 13px;border-radius:9px;font-size:11px;letter-spacing:1px;">AWAITING · بانتظار التأكيد</span>
                                </div>
                            </td>
                        </tr></table>

                        <!-- FLOW -->
                        <div class="card" style="background-color:#FBF6EA !important;margin-top:16px;box-shadow:0 4px 14px rgba(65,36,2,0.06);">
                            <table><tr>
                                <td style="width:15%;"><table><tr>
                                    <td style="width:30px;"><div style="width:24px;height:24px;border-radius:50%;background-color:#1f9d55 !important;color:#fff !important;text-align:center;line-height:24px;font-weight:800;font-size:12px;">✓</div></td>
                                    <td class="step">Quotation<span class="ar">عرض سعر</span></td></tr></table></td>
                                <td style="width:5%;"><div t-attf-style="height:3px;border-radius:3px;background-color:#{'#1f9d55' if s_conf else '#e2d9c6'} !important;"/></td>
                                <td style="width:15%;"><table><tr>
                                    <td style="width:30px;"><div t-attf-style="width:24px;height:24px;border-radius:50%;background-color:#{'#1f9d55' if s_conf else '#F5C320'} !important;color:#{'#fff' if s_conf else '#412402'} !important;text-align:center;line-height:24px;font-weight:800;font-size:12px;"><t t-if="s_conf">✓</t><t t-else="">2</t></div></td>
                                    <td class="step">Confirmed<span class="ar">مؤكد</span></td></tr></table></td>
                                <td style="width:5%;"><div t-attf-style="height:3px;border-radius:3px;background-color:#{'#1f9d55' if s_deliv else '#e2d9c6'} !important;"/></td>
                                <td style="width:15%;"><table><tr>
                                    <td style="width:30px;"><div t-attf-style="width:24px;height:24px;border-radius:50%;background-color:#{'#1f9d55' if s_deliv else '#cfc6b4'} !important;color:#fff !important;text-align:center;line-height:24px;font-weight:800;font-size:12px;">3</div></td>
                                    <td class="step">Delivered<span class="ar">تم التسليم</span></td></tr></table></td>
                                <td style="width:5%;"><div t-attf-style="height:3px;border-radius:3px;background-color:#{'#1f9d55' if s_inv else '#e2d9c6'} !important;"/></td>
                                <td style="width:15%;"><table><tr>
                                    <td style="width:30px;"><div t-attf-style="width:24px;height:24px;border-radius:50%;background-color:#{'#1f9d55' if s_inv else '#cfc6b4'} !important;color:#fff !important;text-align:center;line-height:24px;font-weight:800;font-size:12px;">4</div></td>
                                    <td class="step">Invoiced<span class="ar">فوترة</span></td></tr></table></td>
                            </tr></table>
                        </div>

                        <!-- PARTIES -->
                        <table style="margin-top:14px;"><tr>
                            <td style="width:32%;"><div class="card" style="background-color:#FBF6EA !important;box-shadow:0 4px 14px rgba(65,36,2,0.06);">
                                <div class="lbl">Customer<span class="ar">العميل</span></div>
                                <div class="name" t-esc="doc.partner_id.name"/>
                                <div class="sub"><t t-if="doc.partner_id.city"><span t-esc="doc.partner_id.city"/><br/></t><t t-if="doc.partner_id.phone"><span t-esc="doc.partner_id.phone"/><br/></t><span t-esc="doc.partner_id.email"/></div></div></td>
                            <td style="width:2%;"/>
                            <td style="width:32%;"><div class="card" style="background-color:#FBF6EA !important;box-shadow:0 4px 14px rgba(65,36,2,0.06);">
                                <div class="lbl">Deliver to<span class="ar">التوصيل</span></div>
                                <div class="name" t-esc="ship.name"/>
                                <div class="sub"><t t-if="ship.street"><span t-esc="ship.street"/><br/></t><t t-if="ship.city"><span t-esc="ship.city"/></t></div></div></td>
                            <td style="width:2%;"/>
                            <td style="width:32%;"><div class="card" style="background-color:#FBF6EA !important;box-shadow:0 4px 14px rgba(65,36,2,0.06);">
                                <div class="lbl">Prepared by<span class="ar">إعداد</span></div>
                                <div class="name" t-esc="doc.user_id.name or company.name"/>
                                <div class="sub"><span t-esc="company.email"/></div></div></td>
                        </tr></table>

                        <!-- META -->
                        <div style="margin-top:14px;border:1px solid #efe7d6;border-radius:14px;overflow:hidden;">
                            <table class="meta"><tr>
                                <td class="div" style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Order date<span class="ar">التاريخ</span></div><div style="font-size:12.5px;font-weight:800;margin-top:3px;" t-field="doc.date_order"/></td>
                                <td class="div" style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Valid until<span class="ar">صالح حتى</span></div><div style="font-size:12.5px;font-weight:800;margin-top:3px;"><span t-if="doc.validity_date" t-field="doc.validity_date"/><t t-else="">—</t></div></td>
                                <td class="div" style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Payment<span class="ar">الدفع</span></div><div style="font-size:11.5px;font-weight:800;margin-top:3px;"><t t-esc="doc.payment_term_id.name or company.uellow_payment_terms_note"/></div></td>
                                <td style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Currency<span class="ar">العملة</span></div><div style="font-size:12.5px;font-weight:800;margin-top:3px;" t-esc="doc.currency_id.name"/></td>
                            </tr></table>
                        </div>

                        <!-- ITEMS -->
                        <div style="margin-top:16px;border-radius:14px;overflow:hidden;border:1px solid #efe7d6;">
                            <table class="items">
                                <thead><tr>
                                    <td style="width:34px;text-align:center;">#</td>
                                    <td>Product<span class="ar">المنتج</span></td>
                                    <td style="width:50px;text-align:center;">Qty</td>
                                    <td style="width:96px;text-align:right;">Unit</td>
                                    <td style="width:60px;text-align:right;">Disc</td>
                                    <td style="width:104px;text-align:right;">Amount</td>
                                </tr></thead>
                                <tbody>
                                    <t t-set="idx" t-value="0"/>
                                    <t t-foreach="doc.order_line.filtered(lambda l: not l.display_type or l.display_type == 'product')" t-as="line">
                                        <t t-set="idx" t-value="idx + 1"/>
                                        <tr t-attf-style="background-color:#{'#FCFAF3' if idx % 2 == 0 else '#FFFFFF'} !important;">
                                            <td style="text-align:center;color:#9c8e76;"><t t-esc="idx"/></td>
                                            <td style="vertical-align:middle;"><table><tr>
                                                <td style="width:40px;"><img t-if="line.product_id.image_128" style="width:34px;height:34px;border-radius:8px;" t-att-src="image_data_uri(line.product_id.image_128)"/></td>
                                                <td style="padding-left:8px;font-weight:800;" t-esc="line.product_id.display_name or line.name"/>
                                            </tr></table></td>
                                            <td style="text-align:center;font-weight:700;"><t t-esc="int(line.product_uom_qty)"/></td>
                                            <td style="text-align:right;font-weight:700;"><span t-field="line.price_unit" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></td>
                                            <td style="text-align:right;font-weight:700;color:#1f9d55;"><t t-if="line.discount"><t t-esc="int(line.discount)"/>%</t><t t-else="">—</t></td>
                                            <td style="text-align:right;font-weight:800;"><span t-field="line.price_subtotal" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- BOTTOM -->
                        <table style="margin-top:18px;"><tr>
                            <td style="width:55%;">
                                <div class="card" style="background-color:#FBF6EA !important;box-shadow:0 4px 14px rgba(65,36,2,0.06);">
                                    <div class="lbl">Terms &amp; delivery<span class="ar">الشروط والتسليم</span></div>
                                    <table style="margin-top:8px;">
                                        <tr><td style="font-size:11px;color:#6f6048;padding:4px 0;">Delivery · التسليم</td><td style="text-align:right;font-weight:800;font-size:11px;" t-esc="company.uellow_delivery_terms"/></tr>
                                        <tr><td style="font-size:11px;color:#6f6048;padding:4px 0;">Payment · الدفع</td><td style="text-align:right;font-weight:800;font-size:11px;" t-esc="company.uellow_payment_terms_note"/></tr>
                                        <tr><td style="font-size:11px;color:#6f6048;padding:4px 0;">Warranty · الضمان</td><td style="text-align:right;font-weight:800;font-size:11px;" t-esc="company.uellow_warranty_terms"/></tr>
                                        <tr><td style="font-size:11px;color:#6f6048;padding:4px 0;">Returns · الإرجاع</td><td style="text-align:right;font-weight:800;font-size:11px;" t-esc="company.uellow_returns_terms"/></tr>
                                    </table>
                                </div>
                            </td>
                            <td style="width:3%;"/>
                            <td style="width:42%;">
                                <table style="margin-bottom:4px;">
                                    <tr><td style="font-size:12.5px;color:#6f6048;padding:5px 2px;">Subtotal<span class="ar">الفرعي</span></td><td style="text-align:right;font-weight:800;font-size:12.5px;"><span t-field="doc.amount_untaxed" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></td></tr>
                                    <tr><td style="font-size:12.5px;color:#6f6048;padding:5px 2px;">Tax<span class="ar">الضريبة</span></td><td style="text-align:right;font-weight:800;font-size:12.5px;"><span t-field="doc.amount_tax" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></td></tr>
                                </table>
                                <table class="grand" style="background-color:#F5C320 !important;border-radius:14px;"><tr>
                                    <td style="color:#412402 !important;font-weight:800;font-size:14px;">TOTAL<span class="ar" style="color:#6b4a12 !important;">الإجمالي</span></td>
                                    <td style="text-align:right;color:#412402 !important;font-weight:800;font-size:24px;"><span t-field="doc.amount_total" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></td>
                                </tr></table>
                            </td>
                        </tr></table>

                        <!-- ACCEPTANCE -->
                        <table style="margin-top:16px;"><tr>
                            <td style="width:49%;"><div style="border:1.5px dashed #d9cdb4;border-radius:14px;padding:14px;">
                                <div class="lbl" style="color:#412402 !important;">Customer acceptance<span class="ar">موافقة العميل</span></div>
                                <div style="margin-top:30px;border-top:1.5px solid #efe7d6;padding-top:6px;font-size:9.5px;color:#9c8e76;">Signature &amp; date · التوقيع والتاريخ</div></div></td>
                            <td style="width:2%;"/>
                            <td style="width:49%;"><div style="border:1.5px dashed #d9cdb4;border-radius:14px;padding:14px;">
                                <div class="lbl" style="color:#412402 !important;">For <t t-esc="company.name"/><span class="ar">عن الشركة</span></div>
                                <div style="margin-top:30px;border-top:1.5px solid #efe7d6;padding-top:6px;font-size:9.5px;color:#9c8e76;">Authorized signature · التوقيع المعتمد</div></div></td>
                        </tr></table>

                        <!-- CTA + FOOTER -->
                        <div style="margin-top:14px;background-color:#412402 !important;border-radius:14px;padding:13px 18px;">
                            <table><tr>
                                <td style="color:#E7D7B8 !important;font-size:11px;">Confirm in one tap from the app · <b style="color:#F5C320 !important;">أكّد الطلب من التطبيق بضغطة واحدة</b></td>
                                <td style="width:130px;text-align:right;"><span style="background-color:#F5C320 !important;color:#412402 !important;font-weight:800;font-size:11px;padding:8px 16px;border-radius:9px;">Confirm · تأكيد</span></td>
                            </tr></table>
                        </div>
                        <div style="margin-top:10px;text-align:center;font-size:9.5px;color:#9c8e76;"><t t-esc="company.uellow_doc_footer"/> · <t t-esc="company.website or 'uellow.com'"/></div>

                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="report_name">uellow_documents.uellow_saleorder</field>
        <field name="report_file">uellow_documents.uellow_saleorder</field>
        <field name="paperformat_id" ref="uellow_documents.paperformat_uellow_doc"/>
    </record>
</odoo>
