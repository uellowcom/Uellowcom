<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="uellow_saleorder">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc.company_id"/>
                <t t-set="doc" t-value="doc.with_context(lang='en_US')"/>
                <t t-set="is_order" t-value="doc.state in ('sale', 'done')"/>
                <t t-set="ship" t-value="doc.partner_shipping_id or doc.partner_id"/>
                <t t-set="s_conf" t-value="doc.state in ('sale', 'done')"/>
                <t t-set="s_inv" t-value="doc.invoice_status == 'invoiced'"/>
                <t t-set="s_deliv" t-value="doc.state == 'done' or s_inv"/>
                <t t-set="war_pol" t-value="doc.env['uellow.warranty.policy'].sudo().search([('is_default','=',True)], limit=1)"/>
                <div class="article udoc" dir="ltr">
                    <style>
                        @font-face { font-family:'Tajawal'; font-weight:normal; src:url('/uellow_documents/static/src/fonts/Tajawal-Regular.ttf') format('truetype'); }
                        @font-face { font-family:'Tajawal'; font-weight:bold; src:url('/uellow_documents/static/src/fonts/Tajawal-Bold.ttf') format('truetype'); }
                        .udoc, .udoc * { font-family:'Tajawal','DejaVu Sans',sans-serif !important; color:#2A1B0A; direction:ltr !important; box-sizing:border-box; }
                        .udoc { font-size:18.7px; }
                        .udoc table { width:100%; border-collapse:separate; border-spacing:0; table-layout:fixed; border:0 !important; }
                        .udoc table, .udoc tr, .udoc td, .udoc th { border:0 !important; border-collapse:separate; vertical-align:top; }
                        .ar { display:inline; margin-left:5px; font-size:14.3px; font-weight:600; color:#9c8e76 !important; line-height:1.35; }
                        .lbl { font-size:14.3px; font-weight:800; letter-spacing:1.2px; color:#C79A12 !important; text-transform:uppercase; }
                        .card { background:#FBF6EA; border-radius:16px; padding:14px 16px; }
                        .name { font-size:21.0px; font-weight:800; color:#2A1B0A; margin-top:6px; }
                        .sub { font-size:16.6px; color:#6f6048; line-height:1.55; margin-top:3px; }
                        .ttl { font-size:33px; font-weight:800; color:#412402; line-height:1; letter-spacing:.5px; }
                        .ttl .ar { display:block; margin-left:0; font-size:17px; color:#9c8e76 !important; font-weight:700; margin-top:2px; }
                        .items thead td { background:#412402 !important; color:#FFFFFF !important; font-size:15.7px; font-weight:800; letter-spacing:.5px; text-transform:uppercase; padding:12px 12px; }
                        .items thead td .ar { color:#E7D7B8 !important; font-weight:600; }
                        .items tbody td { font-size:18.0px; padding:11px 12px;  }
                        .grand td { padding:14px 18px; }
                        .meta td { padding:10px 14px; }
                        .div { } .grand .ar{display:block !important;margin-left:0;}
                        .step { font-size:13.0px; font-weight:800; color:#2A1B0A; text-align:center; }
                        .step .ar { display:inline; margin-left:4px; font-size:11.5px; color:#9c8e76 !important; }
                        .dot { width:30px; height:30px; border-radius:50%; text-align:center; line-height:30px; font-weight:800; font-size:15px; margin:0 auto; }
                        .bar { height:4px; border-radius:3px; }
                        .step { font-size:15.0px; font-weight:800; color:#2A1B0A; }
                    </style>
                    <div style="padding:8px 4px 4px;">

                        <table><tr>
                            <td style="width:60%;">
                                <table><tr>
                                    <td style="width:150px;vertical-align:middle;">
                                        <img t-if="company.logo" style="max-height:56px;max-width:150px;" t-att-src="image_data_uri(company.logo)"/>
                                    </td>
                                    <td style="vertical-align:middle;padding-left:12px;">
                                        <div style="font-size:28.6px;font-weight:800;color:#412402;" t-esc="company.name"/>
                                        <div class="sub">
                                            <span t-esc="company.street"/><t t-if="company.city">, <span t-esc="company.city"/></t><br/>
                                            <t t-if="company.country_id"><span t-esc="company.country_id.name"/> · </t><b t-esc="company.phone"/><br/>
                                            <span t-esc="company.email"/>
                                        </div>
                                    </td>
                                </tr></table>
                            </td>
                            <td style="width:40%;text-align:right;">
                                <div class="ttl"><t t-if="is_order">SALES ORDER<span class="ar">أمر بيع</span></t><t t-else="">QUOTATION<span class="ar">عرض سعر</span></t></div>
                                <div style="font-size:18.0px;color:#6f6048;margin-top:8px;">No. <b style="color:#2A1B0A;" t-esc="doc.name"/></div>
                                <div style="margin-top:8px;">
                                    <span t-if="is_order" style="display:inline-block;background-color:#EAF7EF !important;border:1.5px solid #1f9d55;color:#1f9d55 !important;font-weight:800;padding:4px 13px;border-radius:9px;font-size:16.6px;letter-spacing:1px;">CONFIRMED · مؤكد</span>
                                    <span t-else="" style="display:inline-block;background-color:#EAF0FE !important;border:1.5px solid #2563EB;color:#2563EB !important;font-weight:800;padding:4px 13px;border-radius:9px;font-size:16.6px;letter-spacing:1px;">AWAITING · بانتظار التأكيد</span>
                                </div>
                            </td>
                        </tr></table>

                        <!-- FLOW -->
                        <div class="card" style="background-color:#FBF6EA !important;margin-top:16px;padding:16px 18px;">
                            <table>
                                <tr>
                                    <td style="width:20%;"><div class="dot" style="background-color:#1f9d55 !important;color:#fff !important;box-shadow:0 0 0 5px rgba(31,157,85,0.16);">✓</div></td>
                                    <td style="width:6%;vertical-align:middle;"><div class="bar" t-attf-style="background-color:#{'#1f9d55' if s_conf else '#e2d9c6'} !important;"/></td>
                                    <td style="width:20%;"><div class="dot" t-attf-style="background-color:#{'#1f9d55' if s_conf else '#F5C320'} !important;color:#{'#fff' if s_conf else '#412402'} !important;box-shadow:0 0 0 5px rgba(#{'31,157,85' if s_conf else '245,195,32'},0.18);"><t t-if="s_conf">✓</t><t t-else="">2</t></div></td>
                                    <td style="width:6%;vertical-align:middle;"><div class="bar" t-attf-style="background-color:#{'#1f9d55' if s_deliv else '#e2d9c6'} !important;"/></td>
                                    <td style="width:20%;"><div class="dot" t-attf-style="background-color:#{'#1f9d55' if s_deliv else '#cfc6b4'} !important;color:#fff !important;box-shadow:0 0 0 5px rgba(31,157,85,0.16);">3</div></td>
                                    <td style="width:6%;vertical-align:middle;"><div class="bar" t-attf-style="background-color:#{'#1f9d55' if s_inv else '#e2d9c6'} !important;"/></td>
                                    <td style="width:20%;"><div class="dot" t-attf-style="background-color:#{'#1f9d55' if s_inv else '#cfc6b4'} !important;color:#fff !important;box-shadow:0 0 0 5px rgba(31,157,85,0.16);">4</div></td>
                                </tr>
                                <tr>
                                    <td class="step" style="padding-top:7px;">Quotation<span class="ar">عرض سعر</span></td><td/>
                                    <td class="step" style="padding-top:7px;">Confirmed<span class="ar">مؤكد</span></td><td/>
                                    <td class="step" style="padding-top:7px;">Delivered<span class="ar">تم التسليم</span></td><td/>
                                    <td class="step" style="padding-top:7px;">Invoiced<span class="ar">فوترة</span></td>
                                </tr>
                            </table>
                        </div>

                        <!-- PARTIES -->
                        <table style="margin-top:14px;"><tr>
                            <td style="width:32%;"><div class="card" style="background-color:#FBF6EA !important;min-height:132px;">
                                <div class="lbl">Customer<span class="ar">العميل</span></div>
                                <div class="name" t-esc="doc.partner_id.name"/>
                                <div class="sub"><t t-if="doc.partner_id.city"><span t-esc="doc.partner_id.city"/><br/></t><t t-if="doc.partner_id.phone"><span t-esc="doc.partner_id.phone"/><br/></t><span t-esc="doc.partner_id.email"/></div></div></td>
                            <td style="width:2%;"/>
                            <td style="width:32%;"><div class="card" style="background-color:#FBF6EA !important;min-height:132px;">
                                <div class="lbl">Deliver to<span class="ar">التوصيل</span></div>
                                <div class="name" t-esc="ship.name"/>
                                <div class="sub"><t t-if="ship.street"><span t-esc="ship.street"/><br/></t><t t-if="ship.city"><span t-esc="ship.city"/></t></div></div></td>
                            <td style="width:2%;"/>
                            <td style="width:32%;"><div class="card" style="background-color:#FBF6EA !important;min-height:132px;">
                                <div class="lbl">Prepared by<span class="ar">إعداد</span></div>
                                <div class="name" t-esc="doc.user_id.name or company.name"/>
                                <div class="sub"><span t-esc="company.email"/></div></div></td>
                        </tr></table>

                        <!-- META -->
                        <div style="margin-top:14px;border-radius:14px;background-color:#FBF6EA !important;">
                            <table class="meta"><tr>
                                <td class="div" style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Order date<span class="ar">التاريخ</span></div><div style="font-size:18.7px;font-weight:800;margin-top:3px;" t-field="doc.date_order"/></td>
                                <td class="div" style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Valid until<span class="ar">صالح حتى</span></div><div style="font-size:18.7px;font-weight:800;margin-top:3px;"><span t-if="doc.validity_date" t-field="doc.validity_date"/><t t-else="">—</t></div></td>
                                <td class="div" style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Payment<span class="ar">الدفع</span></div><div style="font-size:17.3px;font-weight:800;margin-top:3px;"><t t-esc="doc.payment_term_id.name or company.uellow_payment_terms_note"/></div></td>
                                <td style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Currency<span class="ar">العملة</span></div><div style="font-size:18.7px;font-weight:800;margin-top:3px;" t-esc="doc.currency_id.name"/></td>
                            </tr></table>
                        </div>

                        <!-- ITEMS -->
                        <div style="margin-top:16px;border-radius:14px;">
                            <table class="items">
                                <thead><tr>
                                    <td style="width:40px;text-align:center;">#</td>
                                    <td>Product<span class="ar">المنتج</span></td>
                                    <td style="width:64px;text-align:center;">Qty</td>
                                    <td style="width:130px;text-align:right;">Unit</td>
                                    <td style="width:72px;text-align:right;">Disc</td>
                                    <td style="width:140px;text-align:right;">Amount</td>
                                </tr></thead>
                                <tbody>
                                    <t t-set="idx" t-value="0"/>
                                    <t t-foreach="doc.order_line.filtered(lambda l: not l.display_type or l.display_type == 'product')" t-as="line">
                                        <t t-set="idx" t-value="idx + 1"/>
                                        <tr t-attf-style="background-color:#{'#FCFAF3' if idx % 2 == 0 else '#FFFFFF'} !important;">
                                            <td style="text-align:center;color:#9c8e76;"><t t-esc="idx"/></td>
                                            <td style="vertical-align:middle;"><table><tr>
                                                <td style="width:40px;"><img t-if="line.product_id.image_128" style="width:34px;height:34px;border-radius:8px;" t-att-src="image_data_uri(line.product_id.image_128)"/></td>
                                                <td style="padding-left:8px;font-weight:800;" t-esc="line.product_id.display_name or line.name"/>
                                            </tr></table></td>
                                            <td style="text-align:center;font-weight:700;"><t t-esc="int(line.product_uom_qty)"/></td>
                                            <td style="text-align:right;font-weight:700;"><span t-field="line.price_unit" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></td>
                                            <td style="text-align:right;font-weight:700;color:#1f9d55;"><t t-if="line.discount"><t t-esc="int(line.discount)"/>%</t><t t-else="">—</t></td>
                                            <td style="text-align:right;font-weight:800;"><span t-field="line.price_subtotal" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- BOTTOM -->
                        <table style="margin-top:18px;"><tr>
                            <td style="width:55%;">
                                <div class="card" style="background-color:#FBF6EA !important;">
                                    <div class="lbl">Terms &amp; delivery<span class="ar">الشروط والتسليم</span></div>
                                    <table style="margin-top:8px;">
                                        <tr><td style="font-size:16.6px;color:#6f6048;padding:4px 0;">Delivery · التسليم</td><td style="text-align:right;font-weight:800;font-size:16.6px;"><t t-if="doc.commitment_date"><span t-field="doc.commitment_date" t-options="{'widget': 'date'}"/></t><t t-elif="doc.expected_date"><span t-field="doc.expected_date" t-options="{'widget': 'date'}"/></t><t t-else="" t-esc="company.uellow_delivery_terms"/></td></tr>
                                        <tr><td style="font-size:16.6px;color:#6f6048;padding:4px 0;">Payment · الدفع</td><td style="text-align:right;font-weight:800;font-size:16.6px;"><t t-esc="doc.payment_term_id.name or company.uellow_payment_terms_note"/></td></tr>
                                        <tr><td style="font-size:16.6px;color:#6f6048;padding:4px 0;">Warranty · الضمان</td><td style="text-align:right;font-weight:800;font-size:16.6px;"><t t-if="war_pol"><t t-esc="war_pol.duration_months"/> months · <t t-esc="war_pol.name"/></t><t t-else="" t-esc="company.uellow_warranty_terms"/></td></tr>
                                        <tr><td style="font-size:16.6px;color:#6f6048;padding:4px 0;">Returns · الإرجاع</td><td style="text-align:right;font-weight:800;font-size:16.6px;" t-esc="company.uellow_returns_terms"/></tr>
                                    </table>
                                </div>
                            </td>
                            <td style="width:3%;"/>
                            <td style="width:42%;">
                                <table style="margin-bottom:4px;">
                                    <tr><td style="font-size:18.7px;color:#6f6048;padding:5px 2px;">Subtotal<span class="ar">الفرعي</span></td><td style="text-align:right;font-weight:800;font-size:18.7px;"><span t-field="doc.amount_untaxed" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></td></tr>
                                    <tr t-if="doc.amount_tax"><td style="font-size:18.7px;color:#6f6048;padding:5px 2px;">Charges<span class="ar">رسوم</span></td><td style="text-align:right;font-weight:800;font-size:18.7px;"><span t-field="doc.amount_tax" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></td></tr>
                                </table>
                                <table class="grand" style="background-color:#F5C320 !important;border-radius:14px;"><tr>
                                    <td style="color:#412402 !important;font-weight:800;font-size:21.0px;">TOTAL<span class="ar" style="color:#6b4a12 !important;">الإجمالي</span></td>
                                    <td style="text-align:right;color:#412402 !important;font-weight:800;font-size:36.0px;"><span t-field="doc.amount_total" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></td>
                                </tr></table>
                            </td>
                        </tr></table>

                        <!-- ACCEPTANCE -->
                        <table style="margin-top:16px;"><tr>
                            <td style="width:49%;"><div style="background-color:#FBF6EA !important;border-radius:14px;padding:14px;">
                                <div class="lbl" style="color:#412402 !important;">Customer acceptance<span class="ar">موافقة العميل</span></div>
                                <div style="margin-top:30px;border-top:1.5px solid #efe7d6;padding-top:6px;font-size:14.3px;color:#9c8e76;">Signature &amp; date · التوقيع والتاريخ</div></div></td>
                            <td style="width:2%;"/>
                            <td style="width:49%;"><div style="background-color:#FBF6EA !important;border-radius:14px;padding:14px;">
                                <div class="lbl" style="color:#412402 !important;">For <t t-esc="company.name"/><span class="ar">عن الشركة</span></div>
                                <div style="margin-top:30px;border-top:1.5px solid #efe7d6;padding-top:6px;font-size:14.3px;color:#9c8e76;">Authorized signature · التوقيع المعتمد</div></div></td>
                        </tr></table>

                        <!-- NOTE BAND -->
                        <div style="margin-top:14px;background-color:#412402 !important;border-radius:14px;padding:13px 18px;">
                            <table><tr>
                                <td t-if="not is_order" style="color:#E7D7B8 !important;font-size:16.6px;">This quotation is valid until <b style="color:#F5C320 !important;"><span t-if="doc.validity_date" t-field="doc.validity_date" t-options="{'widget':'date'}"/><t t-else="">the date above</t></b> · هذا العرض ساري حتى التاريخ الموضّح</td>
                                <td t-else="" style="color:#E7D7B8 !important;font-size:16.6px;">Thank you for your order — we'll keep you updated. · <b style="color:#F5C320 !important;">شكرًا لطلبك — سنوافيك بكل التحديثات</b></td>
                            </tr></table>
                        </div>
                        <div style="margin-top:10px;text-align:center;font-size:14.3px;color:#9c8e76;"><b style="color:#6f6048;"><t t-esc="company.name"/></b> · <t t-esc="company.street"/><t t-if="company.city">, <t t-esc="company.city"/></t> · <t t-esc="company.phone"/> · <t t-esc="company.website or company.email"/></div>

                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="report_name">uellow_documents.uellow_saleorder</field>
        <field name="report_file">uellow_documents.uellow_saleorder</field>
        <field name="paperformat_id" ref="uellow_documents.paperformat_uellow_doc"/>
    </record>
</odoo>
