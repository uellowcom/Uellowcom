<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="uellow_delivery">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <t t-set="cur" t-value="o.company_id.currency_id"/>
                <t t-set="o" t-value="o.with_context(lang='en_US')"/>
                <t t-set="done" t-value="o.state == 'done'"/>
                <div class="article udoc" dir="ltr">
                    <style>
                        @font-face { font-family:'Tajawal'; font-weight:normal; src:url('/uellow_documents/static/src/fonts/Tajawal-Regular.ttf') format('truetype'); }
                        @font-face { font-family:'Tajawal'; font-weight:bold; src:url('/uellow_documents/static/src/fonts/Tajawal-Bold.ttf') format('truetype'); }
                        .udoc, .udoc * { font-family:'Tajawal','DejaVu Sans',sans-serif !important; color:#2A1B0A; direction:ltr !important; box-sizing:border-box; }
                        .udoc { font-size:12.5px; }
                        .udoc table { width:100%; border-collapse:collapse; table-layout:fixed; border:0 !important; }
                        .udoc td, .udoc th { border:0 !important; vertical-align:top; }
                        .ar { display:block; font-size:9.5px; font-weight:600; color:#9c8e76 !important; line-height:1.35; }
                        .lbl { font-size:9.5px; font-weight:800; letter-spacing:1.2px; color:#C79A12 !important; text-transform:uppercase; }
                        .card { background:#FBF6EA; border-radius:16px; padding:14px 16px; }
                        .name { font-size:14px; font-weight:800; color:#2A1B0A; margin-top:6px; }
                        .sub { font-size:11px; color:#6f6048; line-height:1.55; margin-top:3px; }
                        .ttl { font-size:29px; font-weight:800; color:#412402; line-height:1; letter-spacing:.5px; }
                        .ttl .ar { font-size:16px; color:#9c8e76 !important; font-weight:700; margin-top:2px; }
                        .items thead td { background:#412402 !important; color:#FFFFFF !important; font-size:10.5px; font-weight:800; letter-spacing:.5px; text-transform:uppercase; padding:12px 12px; }
                        .items thead td .ar { color:#E7D7B8 !important; font-weight:600; }
                        .items tbody td { font-size:12px; padding:11px 12px; border-bottom:1px solid #efe7d6 !important; }
                        .meta td { padding:10px 14px; }
                        .div { border-right:1px solid #efe7d6 !important; }
                    </style>

                    <div style="height:9px;background-color:#F5C320 !important;border-radius:6px;"/>
                    <div style="padding:8px 4px 4px;">

                        <table><tr>
                            <td style="width:60%;">
                                <table><tr>
                                    <td style="width:150px;vertical-align:middle;">
                                        <img t-if="company.logo" style="max-height:56px;max-width:150px;" t-att-src="image_data_uri(company.logo)"/>
                                    </td>
                                    <td style="vertical-align:middle;padding-left:12px;">
                                        <div style="font-size:19px;font-weight:800;color:#412402;" t-esc="company.name"/>
                                        <div class="sub">
                                            <span t-esc="company.street"/><t t-if="company.city">, <span t-esc="company.city"/></t><br/>
                                            <b t-esc="company.phone"/> · <span t-esc="company.email"/>
                                        </div>
                                    </td>
                                </tr></table>
                            </td>
                            <td style="width:40%;text-align:right;">
                                <div class="ttl">DELIVERY NOTE<span class="ar">سند تسليم</span></div>
                                <div style="font-size:12px;color:#6f6048;margin-top:8px;">No. <b style="color:#2A1B0A;" t-esc="o.name"/></div>
                                <div style="margin-top:8px;">
                                    <span t-if="done" style="display:inline-block;background-color:#EAF7EF !important;border:1.5px solid #1f9d55;color:#1f9d55 !important;font-weight:800;padding:4px 13px;border-radius:9px;font-size:11px;letter-spacing:1px;">DONE · تم التسليم</span>
                                    <span t-else="" style="display:inline-block;background-color:#EAF0FE !important;border:1.5px solid #2563EB;color:#2563EB !important;font-weight:800;padding:4px 13px;border-radius:9px;font-size:11px;letter-spacing:1px;">READY · جاهز</span>
                                </div>
                            </td>
                        </tr></table>

                        <table style="margin-top:16px;"><tr>
                            <td style="width:32%;"><div class="card" style="background-color:#FBF6EA !important;box-shadow:0 4px 14px rgba(65,36,2,0.06);">
                                <div class="lbl">From<span class="ar">من</span></div>
                                <div class="name" t-esc="o.picking_type_id.warehouse_id.name or company.name"/>
                                <div class="sub" t-esc="o.location_id.complete_name"/></div></td>
                            <td style="width:2%;"/>
                            <td style="width:32%;"><div class="card" style="background-color:#FFF4D6 !important;box-shadow:0 4px 14px rgba(65,36,2,0.06);">
                                <div class="lbl">Deliver to<span class="ar">التوصيل إلى</span></div>
                                <div class="name" t-esc="o.partner_id.name"/>
                                <div class="sub"><t t-if="o.partner_id.street"><span t-esc="o.partner_id.street"/><br/></t><t t-if="o.partner_id.city"><span t-esc="o.partner_id.city"/><br/></t><t t-if="o.partner_id.phone"><span t-esc="o.partner_id.phone"/></t></div></div></td>
                            <td style="width:2%;"/>
                            <td style="width:32%;"><div class="card" style="background-color:#FBF6EA !important;box-shadow:0 4px 14px rgba(65,36,2,0.06);">
                                <div class="lbl">Carrier<span class="ar">الناقل</span></div>
                                <div class="name" t-esc="(o.carrier_id.name or '—')"/>
                                <div class="sub"><t t-if="o.carrier_tracking_ref">Tracking: <span t-esc="o.carrier_tracking_ref"/></t></div></div></td>
                        </tr></table>

                        <div style="margin-top:14px;border:1px solid #efe7d6;border-radius:14px;overflow:hidden;">
                            <table class="meta"><tr>
                                <td class="div" style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Scheduled<span class="ar">الموعد</span></div><div style="font-size:12px;font-weight:800;margin-top:3px;" t-field="o.scheduled_date"/></td>
                                <td class="div" style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Source<span class="ar">المصدر</span></div><div style="font-size:12px;font-weight:800;margin-top:3px;"><t t-esc="o.origin or '—'"/></div></td>
                                <td class="div" style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Operation<span class="ar">العملية</span></div><div style="font-size:11.5px;font-weight:800;margin-top:3px;" t-esc="o.picking_type_id.name"/></td>
                                <td style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Lines<span class="ar">البنود</span></div><div style="font-size:12.5px;font-weight:800;margin-top:3px;" t-esc="len(o.move_ids)"/></td>
                            </tr></table>
                        </div>

                        <div style="margin-top:16px;border-radius:14px;overflow:hidden;border:1px solid #efe7d6;">
                            <table class="items">
                                <thead><tr>
                                    <td style="width:34px;text-align:center;">#</td>
                                    <td>Product<span class="ar">المنتج</span></td>
                                    <td style="width:80px;text-align:center;">Ordered</td>
                                    <td style="width:80px;text-align:center;">Delivered</td>
                                    <td style="width:130px;text-align:center;">Lot / Serial</td>
                                </tr></thead>
                                <tbody>
                                    <t t-set="idx" t-value="0"/>
                                    <t t-foreach="o.move_ids" t-as="m">
                                        <t t-set="idx" t-value="idx + 1"/>
                                        <tr t-attf-style="background-color:#{'#FCFAF3' if idx % 2 == 0 else '#FFFFFF'} !important;">
                                            <td style="text-align:center;color:#9c8e76;"><t t-esc="idx"/></td>
                                            <td style="font-weight:800;" t-esc="m.product_id.display_name"/>
                                            <td style="text-align:center;font-weight:700;"><t t-esc="int(m.product_uom_qty)"/></td>
                                            <td style="text-align:center;font-weight:800;color:#1f9d55;"><t t-esc="int(m.quantity)"/></td>
                                            <td style="text-align:center;"><t t-esc="', '.join(m.move_line_ids.mapped('lot_id.name')) or '—'"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <div t-if="o.payment_method == 'cod' and o.cod_amount" style="margin-top:14px;background-color:#FFF6D6 !important;border-radius:14px;padding:13px 18px;">
                            <table><tr>
                                <td style="font-weight:800;color:#412402;font-size:13px;">COD to collect · مبلغ الدفع عند الاستلام</td>
                                <td style="text-align:right;font-weight:800;color:#412402;font-size:20px;"><span t-esc="'%.3f' % o.cod_amount"/> <t t-esc="cur.symbol or cur.name"/></td>
                            </tr></table>
                        </div>

                        <table style="margin-top:16px;"><tr>
                            <td style="width:48%;">
                                <div class="card" style="background-color:#FBF6EA !important;box-shadow:0 4px 14px rgba(65,36,2,0.06);">
                                    <table><tr>
                                        <td style="width:88px;vertical-align:middle;"><img style="width:82px;height:82px;" t-att-src="'/report/barcode?barcode_type=QR&amp;value=%s&amp;width=170&amp;height=170' % (o.carrier_tracking_ref or o.name)"/></td>
                                        <td style="vertical-align:middle;padding-left:12px;">
                                            <div class="lbl">Scan<span class="ar">المسح</span></div>
                                            <div class="sub" style="margin-top:5px;"><b>Ref#</b> <t t-esc="o.name"/><t t-if="o.carrier_tracking_ref"><br/><b>Tracking</b> <t t-esc="o.carrier_tracking_ref"/></t></div>
                                        </td>
                                    </tr></table>
                                </div>
                            </td>
                            <td style="width:4%;"/>
                            <td style="width:48%;"><div style="border:1.5px dashed #d9cdb4;border-radius:14px;padding:14px;min-height:96px;">
                                <div class="lbl" style="color:#412402 !important;">Received in good condition<span class="ar">استُلمت بحالة جيدة</span></div>
                                <div style="margin-top:34px;border-top:1.5px solid #efe7d6;padding-top:6px;font-size:9.5px;color:#9c8e76;">Receiver name &amp; signature · اسم وتوقيع المستلم — التاريخ</div>
                            </div></td>
                        </tr></table>

                        <div style="margin-top:16px;background-color:#412402 !important;border-radius:14px;padding:14px 18px;">
                            <table><tr>
                                <td style="color:#FFFFFF !important;font-weight:800;font-size:13px;"><t t-esc="company.uellow_doc_footer"/></td>
                                <td style="text-align:right;color:#E7D7B8 !important;font-size:10.5px;"><t t-esc="company.website or 'uellow.com'"/> · <b style="color:#F5C320 !important;" t-esc="company.phone"/></td>
                            </tr></table>
                        </div>

                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="stock.action_report_delivery" model="ir.actions.report">
        <field name="report_name">uellow_documents.uellow_delivery</field>
        <field name="report_file">uellow_documents.uellow_delivery</field>
        <field name="paperformat_id" ref="uellow_documents.paperformat_uellow_doc"/>
    </record>
</odoo>
