<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="uellow_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <t t-set="o" t-value="o.with_context(lang='en_US')"/>
                <t t-set="paid" t-value="o.payment_state in ('paid', 'in_payment', 'reversed')"/>
                <t t-set="ship" t-value="o.partner_shipping_id or o.partner_id"/>
                <div class="article udoc" dir="ltr">
                    <style>
                        @font-face { font-family:'Tajawal'; font-weight:normal; src:url('/uellow_documents/static/src/fonts/Tajawal-Regular.ttf') format('truetype'); }
                        @font-face { font-family:'Tajawal'; font-weight:bold; src:url('/uellow_documents/static/src/fonts/Tajawal-Bold.ttf') format('truetype'); }
                        .udoc, .udoc * { font-family:'Tajawal','DejaVu Sans',sans-serif !important; color:#2A1B0A; direction:ltr !important; box-sizing:border-box; }
                        .udoc { font-size:12.5px; }
                        .udoc table { width:100%; border-collapse:collapse; table-layout:fixed; border:0 !important; }
                        .udoc td, .udoc th { border:0 !important; vertical-align:top; }
                        .ar { display:block; font-size:9.5px; font-weight:600; color:#9c8e76 !important; line-height:1.35; }
                        .lbl { font-size:9.5px; font-weight:800; letter-spacing:1.2px; color:#C79A12 !important; text-transform:uppercase; }
                        .lbl .ar { color:#b3a489 !important; letter-spacing:0; }
                        .card { background:#FBF6EA; border-radius:16px; padding:15px 17px; }
                        .name { font-size:15px; font-weight:800; color:#2A1B0A; margin-top:6px; }
                        .sub { font-size:11.5px; color:#6f6048; line-height:1.55; margin-top:3px; }
                        .ttl { font-size:34px; font-weight:800; color:#412402; line-height:1; letter-spacing:.5px; }
                        .ttl .ar { font-size:17px; color:#9c8e76 !important; font-weight:700; margin-top:2px; }
                        .items thead td { background:#412402 !important; color:#FFFFFF !important; font-size:10.5px; font-weight:800;
                            letter-spacing:.5px; text-transform:uppercase; padding:12px 12px; }
                        .items thead td .ar { color:#E7D7B8 !important; font-weight:600; }
                        .items tbody td { font-size:12.5px; padding:12px 12px; border-bottom:1px solid #efe7d6 !important; }
                        .grand td { padding:14px 18px; }
                        .meta td { padding:10px 14px; }
                        .div { border-right:1px solid #efe7d6 !important; }
                    </style>

                    <div style="height:9px;background-color:#F5C320 !important;border-radius:6px;"/>
                    <div style="padding:8px 4px 4px;">

                        <table><tr>
                            <td style="width:60%;">
                                <table><tr>
                                    <td style="width:150px;vertical-align:middle;">
                                        <img t-if="company.logo" style="max-height:56px;max-width:150px;" t-att-src="image_data_uri(company.logo)"/>
                                    </td>
                                    <td style="vertical-align:middle;padding-left:12px;">
                                        <div style="font-size:19px;font-weight:800;color:#412402;" t-esc="company.name"/>
                                        <div class="sub">
                                            <span t-esc="company.street"/><t t-if="company.city">, <span t-esc="company.city"/></t><br/>
                                            <t t-if="company.country_id"><span t-esc="company.country_id.name"/> · </t><b t-esc="company.phone"/><br/>
                                            <span t-esc="company.email"/>
                                        </div>
                                    </td>
                                </tr></table>
                            </td>
                            <td style="width:40%;text-align:right;">
                                <div class="ttl">INVOICE<span class="ar">فاتورة</span></div>
                                <div style="font-size:12px;color:#6f6048;margin-top:8px;">No. <b style="color:#2A1B0A;" t-esc="o.name"/></div>
                                <div style="margin-top:8px;">
                                    <span t-if="paid" style="display:inline-block;border:2px solid #1f9d55;color:#1f9d55 !important;font-weight:800;padding:4px 14px;border-radius:9px;font-size:13px;letter-spacing:2px;">PAID · مدفوعة</span>
                                    <span t-else="" style="display:inline-block;border:2px solid #B91C1C;color:#B91C1C !important;font-weight:800;padding:4px 14px;border-radius:9px;font-size:13px;letter-spacing:1px;">DUE · مستحقة</span>
                                </div>
                            </td>
                        </tr></table>

                        <table style="margin-top:18px;"><tr>
                            <td style="width:49%;">
                                <div class="card" style="background-color:#FBF6EA !important;box-shadow:0 4px 14px rgba(65,36,2,0.06);">
                                    <div class="lbl">Bill to<span class="ar">فاتورة إلى</span></div>
                                    <div class="name" t-esc="o.partner_id.name"/>
                                    <div class="sub">
                                        <t t-if="o.partner_id.street"><span t-esc="o.partner_id.street"/><br/></t>
                                        <t t-if="o.partner_id.city"><span t-esc="o.partner_id.city"/><t t-if="o.partner_id.country_id">, <span t-esc="o.partner_id.country_id.name"/></t><br/></t>
                                        <t t-if="o.partner_id.phone"><span t-esc="o.partner_id.phone"/></t>
                                    </div>
                                </div>
                            </td>
                            <td style="width:2%;"/>
                            <td style="width:49%;">
                                <div class="card" style="background-color:#FBF6EA !important;box-shadow:0 4px 14px rgba(65,36,2,0.06);">
                                    <div class="lbl">Ship to<span class="ar">التوصيل إلى</span></div>
                                    <div class="name" t-esc="ship.name"/>
                                    <div class="sub">
                                        <t t-if="ship.street"><span t-esc="ship.street"/><br/></t>
                                        <t t-if="ship.city"><span t-esc="ship.city"/></t>
                                    </div>
                                </div>
                            </td>
                        </tr></table>

                        <div style="margin-top:14px;border:1px solid #efe7d6;border-radius:14px;overflow:hidden;">
                            <table class="meta"><tr>
                                <td class="div" style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Issue date<span class="ar">التاريخ</span></div><div style="font-size:12.5px;font-weight:800;margin-top:3px;" t-field="o.invoice_date"/></td>
                                <td class="div" style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Due<span class="ar">الاستحقاق</span></div><div style="font-size:12.5px;font-weight:800;margin-top:3px;"><t t-if="paid">Paid</t><span t-else="" t-field="o.invoice_date_due"/></div></td>
                                <td class="div" style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Order ref<span class="ar">الطلب</span></div><div style="font-size:12.5px;font-weight:800;margin-top:3px;"><t t-esc="o.invoice_origin or '—'"/></div></td>
                                <td style="width:25%;"><div class="lbl" style="color:#9c8e76 !important;">Salesperson<span class="ar">المندوب</span></div><div style="font-size:12.5px;font-weight:800;margin-top:3px;"><t t-esc="o.invoice_user_id.name or '—'"/></div></td>
                            </tr></table>
                        </div>

                        <div style="margin-top:16px;border-radius:14px;overflow:hidden;border:1px solid #efe7d6;">
                            <table class="items">
                                <thead><tr>
                                    <td style="width:34px;text-align:center;">#</td>
                                    <td>Description<span class="ar">الوصف</span></td>
                                    <td style="width:50px;text-align:center;">Qty</td>
                                    <td style="width:96px;text-align:right;">Unit</td>
                                    <td style="width:60px;text-align:right;">Disc</td>
                                    <td style="width:104px;text-align:right;">Amount</td>
                                </tr></thead>
                                <tbody>
                                    <t t-set="idx" t-value="0"/>
                                    <t t-foreach="o.invoice_line_ids.filtered(lambda l: not l.display_type or l.display_type == 'product')" t-as="line">
                                        <t t-set="idx" t-value="idx + 1"/>
                                        <tr t-attf-style="background-color:#{'#FCFAF3' if idx % 2 == 0 else '#FFFFFF'} !important;">
                                            <td style="text-align:center;color:#9c8e76;"><t t-esc="idx"/></td>
                                            <td><span style="font-weight:800;" t-esc="line.product_id.display_name or line.name"/><t t-if="line.product_id.default_code"><br/><span style="font-size:9.5px;color:#9c8e76;">SKU <t t-esc="line.product_id.default_code"/></span></t></td>
                                            <td style="text-align:center;font-weight:700;"><t t-esc="int(line.quantity)"/></td>
                                            <td style="text-align:right;font-weight:700;"><span t-field="line.price_unit" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td>
                                            <td style="text-align:right;font-weight:700;color:#1f9d55;"><t t-if="line.discount"><t t-esc="int(line.discount)"/>%</t><t t-else="">—</t></td>
                                            <td style="text-align:right;font-weight:800;"><span t-field="line.price_subtotal" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <table style="margin-top:18px;"><tr>
                            <td style="width:55%;">
                                <div class="card" style="background-color:#FBF6EA !important;box-shadow:0 4px 14px rgba(65,36,2,0.06);">
                                    <table><tr>
                                        <td style="width:78px;vertical-align:middle;">
                                            <img style="width:74px;height:74px;" t-att-src="'/report/barcode?barcode_type=QR&amp;value=%s&amp;width=160&amp;height=160' % (company.website or 'https://uellow.com')"/>
                                        </td>
                                        <td style="vertical-align:middle;padding-left:12px;">
                                            <div class="lbl">Payment details<span class="ar">بيانات الدفع</span></div>
                                            <div class="sub" style="margin-top:5px;">
                                                <t t-if="company.uellow_bank_line"><span t-esc="company.uellow_bank_line"/></t>
                                                <t t-elif="company.bank_ids"><b>IBAN:</b> <t t-esc="company.bank_ids[0].acc_number"/></t>
                                                <t t-else=""><span t-esc="company.name"/> · <span t-esc="company.email"/></t>
                                            </div>
                                        </td>
                                    </tr></table>
                                </div>
                                <div t-if="paid" style="margin-top:12px;background-color:#EAF7EF !important;border-radius:12px;padding:11px 15px;font-size:11.5px;font-weight:700;color:#176b3c !important;">
                                    ✓ Settled in full · تم الدفع بالكامل<t t-if="o.invoice_date"> — <span t-field="o.invoice_date"/></t>
                                </div>
                            </td>
                            <td style="width:3%;"/>
                            <td style="width:42%;">
                                <table style="margin-bottom:4px;">
                                    <tr><td style="font-size:12.5px;color:#6f6048;padding:5px 2px;">Subtotal<span class="ar">الفرعي</span></td><td style="text-align:right;font-weight:800;font-size:12.5px;"><span t-field="o.amount_untaxed" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr>
                                    <tr><td style="font-size:12.5px;color:#6f6048;padding:5px 2px;">Tax<span class="ar">الضريبة</span></td><td style="text-align:right;font-weight:800;font-size:12.5px;"><span t-field="o.amount_tax" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr>
                                </table>
                                <table class="grand" style="background-color:#F5C320 !important;border-radius:14px;"><tr>
                                    <td style="color:#412402 !important;font-weight:800;font-size:14px;">TOTAL<span class="ar" style="color:#6b4a12 !important;">الإجمالي المستحق</span></td>
                                    <td style="text-align:right;color:#412402 !important;font-weight:800;font-size:24px;"><span t-field="o.amount_total" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td>
                                </tr></table>
                                <div style="font-size:10px;color:#9c8e76;font-style:italic;margin-top:7px;text-align:right;"><t t-esc="o.currency_id.amount_to_text(o.amount_total)"/></div>
                            </td>
                        </tr></table>

                        <table style="margin-top:18px;"><tr>
                            <td style="width:62%;font-size:10.5px;color:#6f6048;line-height:1.6;">
                                <span style="font-weight:800;color:#412402;">Terms · الشروط</span><br/>
                                <t t-esc="company.uellow_returns_terms"/> · <t t-esc="company.uellow_warranty_terms"/>.
                            </td>
                            <td style="width:38%;text-align:right;font-size:10.5px;color:#9c8e76;vertical-align:bottom;">
                                Authorized signature · التوقيع المعتمد<br/><br/>______________________________
                            </td>
                        </tr></table>

                        <div style="margin-top:18px;background-color:#412402 !important;border-radius:14px;padding:14px 18px;">
                            <table><tr>
                                <td style="color:#FFFFFF !important;font-weight:800;font-size:13px;"><t t-esc="company.uellow_doc_footer"/></td>
                                <td style="text-align:right;color:#E7D7B8 !important;font-size:10.5px;"><t t-esc="company.website or 'uellow.com'"/> · <b style="color:#F5C320 !important;" t-esc="company.phone"/></td>
                            </tr></table>
                        </div>

                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="account.account_invoices" model="ir.actions.report">
        <field name="report_name">uellow_documents.uellow_invoice</field>
        <field name="report_file">uellow_documents.uellow_invoice</field>
        <field name="paperformat_id" ref="uellow_documents.paperformat_uellow_doc"/>
    </record>
    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field name="report_name">uellow_documents.uellow_invoice</field>
        <field name="report_file">uellow_documents.uellow_invoice</field>
        <field name="paperformat_id" ref="uellow_documents.paperformat_uellow_doc"/>
    </record>
</odoo>
