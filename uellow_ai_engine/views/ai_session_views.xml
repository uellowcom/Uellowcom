<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_chat_session_list" model="ir.ui.view">
        <field name="name">ai.chat.session.list</field>
        <field name="model">ai.chat.session</field>
        <field name="arch" type="xml">
            <list string="Live Sessions" default_order="write_date desc">
                <field name="session_id"/>
                <field name="partner_id" string="Customer"/>
                <field name="product_id" string="Product"/>
                <field name="last_state" string="State"/>
                <field name="write_date" string="Last Activity"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ai_chat_session_form" model="ir.ui.view">
        <field name="name">ai.chat.session.form</field>
        <field name="model">ai.chat.session</field>
        <field name="arch" type="xml">
            <form string="Live Session">
                <sheet>
                    <group>
                        <field name="session_id" readonly="1"/>
                        <field name="partner_id" string="Customer"/>
                        <field name="product_id" string="Product"/>
                        <field name="last_state" string="State"/>
                        <field name="active"/>
                    </group>
                    <group string="Conversation Log (JSON)">
                        <field name="messages_json" widget="text" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_chat_sessions" model="ir.actions.act_window">
        <field name="name">Live Sessions</field>
        <field name="res_model">ai.chat.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Root menu (single source of truth) -->
    <menuitem id="menu_ai_root"
              name="🐝 Beena AI"
              sequence="90"
              groups="base.group_system"/>

    <menuitem id="menu_ai_sessions"
              name="Live Sessions"
              parent="menu_ai_root"
              action="action_ai_chat_sessions"
              sequence="60"/>
</odoo>
