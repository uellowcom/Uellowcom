<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- ── Findings ─────────────────────────────────────────────────── -->
  <record id="view_beena_coach_finding_list" model="ir.ui.view">
    <field name="name">beena.coach.finding.list</field>
    <field name="model">beena.coach.finding</field>
    <field name="arch" type="xml">
      <list decoration-danger="severity == 'critical'"
            decoration-warning="severity == 'high'"
            decoration-muted="state == 'dismissed'">
        <!-- v2.2.46 — batch-approve the ticked rows in one click. -->
        <header>
          <button name="action_confirm_selected" type="object"
                  string="✅ Approve selected" class="btn-success"
                  confirm="Approve all selected findings? Lessons apply to Beena instantly; code/data findings go to the developer batch."/>
        </header>
        <field name="severity"/>
        <field name="category"/>
        <field name="source" optional="show"/>
        <field name="title"/>
        <field name="occurrences"/>
        <field name="lost_sale" optional="show"/>
        <field name="lost_value_kd" optional="show" sum="Lost KD"/>
        <field name="last_seen" optional="hide"/>
        <field name="recommended_action" optional="show"/>
        <field name="state"/>
        <!-- v2.1.92 — ONE button: the coach already decided the right
             action (lesson vs code); the admin just confirms. -->
        <button name="action_confirm" type="object" string="Approve"
                icon="fa-check" class="btn-primary"
                invisible="state not in ('new',)"/>
        <button name="action_dismiss" type="object" string="Dismiss"
                icon="fa-times" invisible="state in ('dismissed','applied')"/>
      </list>
    </field>
  </record>

  <record id="view_beena_coach_finding_form" model="ir.ui.view">
    <field name="name">beena.coach.finding.form</field>
    <field name="model">beena.coach.finding</field>
    <field name="arch" type="xml">
      <form string="Coach Finding">
        <header>
          <!-- v2.1.92 — single Confirm button; the coach picked the action. -->
          <button name="action_confirm" type="object" string="✅ Approve &amp; Execute"
                  class="btn-primary" invisible="state != 'new'"/>
          <button name="action_dismiss" type="object" string="Dismiss"
                  invisible="state in ('dismissed','applied')"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group string="🤖 Coach recommendation — pressing Approve executes this">
            <field name="recommended_action" readonly="1"/>
            <field name="recommendation_note" readonly="1"/>
          </group>
          <group>
            <group>
              <field name="title"/>
              <field name="category"/>
              <field name="severity"/>
              <field name="occurrences"/>
            </group>
            <group>
              <field name="conversation_id"/>
              <field name="run_id"/>
              <field name="lost_sale"/>
              <field name="lost_value_kd" invisible="not lost_sale"/>
              <field name="last_seen"/>
            </group>
          </group>
          <group string="What went wrong">
            <field name="description" nolabel="1"/>
          </group>
          <group string="💡 Suggested fix">
            <field name="suggestion" nolabel="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_beena_coach_finding" model="ir.actions.act_window">
    <field name="name">Coach Findings</field>
    <field name="res_model">beena.coach.finding</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_open': 1}</field>
  </record>

  <record id="view_beena_coach_finding_search" model="ir.ui.view">
    <field name="name">beena.coach.finding.search</field>
    <field name="model">beena.coach.finding</field>
    <field name="arch" type="xml">
      <search>
        <field name="title"/>
        <filter name="open" string="Open" domain="[('state','in',('new','approved'))]"/>
        <filter name="urgent" string="Urgent" domain="[('severity','in',('high','critical'))]"/>
        <filter name="lost" string="Lost sales" domain="[('lost_sale','=',True)]"/>
        <group expand="0" string="Group By">
          <filter name="g_sev" string="Severity" context="{'group_by':'severity'}"/>
          <filter name="g_cat" string="Category" context="{'group_by':'category'}"/>
          <filter name="g_state" string="State" context="{'group_by':'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ── Runs ─────────────────────────────────────────────────────── -->
  <record id="view_beena_coach_run_list" model="ir.ui.view">
    <field name="name">beena.coach.run.list</field>
    <field name="model">beena.coach.run</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="analyzed"/>
        <field name="health_score"/>
        <field name="findings_new"/>
        <field name="findings_dup"/>
        <field name="lost_value_kd" sum="Lost KD"/>
        <field name="cost_usd" sum="Cost"/>
      </list>
    </field>
  </record>

  <record id="action_beena_coach_run" model="ir.actions.act_window">
    <field name="name">Coach Runs</field>
    <field name="res_model">beena.coach.run</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_beena_coach_findings" name="🎓 Coach Findings"
            parent="menu_ai_root" action="action_beena_coach_finding"
            sequence="25"/>
  <menuitem id="menu_beena_coach_runs" name="🎓 Coach Runs"
            parent="menu_ai_root" action="action_beena_coach_run"
            sequence="26"/>

  <!-- ── 🎓 Coach tab inside the main Beena settings panel ────────── -->
  <record id="view_ai_config_settings_coach" model="ir.ui.view">
    <field name="name">ai.config.settings.coach</field>
    <field name="model">ai.config.settings</field>
    <field name="inherit_id" ref="view_ai_config_settings"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="🎓 Coach" name="coach">
          <group string="التشغيل والجدولة">
            <group>
              <field name="coach_enabled"/>
              <label for="coach_interval_number" string="تكرار التحليل"/>
              <div class="o_row">
                <span>كل</span>
                <field name="coach_interval_number" class="oe_inline"
                       style="width:60px"/>
                <field name="coach_interval_type" class="oe_inline"/>
              </div>
              <field name="coach_run_hour"
                     invisible="coach_interval_type != 'days'"/>
            </group>
            <group>
              <field name="coach_batch"/>
              <field name="coach_model"/>
            </group>
          </group>
          <group string="التنبيهات">
            <group>
              <field name="coach_email"/>
              <field name="coach_urgent_email"/>
            </group>
          </group>
          <group string="🎓 الدروس المتعلَّمة (تُحقن في برومبت بينا)">
            <field name="coach_lessons" nolabel="1"
                   placeholder="- درس لكل سطر… تُضاف تلقائياً من زر Apply as lesson"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>

  <!-- ── 🎓 Coach KPI Dashboard ───────────────────────────────────── -->
  <record id="view_beena_coach_dashboard_form" model="ir.ui.view">
    <field name="name">beena.coach.dashboard.form</field>
    <field name="model">beena.coach.dashboard</field>
    <field name="arch" type="xml">
      <form string="Coach Dashboard" create="false" edit="false">
        <header>
          <button name="action_enable" type="object" string="▶️ تشغيل المدرّب"
                  class="btn-primary" invisible="coach_on"/>
          <button name="action_disable" type="object" string="⏸ إيقاف المدرّب"
                  class="btn-secondary" invisible="not coach_on"/>
          <button name="action_run_now" type="object" string="⚡ تحليل الآن"
                  class="btn-primary"
                  confirm="سيحلل المدرّب المحادثات الجديدة فوراً — متابعة؟"/>
          <button name="action_train_now" type="object" string="🎭 درّب الآن"
                  class="btn-primary"
                  confirm="سيتقمص المدرّب شخصيات عملاء ويختبر بينا على السيناريوهات (يستغرق دقائق) — متابعة؟"/>
          <field name="coach_on" invisible="1"/>
        </header>
        <sheet>
          <field name="kpi_html" nolabel="1"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_beena_coach_dashboard" model="ir.actions.server">
    <field name="name">🎓 Coach Dashboard</field>
    <field name="model_id" ref="model_beena_coach_dashboard"/>
    <field name="state">code</field>
    <field name="code">action = env['beena.coach.dashboard'].open_dashboard()</field>
  </record>

  <menuitem id="menu_beena_coach_dashboard" name="🎓 Coach Dashboard"
            parent="menu_ai_root" action="action_beena_coach_dashboard"
            sequence="24"/>

  <!-- ── 🎭 Training scenarios ────────────────────────────────────── -->
  <record id="view_beena_coach_scenario_list" model="ir.ui.view">
    <field name="name">beena.coach.scenario.list</field>
    <field name="model">beena.coach.scenario</field>
    <field name="arch" type="xml">
      <list decoration-success="last_result == 'pass'"
            decoration-danger="last_result == 'fail'" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="capability"/>
        <field name="persona"/>
        <field name="opening"/>
        <field name="max_turns"/>
        <field name="is_golden"/>
        <field name="last_result"/>
        <field name="last_score"/>
        <field name="last_run" optional="hide"/>
        <field name="active" optional="show"/>
      </list>
    </field>
  </record>

  <record id="action_beena_coach_scenario" model="ir.actions.act_window">
    <field name="name">🎭 Training Scenarios</field>
    <field name="res_model">beena.coach.scenario</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_beena_coach_scenarios" name="🎭 Training Scenarios"
            parent="menu_ai_root" action="action_beena_coach_scenario"
            sequence="27"/>

  <!-- nightly training arena — 03:30 Kuwait (00:30 UTC) -->
  <record id="cron_beena_coach_train" model="ir.cron">
    <field name="name">Beena Coach: nightly training arena</field>
    <field name="model_id" ref="model_beena_coach_run"/>
    <field name="state">code</field>
    <field name="code">model._cron_coach_train()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active">True</field>
  </record>

  <!-- ── Hourly cron (first-week intensive mode) ──────────────────── -->
  <record id="cron_beena_coach" model="ir.cron">
    <field name="name">Beena Coach: analyze conversations</field>
    <field name="model_id" ref="model_beena_coach_run"/>
    <field name="state">code</field>
    <field name="code">model._cron_coach_analyze()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="active">True</field>
  </record>
</odoo>
