<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  Add a "Beena" badge in the existing sale.order list/form     -->
    <!-- ============================================================ -->
    <record id="view_sale_order_form_beena_tag" model="ir.ui.view">
        <field name="name">sale.order.form.beena.tag</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert"
                     invisible="not is_beena_order"
                     style="margin: 8px;">
                    <strong>🐝 Beena Order</strong> — this quotation was created from a Beena chat session.
                </div>
                <field name="is_beena_order" invisible="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="🐝 Beena" name="beena_meta" invisible="not is_beena_order">
                    <group>
                        <group string="Beena session">
                            <field name="beena_session_id" readonly="1"/>
                            <field name="beena_created_at" readonly="1"/>
                        </group>
                        <group string="Address collected in chat">
                            <field name="beena_customer_phone" readonly="1"/>
                            <field name="beena_customer_governorate" readonly="1"/>
                            <field name="beena_customer_city" readonly="1"/>
                            <field name="beena_customer_street" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Dedicated Beena Orders list view                             -->
    <!-- ============================================================ -->
    <record id="view_beena_order_list" model="ir.ui.view">
        <field name="name">sale.order.beena.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Beena Orders" decoration-success="state == 'sale'"
                  decoration-info="state == 'sent'" decoration-muted="state == 'cancel'">
                <field name="name" string="Quote #"/>
                <field name="beena_created_at" string="Created"/>
                <field name="partner_id"/>
                <field name="beena_customer_phone" string="Phone"/>
                <field name="beena_customer_governorate" string="Governorate"/>
                <field name="beena_customer_city" string="City"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sale'"
                       decoration-info="state == 'sent'"
                       decoration-muted="state in ('cancel', 'draft')"/>
                <field name="beena_session_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_beena_order_search" model="ir.ui.view">
        <field name="name">sale.order.beena.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="beena_customer_phone"/>
                <field name="beena_customer_governorate"/>
                <field name="beena_session_id"/>
                <separator/>
                <filter name="state_draft"  string="Draft (Quotation)" domain="[('state', '=', 'draft')]"/>
                <filter name="state_sent"   string="Sent"              domain="[('state', '=', 'sent')]"/>
                <filter name="state_sale"   string="Confirmed"         domain="[('state', '=', 'sale')]"/>
                <filter name="state_cancel" string="Cancelled"         domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="today"     string="Today"
                        domain="[('beena_created_at', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="this_week" string="This week"
                        domain="[('beena_created_at', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state"    string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_partner"  string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_gov"      string="Governorate"
                            context="{'group_by': 'beena_customer_governorate'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_beena_orders" model="ir.actions.act_window">
        <field name="name">🐝 Beena Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_beena_order_search"/>
        <field name="domain">[('is_beena_order', '=', True)]</field>
        <field name="context">{'search_default_state_draft': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">
                No Beena orders yet — every quotation created from a Beena chat will appear here.
            </p>
        </field>
    </record>

    <record id="action_beena_orders_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_beena_order_list"/>
        <field name="act_window_id" ref="action_beena_orders"/>
    </record>

    <!-- ============================================================ -->
    <!--  Menu: Beena → Beena Orders                                   -->
    <!-- ============================================================ -->
    <menuitem id="menu_beena_orders"
              name="🐝 Beena Orders"
              parent="menu_ai_root"
              action="action_beena_orders"
              sequence="35"/>

</odoo>
