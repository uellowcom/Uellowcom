<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="affiliate_order_list" model="ir.ui.view">
        <field name="name">uellow.affiliate.order.list</field>
        <field name="model">uellow.affiliate.order</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-muted="state == 'rejected'">
                <field name="name"/>
                <field name="create_date"/>
                <field name="affiliate_id"/>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="amount_total" sum="Total"/>
                <field name="est_commission"/>
                <field name="state"/>
                <field name="sale_order_id"/>
                <button name="action_approve" string="Approve" type="object"
                        icon="fa-check" invisible="state != 'submitted'"/>
                <button name="action_reject" string="Reject" type="object"
                        icon="fa-times" invisible="state != 'submitted'"/>
            </list>
        </field>
    </record>

    <record id="affiliate_order_form" model="ir.ui.view">
        <field name="name">uellow.affiliate.order.form</field>
        <field name="model">uellow.affiliate.order</field>
        <field name="arch" type="xml">
            <form string="Affiliate Order">
                <header>
                    <button name="action_approve" string="✅ Approve → Sale Order"
                            type="object" class="btn-primary"
                            invisible="state != 'submitted'"/>
                    <button name="action_reject" string="❌ Reject"
                            type="object" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Agent">
                            <field name="affiliate_id"/>
                            <field name="website_id"/>
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                        <group string="Customer">
                            <field name="customer_name"/>
                            <field name="customer_phone"/>
                            <field name="customer_area"/>
                            <field name="customer_address"/>
                            <field name="customer_note"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="price_unit"/>
                            <field name="commission_pct"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount_total"/>
                        <field name="est_commission"/>
                    </group>
                    <group invisible="not reject_reason">
                        <field name="reject_reason"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="affiliate_order_action" model="ir.actions.act_window">
        <field name="name">Submitted Orders</field>
        <field name="res_model">uellow.affiliate.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_submitted': 1}</field>
    </record>

    <record id="affiliate_order_search" model="ir.ui.view">
        <field name="name">uellow.affiliate.order.search</field>
        <field name="model">uellow.affiliate.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_phone"/>
                <field name="affiliate_id"/>
                <filter name="submitted" string="📨 Awaiting review"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="✅ Approved"
                        domain="[('state', '=', 'approved')]"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_affiliate_orders" name="Submitted Orders"
              parent="menu_affiliate_root" action="affiliate_order_action"
              sequence="20"/>
</odoo>
