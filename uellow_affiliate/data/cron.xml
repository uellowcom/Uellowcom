<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_affiliate_order" model="ir.sequence">
            <field name="name">Affiliate Submitted Order</field>
            <field name="code">uellow.affiliate.order</field>
            <field name="prefix">AFF-</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_affiliate_payout" model="ir.sequence">
            <field name="name">Affiliate Payout</field>
            <field name="code">uellow.affiliate.payout</field>
            <field name="prefix">PAY-</field>
            <field name="padding">5</field>
        </record>
        <record id="cron_confirm_commissions" model="ir.cron">
            <field name="name">Affiliate: confirm delivered commissions</field>
            <field name="model_id" ref="model_uellow_affiliate_commission"/>
            <field name="state">code</field>
            <field name="code">model.cron_confirm_delivered()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
