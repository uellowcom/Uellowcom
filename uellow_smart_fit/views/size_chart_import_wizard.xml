<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_size_chart_import_wizard_form" model="ir.ui.view">
        <field name="name">product.size.chart.import.wizard.form</field>
        <field name="model">product.size.chart.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Size Charts">
                <sheet>
                    <div class="alert alert-info">
                        <strong>📥 File format</strong>:
                        CSV/Excel columns in this order (Arabic header names also accepted):
                        <code>product_name, size, chest, shoulder, sleeve, length, waist, hip, inseam, thigh, foot_length, tolerance</code>
                        <br/>
                        First row is the header. Each subsequent row is one size for one product.
                        Products are matched by name (case-insensitive).
                    </div>

                    <group>
                        <field name="csv_file" filename="csv_filename" required="1"/>
                        <field name="csv_filename" invisible="1"/>
                        <field name="update_existing"/>
                    </group>

                    <group invisible="not result_summary">
                        <field name="result_summary" nolabel="1" readonly="1" widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_download_template" type="object"
                            string="📥 Download template" class="btn-link"/>
                    <button name="action_import" type="object"
                            string="📤 Import" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_size_chart_import_wizard" model="ir.actions.act_window">
        <field name="name">📥 Import Size Charts</field>
        <field name="res_model">product.size.chart.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_size_chart_import"
              name="📥 Import CSV"
              parent="menu_smart_fit_root"
              action="action_size_chart_import_wizard"
              sequence="25"/>

</odoo>
