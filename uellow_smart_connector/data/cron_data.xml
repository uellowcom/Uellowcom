<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_price_check" model="ir.cron">
        <field name="name">Smart Connector: فحص أسعار المنافسين</field>
        <field name="model_id" ref="model_uellow_price_intelligence"/>
        <field name="state">code</field>
        <field name="code">model.cron_check_prices()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="cron_backfill_ar_names" model="ir.cron">
        <field name="name">Smart Connector: ترجمة أسماء وأوصاف المنتجات للعربية</field>
        <field name="model_id" ref="model_uellow_import_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_backfill_arabic_names()
model._cron_backfill_descriptions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="cron_dead_stock" model="ir.cron">
        <field name="name">Smart Connector: فحص المخزون الراكد</field>
        <field name="model_id" ref="model_uellow_dead_stock"/>
        <field name="state">code</field>
        <field name="code">model.cron_scan_dead_stock()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <!-- Drives background imports in small chunks. Fires on its own schedule
         AND on-demand via _trigger() right after a job is queued, so it churns
         batches back-to-back without waiting for the interval. -->
    <record id="cron_bg_import" model="ir.cron">
        <field name="name">Smart Connector: background import worker</field>
        <field name="model_id" ref="model_uellow_import_job"/>
        <field name="state">code</field>
        <field name="code">model.cron_bg_import()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
