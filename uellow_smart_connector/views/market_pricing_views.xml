<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── Market factors (per-market multiplier config) ── -->
  <record id="view_market_factor_list" model="ir.ui.view">
    <field name="name">uellow.sc.market.factor.list</field>
    <field name="model">uellow.sc.market.factor</field>
    <field name="arch" type="xml">
      <list string="Market Factors" editable="bottom">
        <header>
          <button name="action_seed_factors" type="object" string="Seed Factors"
                  class="btn-primary"/>
        </header>
        <field name="pricelist_id"/>
        <field name="factor"/>
        <field name="note"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="action_market_factor" model="ir.actions.act_window">
    <field name="name">Market Factors</field>
    <field name="res_model">uellow.sc.market.factor</field>
    <field name="view_mode">list</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Set a price multiplier per market · معامل سعر لكل سوق</p>
      <p>Click <b>Seed Factors</b> in the header to create a 1.0 row per pricelist, then tune each.<br/>
         اضغط Seed Factors لإنشاء صف 1.0 لكل قائمة أسعار ثم اضبط كل سوق.</p>
    </field>
  </record>

  <!-- ── Pricer wizard ── -->
  <record id="view_market_pricer_form" model="ir.ui.view">
    <field name="name">uellow.sc.market.pricer.form</field>
    <field name="model">uellow.sc.market.pricer</field>
    <field name="arch" type="xml">
      <form string="Multi-Market Pricer">
        <sheet>
          <div class="oe_title">
            <h2>🌍 تسعير متعدد الأسواق · Multi-Market Pricer</h2>
            <p>اختر منتجاً ثم اعرض السعر المقترح لكل سوق وطبّقه بضغطة (يُراجَع أولاً).</p>
          </div>
          <group>
            <field name="product_id" options="{'no_create': True}"/>
            <field name="base_price" readonly="1"/>
          </group>
          <button name="action_generate" string="اعرض الاقتراحات · Generate" type="object"
                  class="oe_highlight"/>
          <field name="line_ids" nolabel="1">
            <list editable="bottom" create="false">
              <field name="pricelist_id" readonly="1"/>
              <field name="factor" readonly="1"/>
              <field name="current_price" readonly="1"/>
              <field name="suggested_price"/>
              <field name="apply" widget="boolean_toggle"/>
            </list>
          </field>
          <footer>
            <button name="action_apply" string="طبّق المحدد · Apply Selected" type="object"
                    class="oe_highlight"
                    confirm="Apply the selected suggested prices to each market's pricelist?"/>
            <button string="إغلاق · Close" class="btn-secondary" special="cancel"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_market_pricer" model="ir.actions.act_window">
    <field name="name">Multi-Market Pricer</field>
    <field name="res_model">uellow.sc.market.pricer</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <!-- ── Menus ── -->
  <menuitem id="menu_sc_market_pricer" name="Multi-Market Pricer"
            parent="menu_sc_root" action="action_market_pricer" sequence="22"/>
  <menuitem id="menu_sc_market_factor" name="Market Factors"
            parent="menu_sc_settings" action="action_market_factor" sequence="30"/>

</odoo>
