<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_connector_settings_form" model="ir.ui.view">
    <field name="name">uellow.connector.settings.form</field>
    <field name="model">uellow.connector.settings</field>
    <field name="arch" type="xml">
      <form string="Smart Connector Settings">
        <sheet>
          <div class="alert alert-info" role="alert">
            <i class="fa fa-info-circle"/> Settings are saved globally and persist between sessions.
          </div>
          <group string="🎛️ Feature Switches · مفاتيح تشغيل الميزات">
            <group>
              <field name="feat_translation"/>
              <field name="feat_dead_stock"/>
              <field name="feat_seasonality"/>
              <field name="feat_reorder"/>
              <field name="feat_visual_intake"/>
            </group>
            <group>
              <field name="feat_repricing"/>
              <field name="feat_radar"/>
              <field name="feat_scorecard"/>
              <field name="feat_copilot"/>
              <field name="feat_multimarket"/>
              <field name="feat_publish_studio"/>
            </group>
          </group>
          <group string="🎨 Publish Studio · استوديو النشر">
            <field name="image_search_provider"/>
            <field name="image_search_api_key" password="True"
                   placeholder="provider API key"
                   invisible="image_search_provider == 'none'"/>
            <field name="image_search_cx"
                   invisible="image_search_provider != 'google_cse'"
                   placeholder="Google CSE engine id"/>
            <field name="image_search_count"
                   invisible="image_search_provider == 'none'"/>
            <field name="import_images_per_product"/>
            <field name="publish_set_published"/>
            <field name="autotranslate_names"/>
            <field name="seo_shorten_names"/>
            <field name="autocategorize"/>
          </group>
          <group string="AI Settings">
            <field name="anthropic_api_key" password="True"
                   placeholder="sk-ant-..."
                   string="Anthropic API Key"/>
            <field name="default_warranty_text" string="Default Warranty Text"/>
            <field name="enable_ai_default" string="Enable AI by Default"/>
          </group>
          <group string="Import Settings">
            <field name="default_price_variance" string="Max Price Change (%)"/>
            <field name="import_default_markup_pct"
                   string="Default Markup % (no price column)"/>
            <field name="max_products_default" string="Max Products per Job"/>
          </group>
          <group string="Price Intelligence">
            <field name="price_check_enabled" string="Enable Price Monitoring"/>
            <field name="internal_price_watch" string="Internal Price Watch (history + indicators)"/>
            <field name="price_check_sources"
                   string="Comparison Sources (comma-separated URLs)"
                   placeholder="https://site1.com, https://site2.com"/>
          </group>
          <group string="Dead Stock">
            <field name="dead_stock_days" string="Idle Days Threshold"/>
            <field name="dead_stock_alert_email" string="Send Email Alerts"/>
          </group>
          <group string="Dynamic Repricing">
            <field name="reprice_undercut_pct" string="Undercut Competitor By (%)"/>
            <field name="reprice_min_margin_pct" string="Minimum Margin (%)"/>
            <field name="reprice_max_change_pct" string="Max Single Change (%)"/>
          </group>
          <group string="Reorder Forecast">
            <field name="reorder_velocity_days" string="Sales Velocity Window (days)"/>
            <field name="reorder_lead_days" string="Supplier Lead Time (days)"/>
            <field name="reorder_safety_days" string="Safety Stock (days)"/>
          </group>
          <group string="Seasonality &amp; Supplier Scorecard">
            <field name="season_lookahead_months" string="Seasonality Look-ahead (months)"/>
            <field name="scorecard_window_days" string="Scorecard Sales Window (days)"/>
          </group>
        </sheet>
        <footer>
          <button name="action_save" string="Save Settings"
                  type="object" class="oe_highlight"/>
          <button string="Discard" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_connector_settings" model="ir.actions.act_window">
    <field name="name">Smart Connector Settings</field>
    <field name="res_model">uellow.connector.settings</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
