<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── List View ── -->
  <record id="view_import_job_list" model="ir.ui.view">
    <field name="name">uellow.import.job.list</field>
    <field name="model">uellow.import.job</field>
    <field name="arch" type="xml">
      <list string="Import Jobs"
            decoration-warning="state=='review'"
            decoration-success="state=='done'"
            decoration-danger="state=='error'"
            decoration-muted="state=='rolled_back'">
        <field name="name"/>
        <field name="job_type" widget="badge"/>
        <field name="total_lines" string="Total"/>
        <field name="new_count" string="New"/>
        <field name="update_count" string="Update"/>
        <field name="warning_count" string="Warnings"/>
        <field name="approved_count" string="Approved"/>
        <field name="state" widget="badge"
               decoration-info="state=='processing'"
               decoration-warning="state=='review'"
               decoration-success="state=='done'"
               decoration-danger="state=='error'"/>
        <field name="write_date" string="Last Updated"/>
        <button name="action_open_review" string="Review"
                type="object" icon="fa-eye"
                invisible="state != 'review'"/>
      </list>
    </field>
  </record>

  <!-- ── Form View ── -->
  <record id="view_import_job_form" model="ir.ui.view">
    <field name="name">uellow.import.job.form</field>
    <field name="model">uellow.import.job</field>
    <field name="arch" type="xml">
      <form string="Smart Connector — Import Job">
        <header>
          <button name="action_run" string="Run Import"
                  type="object" class="oe_highlight"
                  invisible="state not in ('draft','error')"/>
          <button name="action_refresh" string="🔄 Refresh"
                  type="object"
                  invisible="bg_phase not in ('queued','parsing','enriching','applying')"
                  help="Reload to see the latest background progress."/>
          <button name="action_approve_safe" string="✅ Approve Safe"
                  type="object"
                  invisible="state != 'review'"
                  help="Approve all lines that have no warning."/>
          <button name="action_approve_all" string="Approve All"
                  type="object"
                  confirm="Approve every pending line (including warnings)?"
                  invisible="state != 'review'"/>
          <button name="action_disable_continue_oos" string="🚫 Stop OOS Selling"
                  type="object"
                  invisible="state != 'review'"
                  help="Turn off continue-selling for all out-of-stock matched products."/>
          <button name="action_apply_approved" string="🚀 Apply Approved"
                  type="object" class="oe_highlight"
                  confirm="Create/update the catalog for all approved lines?"
                  invisible="state != 'review'"/>
          <button name="action_open_publish_studio" string="🎨 Publish Studio"
                  type="object"
                  invisible="new_pending_count == 0"
                  help="Prepare images, AI descriptions and SEO before publishing new products."/>
          <button name="action_pub_prepare_new" string="✨ Prepare All New"
                  type="object"
                  invisible="state != 'review' or new_pending_count == 0"
                  confirm="Search images + write AI descriptions/SEO for every new product? (uses AI credits)"/>
          <button name="action_pub_publish_ready" string="🚀 Publish Ready"
                  type="object" class="oe_highlight"
                  invisible="pub_ready_count == 0"
                  confirm="Publish all ready products live to the website?"/>
          <button name="action_rollback" string="Rollback"
                  type="object"
                  confirm="Are you sure you want to rollback this import?"
                  invisible="state != 'done'"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,processing,review,done"/>
          <field name="new_pending_count" invisible="1"/>
          <field name="pub_ready_count" invisible="1"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <field name="bg_phase" invisible="1"/>
          <div class="alert alert-info" role="alert"
               invisible="bg_phase not in ('queued','parsing','enriching','applying')">
            <strong>Processing in the background</strong> —
            phase: <field name="bg_phase" readonly="1" nolabel="1" class="oe_inline"/>.
            <field name="bg_done" readonly="1" nolabel="1" class="oe_inline"/> /
            <field name="bg_total" readonly="1" nolabel="1" class="oe_inline"/> products enriched.
            <field name="bg_progress" widget="progressbar"/>
            <div class="text-muted">You can leave this page — it keeps running.
              Press <b>🔄 Refresh</b> to update. Last tick:
              <field name="bg_heartbeat" readonly="1" nolabel="1" class="oe_inline"/>.</div>
          </div>
          <group>
            <group string="Import Settings">
              <field name="job_type"/>
              <field name="source_url"
                     invisible="job_type != 'url'"
                     placeholder="https://..."/>
              <field name="upload_filename" invisible="1"/>
              <field name="upload_file" filename="upload_filename"
                     widget="binary"
                     string="Browse File (Excel / PDF / Image)"
                     invisible="job_type not in ('file','image')"/>
              <field name="max_products_per_run"/>
              <field name="bg_chunk" string="Products per background batch"/>
              <field name="price_variance_limit" string="Max Price Change (%)"/>
            </group>
            <group string="AI Settings">
              <field name="enable_translation" string="Arabic/English Translation"/>
              <field name="enable_seo" string="Write SEO Description"/>
              <field name="warranty_text" string="Uellow Warranty Text"/>
            </group>
          </group>
          <group string="Statistics" invisible="state == 'draft'">
            <group>
              <field name="total_lines" string="Total Products"/>
              <field name="new_count" string="New"/>
              <field name="update_count" string="Update"/>
            </group>
            <group>
              <field name="warning_count" string="Warnings"/>
              <field name="approved_count" string="Approved"/>
            </group>
          </group>
          <notebook>
            <page string="Product Lines" name="lines">
              <field name="line_ids" context="{'default_job_id': id}">
                <list editable="bottom"
                      decoration-warning="has_warning"
                      decoration-danger="line_state=='rejected'"
                      decoration-success="line_state in ('approved','applied')"
                      decoration-info="product_action=='new'">
                  <field name="name_en" string="Name (EN)"/>
                  <field name="name_ar" string="Name (AR)" optional="show"/>
                  <field name="product_action" widget="badge"/>
                  <field name="match_method" optional="show" string="Matched by"/>
                  <field name="match_score" string="Match %" optional="hide"/>
                  <!-- Sale price -->
                  <field name="old_price" string="Old Sale" readonly="1"/>
                  <field name="new_price" string="New Sale"/>
                  <field name="update_price" string="↻P" widget="boolean_toggle"/>
                  <!-- Cost -->
                  <field name="old_cost" string="Old Cost" readonly="1"/>
                  <field name="new_cost" string="New Cost"/>
                  <field name="update_cost" string="↻C" widget="boolean_toggle"/>
                  <field name="margin_pct" string="Margin%" optional="show"/>
                  <!-- Identifiers -->
                  <field name="old_barcode" string="Old Barcode" optional="hide" readonly="1"/>
                  <field name="new_barcode" string="Barcode" optional="show"/>
                  <field name="update_barcode" string="↻B" widget="boolean_toggle" optional="show"/>
                  <field name="old_reference" string="Old Ref" optional="hide" readonly="1"/>
                  <field name="new_reference" string="Reference" optional="show"/>
                  <field name="update_reference" string="↻R" widget="boolean_toggle" optional="show"/>
                  <field name="missing_info" string="Missing" optional="show"/>
                  <field name="ecommerce_categ_ids" string="eCommerce Category"
                         widget="many2many_tags" optional="show"/>
                  <!-- Out of stock / continue-selling -->
                  <field name="is_out_of_stock" widget="boolean" string="OOS" optional="show"/>
                  <field name="existing_continue_selling" column_invisible="1"/>
                  <field name="show_continue_warn" column_invisible="1"/>
                  <field name="disable_continue_selling" string="Stop Selling"
                         widget="boolean_toggle" optional="show"/>
                  <button name="action_disable_continue_now" type="object"
                          string="Stop OOS Selling" icon="fa-ban"
                          title="Turn off 'continue selling when out of stock'"
                          invisible="not show_continue_warn"/>
                  <field name="has_warning" widget="boolean" string="⚠" optional="hide"/>
                  <field name="ai_enriched" widget="boolean" string="AI" optional="hide"/>
                  <field name="line_state" widget="badge"
                         decoration-warning="line_state=='pending'"
                         decoration-success="line_state in ('approved','applied')"
                         decoration-danger="line_state=='rejected'"/>
                  <button name="action_approve" string="Approve"
                          type="object" icon="fa-check" title="Approve"
                          invisible="line_state != 'pending'"/>
                  <button name="action_reject" string="Reject"
                          type="object" icon="fa-times" title="Reject"
                          invisible="line_state != 'pending'"/>
                  <button name="action_apply" string="Apply"
                          type="object" icon="fa-save" title="Apply to catalog"
                          invisible="line_state != 'approved'"/>
                  <field name="pub_ready" column_invisible="1"/>
                  <field name="pub_score" string="Ready%" optional="show"
                         invisible="product_action != 'new'"/>
                  <button name="action_pub_publish" string="Publish"
                          type="object" icon="fa-rocket"
                          class="btn-link text-success"
                          title="Open/Publish in Publish Studio"
                          invisible="product_action != 'new' or line_state == 'applied'"/>
                </list>
              </field>
            </page>
            <page string="Error Log" invisible="not error_message">
              <field name="error_message" readonly="1" widget="text"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <!-- ── Search ── -->
  <record id="view_import_job_search" model="ir.ui.view">
    <field name="name">uellow.import.job.search</field>
    <field name="model">uellow.import.job</field>
    <field name="arch" type="xml">
      <search string="Search Import Jobs">
        <field name="name" string="Job Number"/>
        <filter string="Pending Review" name="review"
                domain="[('state','=','review')]"/>
        <filter string="Done" name="done"
                domain="[('state','=','done')]"/>
        <filter string="Error" name="error"
                domain="[('state','=','error')]"/>
        <separator/>
        <filter string="URL Import" name="url"
                domain="[('job_type','=','url')]"/>
        <filter string="File Import" name="file"
                domain="[('job_type','=','file')]"/>
        <group expand="0" string="Group By">
          <filter string="State" name="group_state"
                  context="{'group_by': 'state'}"/>
          <filter string="Type" name="group_type"
                  context="{'group_by': 'job_type'}"/>
          <filter string="Month" name="group_month"
                  context="{'group_by': 'create_date:month'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ── Action ── -->
  <record id="action_import_job" model="ir.actions.act_window">
    <field name="name">Import Jobs</field>
    <field name="res_model">uellow.import.job</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_import_job_search"/>
    <field name="context">{'search_default_review': 0}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        No import jobs yet · لا توجد عمليات استيراد بعد
      </p>
      <p>Create your first import job to import products from a URL or Excel/PDF file.<br/>
         أنشئ أول عملية استيراد لجلب المنتجات من رابط أو ملف Excel/PDF.</p>
    </field>
  </record>

</odoo>
