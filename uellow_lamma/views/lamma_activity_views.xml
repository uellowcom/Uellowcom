<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Customer activity screen: what customers added / removed / checked out -->
    <record id="view_lamma_activity_list" model="ir.ui.view">
        <field name="name">uellow.lamma.activity.list</field>
        <field name="model">uellow.lamma.activity</field>
        <field name="arch" type="xml">
            <list string="نشاط لمّة يلو" default_order="create_date desc" create="false">
                <field name="create_date" string="الوقت"/>
                <field name="action" string="الحدث" widget="badge"
                       decoration-success="action=='checkout'" decoration-info="action in ('add','start')"
                       decoration-warning="action=='remove'" decoration-muted="action in ('clear','type')"/>
                <field name="product_id" string="المنتج"/>
                <field name="lamma_type" string="النوع"/>
                <field name="items" string="عدد"/>
                <field name="subtotal" string="الإجمالي"/>
                <field name="discount" string="الخصم"/>
                <field name="source" string="المصدر"/>
                <field name="country_code" string="الدولة"/>
                <field name="partner_id" string="العميل" optional="show"/>
                <field name="session_key" string="الجلسة" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_lamma_activity_pivot" model="ir.ui.view">
        <field name="name">uellow.lamma.activity.pivot</field>
        <field name="model">uellow.lamma.activity</field>
        <field name="arch" type="xml">
            <pivot string="إحصائيات لمّة يلو">
                <field name="action" type="row"/>
                <field name="source" type="col"/>
                <field name="discount" type="measure"/>
                <field name="items" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_lamma_activity_graph" model="ir.ui.view">
        <field name="name">uellow.lamma.activity.graph</field>
        <field name="model">uellow.lamma.activity</field>
        <field name="arch" type="xml">
            <graph string="إحصائيات لمّة يلو" type="bar">
                <field name="action"/>
                <field name="discount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_lamma_activity_search" model="ir.ui.view">
        <field name="name">uellow.lamma.activity.search</field>
        <field name="model">uellow.lamma.activity</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="country_code"/>
                <filter name="checkouts" string="أتمّوا اللمّة" domain="[('action','=','checkout')]"/>
                <filter name="adds" string="أضافوا" domain="[('action','=','add')]"/>
                <filter name="removes" string="أزالوا" domain="[('action','=','remove')]"/>
                <separator/>
                <filter name="installment" string="أقساط" domain="[('lamma_type','=','installment')]"/>
                <filter name="web" string="الموقع" domain="[('source','=','web')]"/>
                <filter name="app" string="التطبيق" domain="[('source','=','app')]"/>
                <separator/>
                <filter name="today" string="اليوم" domain="[('create_date','&gt;=',datetime.datetime.combine(context_today(),datetime.time(0,0,0)))]"/>
                <filter name="last7" string="آخر 7 أيام" domain="[('create_date','&gt;=',(context_today()-datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="g_action" string="الحدث" context="{'group_by':'action'}"/>
                    <filter name="g_product" string="المنتج" context="{'group_by':'product_id'}"/>
                    <filter name="g_type" string="النوع" context="{'group_by':'lamma_type'}"/>
                    <filter name="g_source" string="المصدر" context="{'group_by':'source'}"/>
                    <filter name="g_country" string="الدولة" context="{'group_by':'country_code'}"/>
                    <filter name="g_customer" string="العميل" context="{'group_by':'partner_id'}"/>
                    <filter name="g_day" string="اليوم" context="{'group_by':'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lamma_activity" model="ir.actions.act_window">
        <field name="name">نشاط العملاء</field>
        <field name="res_model">uellow.lamma.activity</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_lamma_activity_search"/>
        <field name="context">{'search_default_last7': 1}</field>
    </record>

    <record id="action_lamma_stats" model="ir.actions.act_window">
        <field name="name">الإحصائيات</field>
        <field name="res_model">uellow.lamma.activity</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_lamma_activity_search"/>
    </record>

    <menuitem id="menu_lamma_activity" name="نشاط العملاء" parent="menu_lamma_root"
              action="action_lamma_activity" sequence="20"/>
    <menuitem id="menu_lamma_stats" name="الإحصائيات" parent="menu_lamma_root"
              action="action_lamma_stats" sequence="30"/>

</odoo>
