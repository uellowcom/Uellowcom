<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_lamma_config_form" model="ir.ui.view">
        <field name="name">uellow.lamma.config.form</field>
        <field name="model">uellow.lamma.config</field>
        <field name="arch" type="xml">
            <form string="لمّة يلو">
                <header>
                    <button name="action_open_activity" type="object" string="نشاط العملاء" class="btn-primary" icon="fa-list"/>
                    <button name="action_open_stats" type="object" string="الإحصائيات" icon="fa-bar-chart"/>
                    <button name="action_open_coupons" type="object" string="الكوبونات المصروفة" icon="fa-ticket"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_activity" type="object" class="oe_stat_button" icon="fa-bolt">
                            <field name="kpi_activity_count" widget="statinfo" string="حدث"/>
                        </button>
                        <button name="action_open_stats" type="object" class="oe_stat_button" icon="fa-shopping-basket">
                            <field name="kpi_bundles" widget="statinfo" string="لمّة (30ي)"/>
                        </button>
                        <button name="action_open_stats" type="object" class="oe_stat_button" icon="fa-check-circle">
                            <field name="kpi_checkouts" widget="statinfo" string="إتمام (30ي)"/>
                        </button>
                        <button name="action_open_stats" type="object" class="oe_stat_button" icon="fa-percent">
                            <field name="kpi_conversion" widget="statinfo" string="تحويل %"/>
                        </button>
                        <button name="action_open_coupons" type="object" class="oe_stat_button" icon="fa-tag">
                            <field name="kpi_discount" widget="statinfo" string="خصم مصروف"/>
                        </button>
                        <button name="action_open_stats" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="kpi_avg_items" widget="statinfo" string="متوسط منتجات"/>
                        </button>
                        <button name="action_open_stats" type="object" class="oe_stat_button" icon="fa-credit-card">
                            <field name="kpi_inst_share" widget="statinfo" string="أقساط %"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="brand_label" string="اسم الميزة"/>
                        <h1><field name="brand_label" placeholder="لمّة يلو"/></h1>
                    </div>
                    <notebook>
                        <page string="عام" name="general">
                            <group>
                                <group string="التفعيل">
                                    <field name="enable_all_products"/>
                                    <field name="replace_add_to_cart"/>
                                    <field name="min_items"/>
                                    <field name="badge_text"/>
                                    <field name="rounding"/>
                                </group>
                                <group string="التوفّر حسب الدولة">
                                    <field name="country_ids" widget="many2many_tags"
                                           placeholder="اتركه فارغاً = متاح في كل الدول"/>
                                    <field name="suggest_fbt"/>
                                    <field name="free_shipping_items"/>
                                </group>
                            </group>
                        </page>
                        <page string="الخصم والحماية" name="discount">
                            <group>
                                <group>
                                    <field name="discount_mode"/>
                                    <field name="max_discount_pct"/>
                                    <field name="min_margin_pct"/>
                                </group>
                            </group>
                            <separator string="شرائح الخصم — كل ما يزوّد العميل يكبر الخصم"/>
                            <field name="tier_ids">
                                <list editable="bottom">
                                    <field name="min_qty"/>
                                    <field name="min_amount"/>
                                    <field name="discount_pct"/>
                                </list>
                            </field>
                        </page>
                        <page string="لمّة الأقساط" name="installment">
                            <group>
                                <group>
                                    <field name="installment_enabled"/>
                                    <field name="installment_extra_margin"/>
                                    <field name="installment_provider"/>
                                </group>
                                <group>
                                    <field name="installment_max_months"/>
                                    <field name="installment_min_amount"/>
                                </group>
                            </group>
                            <div class="text-muted">
                                هامش الأقساط الإضافي مضمون داخلياً فقط — لا يظهر رقمه للعميل نهائياً.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lamma_config_open" model="ir.actions.server">
        <field name="name">لمّة يلو</field>
        <field name="model_id" ref="model_uellow_lamma_config"/>
        <field name="state">code</field>
        <field name="code">action = model.get_config().get_formview_action()</field>
    </record>

    <record id="action_lamma_dashboard" model="ir.actions.act_url">
        <field name="name">لوحة التحكّم</field>
        <field name="url">/lamma/dashboard</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_lamma_root" name="لمّة يلو" sequence="55"/>
    <menuitem id="menu_lamma_dashboard" name="🧺 لوحة التحكّم" parent="menu_lamma_root"
              action="action_lamma_dashboard" sequence="5"/>
    <menuitem id="menu_lamma_config" name="الإعدادات" parent="menu_lamma_root"
              action="action_lamma_config_open" sequence="10"/>

</odoo>
