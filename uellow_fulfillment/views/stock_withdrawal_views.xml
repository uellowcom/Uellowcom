<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_stock_withdrawal_list" model="ir.ui.view">
    <field name="name">uellow.stock.withdrawal.list</field>
    <field name="model">uellow.stock.withdrawal</field>
    <field name="arch" type="xml">
      <list string="Stock Withdrawals">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="initiated_by"/>
        <field name="total_units"/>
        <field name="reason"/>
        <field name="destination"/>
        <field name="state" widget="badge"
               decoration-success="state == 'done'"
               decoration-warning="state == 'submitted'"
               decoration-info="state == 'approved'"
               decoration-danger="state == 'rejected'"/>
      </list>
    </field>
  </record>

  <record id="view_stock_withdrawal_form" model="ir.ui.view">
    <field name="name">uellow.stock.withdrawal.form</field>
    <field name="model">uellow.stock.withdrawal</field>
    <field name="arch" type="xml">
      <form string="Stock Withdrawal">
        <header>
          <button name="action_submit" string="Submit" type="object"
                  class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_approve" string="Approve" type="object"
                  class="btn-primary" invisible="state != 'submitted'"/>
          <button name="action_reject" string="Reject" type="object"
                  invisible="state not in ('submitted','approved')"/>
          <button name="action_done" string="Withdraw Stock" type="object"
                  class="btn-primary" invisible="state != 'approved'"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,submitted,approved,done"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group>
              <field name="vendor_location_id"/>
              <field name="partner_id"/>
              <field name="initiated_by"/>
            </group>
            <group>
              <field name="reason"/>
              <field name="destination"/>
              <field name="total_units"/>
              <field name="picking_id" readonly="1"/>
            </group>
          </group>
          <field name="reason_note" placeholder="Reason details..."/>
          <field name="admin_note" placeholder="Admin note..."/>
          <notebook>
            <page string="Products">
              <field name="line_ids">
                <list editable="bottom">
                  <field name="product_id"/>
                  <field name="available_qty"/>
                  <field name="qty"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_stock_withdrawal" model="ir.actions.act_window">
    <field name="name">Stock Withdrawals</field>
    <field name="res_model">uellow.stock.withdrawal</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_fbu_withdrawal"
            name="Stock Withdrawals"
            parent="menu_fbu_root"
            action="action_stock_withdrawal"
            sequence="15"/>

</odoo>
