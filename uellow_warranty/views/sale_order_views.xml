<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_warranty" model="ir.ui.view">
        <field name="name">sale.order.form.warranty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_warranties" type="object" class="oe_stat_button" icon="fa-shield" invisible="warranty_card_count == 0">
                    <field name="warranty_card_count" widget="statinfo" string="Warranties"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
