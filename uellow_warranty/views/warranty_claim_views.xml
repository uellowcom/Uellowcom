<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warranty_claim_list" model="ir.ui.view">
        <field name="name">uellow.warranty.claim.list</field>
        <field name="model">uellow.warranty.claim</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='new'" decoration-success="state=='resolved'" decoration-danger="state=='rejected'">
                <field name="name"/>
                <field name="card_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_warranty_claim_form" model="ir.ui.view">
        <field name="name">uellow.warranty.claim.form</field>
        <field name="model">uellow.warranty.claim</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state!='new'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state!='new'"/>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="state not in ('approved',)"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,approved,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="card_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date"/>
                        </group>
                    </group>
                    <group string="Reported issue">
                        <field name="issue" nolabel="1"/>
                    </group>
                    <group string="Resolution">
                        <field name="resolution" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_warranty_claim" model="ir.actions.act_window">
        <field name="name">Warranty Claims</field>
        <field name="res_model">uellow.warranty.claim</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
