<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_warranty_card" model="ir.sequence">
        <field name="name">Uellow Warranty Card</field>
        <field name="code">uellow.warranty.card</field>
        <field name="prefix">WRT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_warranty_claim" model="ir.sequence">
        <field name="name">Uellow Warranty Claim</field>
        <field name="code">uellow.warranty.claim</field>
        <field name="prefix">WCLM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
