<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-options')]" position="inside">
            <div class="d-flex gap-1">
                <button class="button btn btn-lg btn-warning w-100 py-3" t-on-click="() => this.printWarrantyCertificate()">
                    <i class="fa fa-shield me-1"/>Print Warranty · طباعة الكفالة
                </button>
            </div>
        </xpath>
    </t>
</templates>
